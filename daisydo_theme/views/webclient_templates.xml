<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inject branding CSS directly — colors come from generated theme.scss via CSS vars -->
    <template id="daisydo_branding_css" inherit_id="web.layout" name="DaisyERP Branding CSS">
        <xpath expr="//head" position="inside">
            <style>
                :root {
                    /* Fallback definitions — overridden by generated theme.scss when loaded */
                    --daisy-primary: #00954c;
                    --daisy-secondary: #dac554;
                    --daisy-hover: #007e40;
                    --daisy-active: #006835;
                    --daisy-text-on-primary: #ffffff;

                    --o-brand-odoo: var(--daisy-primary) !important;
                    --o-brand-primary: var(--daisy-primary) !important;
                    --primary: var(--daisy-primary) !important;
                }
                .o_main_navbar { background-color: var(--daisy-primary) !important; }
                .o_main_navbar, .o_main_navbar * { color: var(--daisy-text-on-primary) !important; }
                header#top nav.navbar { background-color: var(--daisy-primary) !important; }
                header#top nav.navbar, header#top nav.navbar a,
                header#top nav.navbar span, header#top nav.navbar .nav-link,
                header#top nav.navbar .fa { color: var(--daisy-text-on-primary) !important; }

                /* The rule above also hits the mobile offcanvas (#top_menu_collapse_mobile)
                   and Bootstrap dropdowns, which render on a WHITE panel inside the navbar —
                   white-on-white. Re-darken them, and let label spans inherit (the direct
                   span rule above otherwise beats the link color). Mirrors the
                   "mobile-hamburger-white-on-white-fix v4" hotfix in website.custom_code_head. */
                header#top nav.navbar #top_menu_collapse_mobile .nav-link,
                header#top nav.navbar #top_menu_collapse_mobile .nav-link:visited,
                header#top nav.navbar #top_menu_collapse_mobile a,
                header#top nav.navbar #top_menu_collapse_mobile .dropdown-item,
                header#top nav.navbar .js_usermenu .dropdown-item,
                header#top nav.navbar .js_usermenu a,
                header#top nav.navbar .dropdown-menu .dropdown-item,
                header#top nav.navbar .dropdown-menu a { color: #212529 !important; }
                header#top nav.navbar #top_menu_collapse_mobile .nav-link:hover,
                header#top nav.navbar #top_menu_collapse_mobile .nav-link:focus,
                header#top nav.navbar #top_menu_collapse_mobile .nav-link.active,
                header#top nav.navbar #top_menu_collapse_mobile .dropdown-item:hover,
                header#top nav.navbar .js_usermenu a:hover,
                header#top nav.navbar .dropdown-menu a:hover,
                header#top nav.navbar .dropdown-menu .dropdown-item:hover { color: var(--daisy-primary) !important; }
                header#top nav.navbar #top_menu_collapse_mobile .btn-close { filter: none !important; }
                header#top nav.navbar #top_menu_collapse_mobile span,
                header#top nav.navbar .js_usermenu span,
                header#top nav.navbar .dropdown-menu span { color: inherit !important; }

                .btn-primary { background-color: var(--daisy-primary) !important; border-color: var(--daisy-hover) !important; color: var(--daisy-text-on-primary) !important; }
                .btn-primary:hover { background-color: var(--daisy-hover) !important; }

                /* Login page background image */
                .oe_website_login_container {
                    background: url('/daisydo_theme/static/src/img/chainydais.png') center/cover no-repeat fixed;
                    min-height: calc(100vh - 60px);
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    padding: 2rem 1rem;
                }
                .oe_website_login_container .oe_login_form,
                .oe_website_login_container .o_login_auth {
                    background: rgba(255, 255, 255, 0.92);
                    backdrop-filter: blur(10px);
                    -webkit-backdrop-filter: blur(10px);
                    border-radius: 16px;
                    padding: 2.5rem;
                    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
                    max-width: 420px;
                    width: 100%;
                }

                /* Login page branding via CSS - avoids template inheritance issues */
                .oe_single_form_container::before,
                .oe_website_login_container .oe_login_form::before {
                    content: '';
                    display: block;
                    width: 100%;
                    max-width: 200px;
                    height: 100px;
                    margin: 0 auto 1.5rem auto;
                    background: url('/daisydo_theme/static/src/img/logo.png') center/contain no-repeat;
                }
                /* Hide ALL Odoo branding links and Enterprise upsell */
                a[href*='odoo.com'] { display: none !important; }
                a[href*='odoo.sh'] { display: none !important; }

                /* Enterprise upgrade banners, upsell prompts */
                .o_enterprise_upsell,
                .o_enterprise_upgrade,
                .o_ee_cta,
                .oe_database_expiration_panel,
                .o_field_upgrade_boolean,
                .o_upgrade_star,
                .o_upgrade_extra,
                [data-upgrade],
                .o_upsell_bar,
                div[class*="enterprise"],
                .badge-enterprise,
                .text-enterprise,
                .o_home_menu .o_enterprise_label,
                .o_enterprise_dialog,
                .o_edition_info,
                .o_enterprise_feature,
                .o_not_community { display: none !important; }

                /* Hide "Upgrade" and "Enterprise" ribbon labels on apps */
                .o_home_menu_item .o_enterprise_label,
                .o_app .badge.text-bg-enterprise,
                .o_module_kanban .badge[text="Enterprise"],
                .oe_ribbon.bg-enterprise { display: none !important; }

                /* Hide Odoo.com external links in footer/about */
                footer a[href*='odoo.com'],
                .o_footer_copyright a[href*='odoo.com'],
                .o_about_dialog a[href*='odoo.com'] { display: none !important; }

                /* Nuke ALL Odoo brand promotion variants (website, website_sale, etc.) */
                .o_brand_promotion { font-size: 0 !important; visibility: hidden !important; }
                .o_brand_promotion::after {
                    content: 'Powered by Mint';
                    font-size: .875rem !important;
                    visibility: visible !important;
                    display: inline !important;
                }

                /* --- App Home Menu: tint module icons --- */
                .o_home_menu .o_app .o_app_icon,
                .o_home_menu .o_draggable .o_app_icon {
                    filter: hue-rotate(200deg) saturate(1.5) brightness(1.1);
                }

                /* --- Loading screen: replace Odoo logo with daisy --- */
                .o_loading_indicator,
                .o_spinner_text::before { color: var(--daisy-primary) !important; }
                .o_action_manager .o_loading img,
                body > .o_loading img,
                .o_home_menu_background::before {
                    content: url('/daisydo_theme/static/src/img/logo.png') !important;
                    width: 80px !important;
                    height: 80px !important;
                }

                /* --- Company logo in web client --- */
                .o_company_logo img,
                img[src*='company_logo'] {
                    content: url('/daisydo_theme/static/src/img/logo.png');
                    max-height: 40px;
                    object-fit: contain;
                }

                /* --- Database manager Odoo logo --- */
                .o_database_manager img.o_logo,
                .o_database_manager .o_logo img {
                    content: url('/daisydo_theme/static/src/img/logo.png');
                }

                /* --- eLearning / Courses (website_slides): dark grey sections --- */
                .o_wslides_gradient {
                    background-image: linear-gradient(120deg, #2d2d2d, #1a1a1a) !important;
                    background-color: #2d2d2d !important;
                }
                .o_wslides_course_header {
                    background-color: #2d2d2d !important;
                }
                .o_wslides_course_nav,
                .o_wslides_course_nav .breadcrumb {
                    background-color: #333333 !important;
                }
                .o_wslides_course_nav a,
                .o_wslides_course_nav .breadcrumb-item,
                .o_wslides_course_nav .breadcrumb-item a,
                .o_wslides_course_nav .breadcrumb-item.active {
                    color: var(--daisy-primary) !important;
                }
                .o_wslides_fs_sidebar_header {
                    background-color: #2d2d2d !important;
                }
                .o_wslides_fs_sidebar {
                    background-color: #1a1a1a !important;
                }
                .o_wslides_quiz_modal .tooltip-inner {
                    background-color: #2d2d2d !important;
                }
                .o_wslides_slide_list_header {
                    background-color: #f5f5f5 !important;
                    color: #1a1a1a !important;
                }
                /* Progress bars in courses */
                .o_wslides_channel_completion .progress-bar,
                .o_wslides_progress .progress-bar {
                    background-color: var(--daisy-primary) !important;
                }
                /* "New" badges */
                .o_wslides_slides_list .badge.text-bg-info,
                .o_wslides_slides_list .badge.bg-info {
                    background-color: var(--daisy-primary) !important;
                    color: var(--daisy-text-on-primary) !important;
                }
            </style>
        </xpath>
    </template>

    <!-- Override favicon -->
    <template id="daisydo_favicon" inherit_id="web.layout" name="DaisyERP Favicon">
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="href">/daisydo_theme/static/src/img/favicon.png</attribute>
        </xpath>
    </template>

    <!-- PWA manifest and Apple touch icon -->
    <template id="daisydo_pwa_meta" inherit_id="web.layout" name="DaisyERP PWA Meta">
        <xpath expr="//head" position="inside">
            <link rel="manifest" href="/manifest.json"/>
            <meta name="theme-color" content="#00954c"/>
            <link rel="apple-touch-icon" href="/daisydo_theme/static/src/img/logo.png"/>
        </xpath>
    </template>

    <!-- Override page title -->
    <template id="daisydo_title" inherit_id="web.layout" name="DaisyERP Title">
        <xpath expr="//title" position="replace">
            <title><t t-esc="title or 'Mint'"/></title>
        </xpath>
    </template>

    <!-- Replace "Powered by Odoo" footer branding (base) -->
    <template id="daisydo_brand_promotion" inherit_id="web.brand_promotion" name="DaisyERP Brand">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace">
            <div class="o_brand_promotion">
                <span class="small">Powered by <strong>Mint</strong></span>
            </div>
        </xpath>
    </template>
</odoo>
