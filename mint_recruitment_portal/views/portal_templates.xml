<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- ============================================================ -->
    <!-- Portal Home — Dashboard cards                                -->
    <!-- ============================================================ -->

    <template
        id="portal_my_home"
        inherit_id="portal.portal_my_home"
        priority="40"
        name="Recruitment Portal Home"
        customize_show="True"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True" />
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Job Positions</t>
                <t t-set="url" t-value="'/my/jobs'" />
                <t t-set="text">Manage job listings</t>
                <t t-set="placeholder_count" t-value="'job_count'" />
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Applicants</t>
                <t t-set="url" t-value="'/my/applicants'" />
                <t t-set="text">Review applications</t>
                <t t-set="placeholder_count" t-value="'applicant_count'" />
            </t>
        </div>
    </template>

    <!-- ============================================================ -->
    <!-- Breadcrumbs                                                  -->
    <!-- ============================================================ -->

    <template
        id="portal_breadcrumbs"
        inherit_id="portal.portal_breadcrumbs"
        priority="40"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'recruitment_jobs'" class="breadcrumb-item active">
                Job Positions
            </li>
            <li t-if="page_name == 'recruitment_job_detail'" class="breadcrumb-item">
                <a href="/my/jobs">Job Positions</a>
            </li>
            <li t-if="page_name == 'recruitment_job_detail'" class="breadcrumb-item active">
                <t t-out="job.name" />
            </li>
            <li t-if="page_name == 'recruitment_applicants'" class="breadcrumb-item active">
                Applicants
            </li>
            <li t-if="page_name == 'recruitment_applicant_detail'" class="breadcrumb-item">
                <a href="/my/applicants">Applicants</a>
            </li>
            <li t-if="page_name == 'recruitment_applicant_detail'" class="breadcrumb-item active">
                <t t-out="applicant.partner_name or applicant.display_name" />
            </li>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Job Positions — List                                         -->
    <!-- ============================================================ -->

    <template id="portal_my_jobs" name="My Job Positions">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Job Positions</t>
            </t>

            <t t-if="not jobs">
                <div class="alert alert-info" role="alert">
                    No job positions found.
                </div>
            </t>

            <t t-if="jobs" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Position</th>
                        <th>Department</th>
                        <th class="text-center">Openings</th>
                        <th class="text-center">Applicants</th>
                        <th class="text-center">Published</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="jobs" t-as="job">
                        <tr>
                            <td>
                                <a t-attf-href="/my/jobs/#{job.id}">
                                    <strong t-out="job.name" />
                                </a>
                            </td>
                            <td>
                                <span t-if="job.department_id" t-out="job.department_id.name" />
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td class="text-center">
                                <t t-out="job.no_of_recruitment" />
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary rounded-pill">
                                    <t t-out="job.application_count" />
                                </span>
                            </td>
                            <td class="text-center">
                                <span t-if="job.website_published" class="badge bg-success">Live</span>
                                <span t-else="" class="badge bg-secondary">Draft</span>
                            </td>
                            <td class="text-end">
                                <form t-attf-action="/my/jobs/#{job.id}/toggle_publish" method="post" class="d-inline">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                    <button type="submit"
                                        t-attf-class="btn btn-sm #{job.website_published and 'btn-outline-warning' or 'btn-outline-success'}">
                                        <t t-if="job.website_published">Unpublish</t>
                                        <t t-else="">Publish</t>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Job Position — Detail / Edit                                 -->
    <!-- ============================================================ -->

    <template id="portal_job_detail" name="Job Position Detail">
        <t t-call="portal.portal_layout">
            <div class="container py-3">
                <!-- Header -->
                <div class="row mb-4">
                    <div class="col-md-8">
                        <h2 t-out="job.name" />
                        <div class="text-muted">
                            <span t-if="job.department_id" t-out="job.department_id.name" />
                            <span t-if="job.company_id"> · <t t-out="job.company_id.name" /></span>
                        </div>
                    </div>
                    <div class="col-md-4 text-end">
                        <span t-if="job.website_published" class="badge bg-success fs-6 me-2">Published</span>
                        <span t-else="" class="badge bg-secondary fs-6 me-2">Draft</span>
                        <form t-attf-action="/my/jobs/#{job.id}/toggle_publish" method="post" class="d-inline">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                            <button type="submit"
                                t-attf-class="btn #{job.website_published and 'btn-outline-warning' or 'btn-success'}">
                                <t t-if="job.website_published">Unpublish</t>
                                <t t-else="">Publish</t>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Edit form -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Edit Position</h5>
                    </div>
                    <div class="card-body">
                        <form t-attf-action="/my/jobs/#{job.id}/update" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                            <div class="row">
                                <div class="col-md-8 mb-3">
                                    <label for="name" class="form-label">Position Title</label>
                                    <input type="text" class="form-control" name="name" t-att-value="job.name" required="required" />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="no_of_recruitment" class="form-label">Open Positions</label>
                                    <input type="number" class="form-control" name="no_of_recruitment"
                                        t-att-value="job.no_of_recruitment" min="0" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="website_description" class="form-label">Job Description (HTML)</label>
                                <textarea class="form-control" name="website_description" rows="10"
                                    t-out="job.website_description" />
                            </div>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </form>
                    </div>
                </div>

                <!-- Recent applicants for this job -->
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Applicants</h5>
                        <a t-attf-href="/my/applicants?filterby=all&amp;search=#{job.name}" class="btn btn-sm btn-outline-primary">
                            View All
                        </a>
                    </div>
                    <div class="card-body p-0">
                        <t t-if="not applicants">
                            <div class="p-3 text-muted text-center">No applicants yet.</div>
                        </t>
                        <t t-if="applicants">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Stage</th>
                                        <th>Applied</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="applicants" t-as="app">
                                        <tr>
                                            <td>
                                                <a t-attf-href="/my/applicants/#{app.id}">
                                                    <t t-out="app.partner_name or 'Unknown'" />
                                                </a>
                                            </td>
                                            <td t-out="app.email_from or '—'" />
                                            <td>
                                                <span class="badge bg-info">
                                                    <t t-out="app.stage_id.name" />
                                                </span>
                                            </td>
                                            <td>
                                                <t t-out="app.create_date" t-options='{"widget": "date"}' />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Applicants — List                                            -->
    <!-- ============================================================ -->

    <template id="portal_my_applicants" name="My Applicants">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Applicants</t>
            </t>

            <!-- Stage pipeline summary -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                <t t-foreach="stages" t-as="stage">
                    <a t-attf-href="/my/applicants?filterby=#{stage.id}"
                        t-attf-class="btn btn-sm #{str(stage.id) == filterby and 'btn-primary' or 'btn-outline-secondary'}">
                        <t t-out="stage.name" />
                    </a>
                </t>
                <a href="/my/applicants?filterby=all"
                    t-attf-class="btn btn-sm #{filterby == 'all' and 'btn-primary' or 'btn-outline-secondary'}">
                    All
                </a>
            </div>

            <t t-if="not applicants">
                <div class="alert alert-info" role="alert">
                    No applicants found.
                </div>
            </t>

            <t t-if="applicants" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Applicant</th>
                        <th>Job Position</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Stage</th>
                        <th>Applied</th>
                        <th class="text-center">Rating</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="applicants" t-as="applicant">
                        <tr>
                            <td>
                                <a t-attf-href="/my/applicants/#{applicant.id}">
                                    <strong t-out="applicant.partner_name or applicant.display_name" />
                                </a>
                            </td>
                            <td>
                                <span t-if="applicant.job_id" t-out="applicant.job_id.name" />
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td t-out="applicant.email_from or '—'" />
                            <td t-out="applicant.partner_phone or '—'" />
                            <td>
                                <span class="badge bg-info">
                                    <t t-out="applicant.stage_id.name" />
                                </span>
                            </td>
                            <td>
                                <t t-out="applicant.create_date" t-options='{"widget": "date"}' />
                            </td>
                            <td class="text-center">
                                <t t-if="applicant.priority == '0'">—</t>
                                <t t-if="applicant.priority == '1'">&#9733;</t>
                                <t t-if="applicant.priority == '2'">&#9733;&#9733;</t>
                                <t t-if="applicant.priority == '3'">&#9733;&#9733;&#9733;</t>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Applicant — Detail                                           -->
    <!-- ============================================================ -->

    <template id="portal_applicant_detail" name="Applicant Detail">
        <t t-call="portal.portal_layout">
            <div class="container py-3">
                <!-- Header -->
                <div class="row mb-4">
                    <div class="col-md-8">
                        <h2 t-out="applicant.partner_name or applicant.display_name" />
                        <div class="text-muted">
                            Applied for: <strong t-if="applicant.job_id" t-out="applicant.job_id.name" />
                            <span t-if="applicant.department_id"> · <t t-out="applicant.department_id.name" /></span>
                        </div>
                    </div>
                    <div class="col-md-4 text-end">
                        <span class="badge bg-info fs-6">
                            <t t-out="applicant.stage_id.name" />
                        </span>
                    </div>
                </div>

                <div class="row">
                    <!-- Left column — info + stage -->
                    <div class="col-md-8">
                        <!-- Stage pipeline -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Pipeline Stage</h5>
                            </div>
                            <div class="card-body">
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <t t-foreach="stages" t-as="stage">
                                        <form t-attf-action="/my/applicants/#{applicant.id}/stage" method="post" class="d-inline">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                            <input type="hidden" name="stage_id" t-att-value="stage.id" />
                                            <button type="submit"
                                                t-attf-class="btn btn-sm #{applicant.stage_id.id == stage.id and 'btn-primary' or 'btn-outline-secondary'}">
                                                <t t-out="stage.name" />
                                            </button>
                                        </form>
                                    </t>
                                </div>
                                <small class="text-muted">
                                    Last stage update:
                                    <t t-out="applicant.date_last_stage_update" t-options='{"widget": "datetime"}' />
                                </small>
                            </div>
                        </div>

                        <!-- Introduction / Notes from applicant -->
                        <div t-if="applicant.applicant_notes" class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Applicant Introduction</h5>
                            </div>
                            <div class="card-body" t-out="applicant.applicant_notes" />
                        </div>

                        <!-- Attachments / Resume -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Attachments</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="applicant.attachment_ids">
                                    <ul class="list-unstyled mb-0">
                                        <t t-foreach="applicant.attachment_ids" t-as="att">
                                            <li class="mb-2">
                                                <a t-attf-href="/my/applicants/#{applicant.id}/resume/#{att.id}"
                                                    class="btn btn-sm btn-outline-primary">
                                                    <i class="fa fa-download me-1" />
                                                    <t t-out="att.name" />
                                                </a>
                                                <small class="text-muted ms-2">
                                                    (<t t-out="'%.1f' % (att.file_size / 1024)" /> KB)
                                                </small>
                                            </li>
                                        </t>
                                    </ul>
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No attachments.</span>
                                </t>
                            </div>
                        </div>

                        <!-- Add note -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Add Internal Note</h5>
                            </div>
                            <div class="card-body">
                                <form t-attf-action="/my/applicants/#{applicant.id}/note" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                    <div class="mb-3">
                                        <textarea class="form-control" name="note" rows="3"
                                            placeholder="Add a note about this applicant..." required="required" />
                                    </div>
                                    <button type="submit" class="btn btn-primary">Post Note</button>
                                </form>
                            </div>
                        </div>

                        <!-- Message history -->
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Activity Log</h5>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="applicant.message_ids">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="applicant.message_ids[:15]" t-as="msg">
                                            <div class="list-group-item">
                                                <div class="d-flex justify-content-between">
                                                    <strong t-out="msg.author_id.name or 'System'" />
                                                    <small class="text-muted">
                                                        <t t-out="msg.date" t-options='{"widget": "datetime"}' />
                                                    </small>
                                                </div>
                                                <div class="mt-1" t-out="msg.body" />
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="p-3 text-muted text-center">No activity yet.</div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Right column — contact info -->
                    <div class="col-md-4">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Contact Info</h5>
                            </div>
                            <div class="card-body">
                                <dl class="mb-0">
                                    <dt>Email</dt>
                                    <dd>
                                        <a t-if="applicant.email_from" t-attf-href="mailto:#{applicant.email_from}"
                                            t-out="applicant.email_from" />
                                        <span t-else="" class="text-muted">—</span>
                                    </dd>
                                    <dt>Phone</dt>
                                    <dd>
                                        <a t-if="applicant.partner_phone" t-attf-href="tel:#{applicant.partner_phone}"
                                            t-out="applicant.partner_phone" />
                                        <span t-else="" class="text-muted">—</span>
                                    </dd>
                                    <dt>LinkedIn</dt>
                                    <dd>
                                        <a t-if="applicant.linkedin_profile" t-att-href="applicant.linkedin_profile"
                                            target="_blank" t-out="applicant.linkedin_profile" />
                                        <span t-else="" class="text-muted">—</span>
                                    </dd>
                                </dl>
                            </div>
                        </div>

                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Details</h5>
                            </div>
                            <div class="card-body">
                                <dl class="mb-0">
                                    <dt>Applied On</dt>
                                    <dd><t t-out="applicant.create_date" t-options='{"widget": "date"}' /></dd>
                                    <dt>Source</dt>
                                    <dd>
                                        <span t-if="applicant.source_id" t-out="applicant.source_id.name" />
                                        <span t-else="" class="text-muted">—</span>
                                    </dd>
                                    <dt>Recruiter</dt>
                                    <dd>
                                        <span t-if="applicant.user_id" t-out="applicant.user_id.name" />
                                        <span t-else="" class="text-muted">Unassigned</span>
                                    </dd>
                                    <dt>Rating</dt>
                                    <dd>
                                        <t t-if="applicant.priority == '0'">Not rated</t>
                                        <t t-if="applicant.priority == '1'">&#9733; Good</t>
                                        <t t-if="applicant.priority == '2'">&#9733;&#9733; Very Good</t>
                                        <t t-if="applicant.priority == '3'">&#9733;&#9733;&#9733; Excellent</t>
                                    </dd>
                                    <dt>Tags</dt>
                                    <dd>
                                        <t t-if="applicant.categ_ids">
                                            <t t-foreach="applicant.categ_ids" t-as="tag">
                                                <span class="badge bg-secondary me-1" t-out="tag.name" />
                                            </t>
                                        </t>
                                        <span t-else="" class="text-muted">None</span>
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
