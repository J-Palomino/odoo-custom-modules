<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mint_command_center.PtlCalendarRenderer">
        <div class="o_ptl_calendar_with_dragboard d-flex">
            <div class="o_ptl_calendar_main flex-grow-1">
                <CalendarRenderer t-props="props"/>
            </div>
            <PtlDragboard model="props.model"/>
        </div>
    </t>

    <t t-name="mint_command_center.PtlDragboard">
        <div class="o_ptl_dragboard" t-ref="root">
            <div class="o_ptl_dragboard_header">
                <h5 class="mb-1">Approved Deals</h5>
                <small class="text-muted">
                    Drag a card onto a calendar day to schedule it.
                </small>
                <input type="search"
                       class="form-control form-control-sm mt-2"
                       placeholder="Search deals…"
                       t-model="state.search"/>
            </div>

            <div class="o_ptl_dragboard_body">
                <t t-if="state.loading">
                    <div class="text-center text-muted py-3">
                        <i class="fa fa-spinner fa-spin"/> Loading…
                    </div>
                </t>
                <t t-elif="filteredDeals.length === 0">
                    <div class="text-center text-muted py-3">
                        No approved deals in this range.
                    </div>
                </t>
                <t t-else="">
                    <t t-foreach="filteredDeals" t-as="deal" t-key="deal.id">
                        <div class="o_ptl_card card mb-2"
                             draggable="true"
                             t-att-data-deal-id="deal.id"
                             t-on-dragstart="(ev) => this.onCardDragStart(ev, deal)"
                             t-on-dragend.stop="onCardDragEnd">
                            <div class="card-body p-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <strong class="text-truncate" t-esc="deal.name"/>
                                    <span t-if="deal.is_featured" class="badge bg-warning text-dark ms-1" title="Featured">★</span>
                                </div>
                                <div class="text-muted small">
                                    <span t-if="deal.brand" t-esc="deal.brand"/>
                                    <span t-if="deal.brand and deal.category"> · </span>
                                    <span t-if="deal.category" t-esc="deal.category"/>
                                </div>
                                <div class="small mt-1">
                                    <span t-if="deal.display_text" t-esc="deal.display_text"/>
                                    <span t-elif="deal.discount_type">
                                        <span t-esc="deal.discount_type"/>
                                        <span> · </span>
                                        <span t-esc="deal.discount_value"/>
                                    </span>
                                </div>
                                <div class="text-muted small mt-1" t-if="deal.market">
                                    <i class="fa fa-map-marker"/> <span t-esc="deal.market"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
        </div>
    </t>

</templates>
