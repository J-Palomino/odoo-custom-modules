<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- PTL Day: visible to all (no company isolation — one day per date) -->
        <record id="rule_ptl_day_company" model="ir.rule">
            <field name="name">PTL Day: all users</field>
            <field name="model_id" ref="model_mint_ptl_day"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- PTL Deal: visible to all (shared templates, store filtering via store_ids) -->
        <record id="rule_ptl_deal_company" model="ir.rule">
            <field name="name">PTL Deal: all users</field>
            <field name="model_id" ref="model_mint_ptl_deal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!--
            PTL Deal Option / Deal Submission Option: explicit placeholder rules
            so the option models inherit the parent's policy by reference rather
            than silently lacking any ir.rule.
            TODO(#93643): when ptl.deal / deal.submission gain a real
            multi-market record rule, change these to a parent-domain join:
            [('ptl_deal_id.market_id', 'in', user_markets)] /
            [('submission_id.market_id', 'in', user_markets)].
        -->
        <record id="rule_ptl_deal_option_company" model="ir.rule">
            <field name="name">PTL Deal Option: all users (mirrors parent)</field>
            <field name="model_id" ref="model_mint_ptl_deal_option"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_deal_submission_option_company" model="ir.rule">
            <field name="name">Deal Submission Option: all users (mirrors parent)</field>
            <field name="model_id" ref="model_mint_deal_submission_option"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Hot Box Deal: multi-company isolation -->
        <record id="rule_hotbox_deal_company" model="ir.rule">
            <field name="name">Hot Box Deal: multi-company</field>
            <field name="model_id" ref="model_mint_hotbox_deal"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Brand Ranking: multi-company isolation -->
        <record id="rule_brand_ranking_company" model="ir.rule">
            <field name="name">Brand Ranking: multi-company</field>
            <field name="model_id" ref="model_mint_brand_ranking"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Compliance Variance: multi-company isolation (Many2many) -->
        <record id="rule_compliance_variance_company" model="ir.rule">
            <field name="name">Compliance Variance: multi-company</field>
            <field name="model_id" ref="model_mint_compliance_variance"/>
            <field name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Push Banner: multi-company isolation (Many2many) -->
        <record id="rule_push_banner_company" model="ir.rule">
            <field name="name">Push Banner: multi-company</field>
            <field name="model_id" ref="model_mint_push_banner"/>
            <field name="domain_force">['|', ('store_ids', '=', False), ('store_ids', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Deal Submission: visible to all internal users -->
        <record id="rule_deal_submission_all" model="ir.rule">
            <field name="name">Deal Submission: all internal users</field>
            <field name="model_id" ref="model_mint_deal_submission"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Brand Calendar: visible to all internal users -->
        <record id="rule_brand_calendar_all" model="ir.rule">
            <field name="name">Brand Calendar: all internal users</field>
            <field name="model_id" ref="model_mint_brand_calendar_entry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
