<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- PTL Day: multi-company isolation -->
        <record id="rule_ptl_day_company" model="ir.rule">
            <field name="name">PTL Day: multi-company</field>
            <field name="model_id" ref="model_mint_ptl_day"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

