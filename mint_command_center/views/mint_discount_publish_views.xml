<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the mint.discount form to surface the Dutchie publish UX. -->
    <record id="view_mint_discount_form_publish" model="ir.ui.view">
        <field name="name">mint.discount.form.publish</field>
        <field name="model">mint.discount</field>
        <field name="inherit_id" ref="mint_api_v2.view_mint_discount_form"/>
        <field name="arch" type="xml">
            <!-- Header: add Publish button + state widget -->
            <xpath expr="//header" position="inside">
                <button name="action_publish_to_dutchie"
                        type="object"
                        string="Publish to Dutchie"
                        class="oe_highlight"
                        invisible="source != 'manual' or not store_ids"
                        help="POST this discount to Dutchie POS for each linked store. Idempotent: skips already-synced stores unless re-saved with changes."/>
                <field name="publish_state" widget="statusbar"
                       statusbar_visible="draft,ready,partial,synced,failed"
                       readonly="1"
                       invisible="source != 'manual'"/>
            </xpath>

            <!-- Add a "Dutchie publish status" tab to the notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Dutchie publish status" name="dutchie_publish"
                      invisible="source != 'manual'">
                    <group>
                        <field name="publish_state_summary" readonly="1"/>
                    </group>
                    <field name="dutchie_link_ids" readonly="1">
                        <list decoration-success="state == 'synced'"
                              decoration-danger="state == 'failed'"
                              decoration-warning="state == 'pending'"
                              decoration-muted="state == 'skipped'">
                            <field name="location_id"/>
                            <field name="dutchie_loc_id"/>
                            <field name="dutchie_lsp_id"/>
                            <field name="state"/>
                            <field name="dutchie_discount_id"/>
                            <field name="synced_at"/>
                            <field name="attempts"/>
                            <field name="last_error" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Standalone form for inspecting a link record. -->
    <record id="view_mint_discount_dutchie_link_form" model="ir.ui.view">
        <field name="name">mint.discount.dutchie.link.form</field>
        <field name="model">mint.discount.dutchie.link</field>
        <field name="arch" type="xml">
            <form string="Dutchie publish link" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="discount_id" readonly="1"/>
                            <field name="location_id" readonly="1"/>
                            <field name="dutchie_loc_id" readonly="1"/>
                            <field name="dutchie_lsp_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="dutchie_discount_id" readonly="1"/>
                            <field name="synced_at" readonly="1"/>
                            <field name="attempts" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Last error" invisible="not last_error">
                            <field name="last_error" readonly="1"/>
                        </page>
                        <page string="Last request">
                            <field name="raw_request" readonly="1" widget="text"/>
                        </page>
                        <page string="Last response">
                            <field name="raw_response" readonly="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Surface LocId/LspId on the company form so admins can edit if needed. -->
    <record id="view_res_company_form_dutchie" model="ir.ui.view">
        <field name="name">res.company.form.dutchie</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Dutchie POS Integration" name="dutchie_pos">
                    <field name="x_dutchie_loc_id"/>
                    <field name="x_dutchie_lsp_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Cron is created programmatically in hooks.py (post_init_hook) per
         the convention used by the PTL crons. -->

</odoo>
