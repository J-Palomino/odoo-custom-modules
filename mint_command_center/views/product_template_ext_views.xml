<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_ptl_label" model="ir.ui.view">
        <field name="name">product.template.form.ptl-label</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Mint PTL Display" name="mint_ptl_display">
                    <field name="x_display_label_override"
                           placeholder="Override budtender label (leave empty to use product name)"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
