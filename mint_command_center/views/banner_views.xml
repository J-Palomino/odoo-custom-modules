<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==================== Push Banner Views ==================== -->

    <!-- Form View -->
    <record id="view_push_banner_form" model="ir.ui.view">
        <field name="name">mint.push.banner.form</field>
        <field name="model">mint.push.banner</field>
        <field name="arch" type="xml">
            <form string="Banner">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Summer Flower Sale"/></h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="slot"/>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Schedule">
                            <field name="active_from"/>
                            <field name="active_until"/>
                            <field name="store_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <group string="Content">
                            <field name="title" placeholder="Headline text"/>
                            <field name="subtitle" placeholder="Supporting text"/>
                            <field name="link_url" placeholder="https://..."/>
                            <field name="link_label"/>
                            <field name="background_color" placeholder="#1a1a2e"/>
                        </group>
                        <group string="Image">
                            <field name="image_url" placeholder="https://... (overrides upload)"/>
                            <field name="image" widget="image"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_push_banner_list" model="ir.ui.view">
        <field name="name">mint.push.banner.list</field>
        <field name="model">mint.push.banner</field>
        <field name="arch" type="xml">
            <list string="Banners" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slot"/>
                <field name="category"/>
                <field name="title"/>
                <field name="is_active"/>
                <field name="active_from"/>
                <field name="active_until"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_push_banner_kanban" model="ir.ui.view">
        <field name="name">mint.push.banner.kanban</field>
        <field name="model">mint.push.banner</field>
        <field name="arch" type="xml">
            <kanban default_group_by="slot">
                <field name="name"/>
                <field name="slot"/>
                <field name="title"/>
                <field name="is_active"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <field name="image" widget="image" options="{'size': [100, 60]}"/>
                        <strong><field name="name"/></strong>
                        <field name="title"/>
                        <div>
                            <field name="slot" widget="badge"/>
                            <field name="is_active" widget="boolean"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_push_banner_search" model="ir.ui.view">
        <field name="name">mint.push.banner.search</field>
        <field name="model">mint.push.banner</field>
        <field name="arch" type="xml">
            <search string="Banners">
                <field name="name"/>
                <field name="title"/>
                <field name="slot"/>
                <field name="category"/>
                <filter name="active" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('is_active', '=', False)]"/>
                <separator/>
                <filter name="interstitial" string="Interstitial" domain="[('slot', '=', 'interstitial')]"/>
                <filter name="slot_type" string="Slot" domain="[('slot', '=', 'slot')]"/>
                <filter name="popup" string="Popup" domain="[('slot', '=', 'popup')]"/>
                <separator/>
                <filter name="group_slot" string="Slot Type" context="{'group_by': 'slot'}"/>
                <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_push_banner" model="ir.actions.act_window">
        <field name="name">Banners</field>
        <field name="res_model">mint.push.banner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_push_banner_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
