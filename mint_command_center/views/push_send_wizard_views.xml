<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Extend base wizard form with targeting fields ============ -->
    <record id="mint_push_send_wizard_form" model="ir.ui.view">
        <field name="name">mint.push.send.wizard.form.command_center</field>
        <field name="model">mint.push.send.wizard</field>
        <field name="inherit_id" ref="mint_push.view_push_send_wizard_form"/>
        <field name="arch" type="xml">
            <!-- Add targeting fields before the first group -->
            <xpath expr="//form/group[1]" position="before">
                <group string="Targeting">
                    <field name="company_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="All subscribers"/>
                    <field name="region" placeholder="e.g., arizona"/>
                </group>
                <group>
                    <field name="url_template" widget="radio"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ============ Wizard Action ============ -->
    <record id="action_push_send_wizard" model="ir.actions.act_window">
        <field name="name">Send Notification</field>
        <field name="res_model">mint.push.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mint_push_send_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
