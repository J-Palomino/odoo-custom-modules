<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==================== Push Notification Views ==================== -->

    <!-- Form: compose a push notification -->
    <record id="view_push_notification_form" model="ir.ui.view">
        <field name="name">mint.push.notification.form</field>
        <field name="model">mint.push.notification</field>
        <field name="arch" type="xml">
            <form string="Push Notification">
                <header>
                    <button name="action_send" string="Send Now"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Send this push notification to the targeted subscribers?"/>
                    <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object"
                            invisible="state not in ('sent', 'failed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sending,sent"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Title"/>
                        <h1><field name="name" placeholder="Mint Cannabis"/></h1>
                    </div>
                    <group>
                        <group string="Content">
                            <field name="site_id" placeholder="All sites"
                                   options="{'no_create': True}"/>
                            <field name="body" placeholder="Check out today's deals!"/>
                            <field name="url" placeholder="/"/>
                            <field name="icon" placeholder="/favicon.png"/>
                            <field name="image_url" placeholder="https://..."/>
                        </group>
                        <group string="Delivery">
                            <field name="estimated_audience"/>
                            <field name="sent_at" readonly="1"/>
                            <field name="total_targeted" readonly="1"/>
                            <field name="sent_count" readonly="1"/>
                            <field name="failed_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Targeting">
                        <field name="targeting_mode" widget="radio"/>
                        <field name="company_ids" widget="many2many_tags"
                               domain="[('parent_id', '!=', False)]"
                               options="{'no_create': True}"
                               invisible="targeting_mode != 'stores'"/>
                        <field name="proximity_store_id"
                               options="{'no_create': True}"
                               invisible="targeting_mode != 'proximity'"/>
                        <field name="proximity_radius"
                               invisible="targeting_mode != 'proximity'"/>
                    </group>
                    <group string="Action Buttons (Chrome/Android)" col="4">
                        <field name="action_1_title" placeholder="View Deals"/>
                        <field name="action_1_url" placeholder="/deals"/>
                        <field name="action_2_title" placeholder="Shop Now"/>
                        <field name="action_2_url" placeholder="/shop"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List: notification history -->
    <record id="view_push_notification_list" model="ir.ui.view">
        <field name="name">mint.push.notification.list</field>
        <field name="model">mint.push.notification</field>
        <field name="arch" type="xml">
            <list string="Push Notifications"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'sending'"
                  decoration-success="state == 'sent'"
                  decoration-danger="state == 'failed'">
                <field name="site_id" optional="show"/>
                <field name="name"/>
                <field name="body"/>
                <field name="url"/>
                <field name="targeting_mode"/>
                <field name="state"/>
                <field name="sent_count"/>
                <field name="failed_count"/>
                <field name="sent_at"/>
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="view_push_notification_search" model="ir.ui.view">
        <field name="name">mint.push.notification.search</field>
        <field name="model">mint.push.notification</field>
        <field name="arch" type="xml">
            <search string="Push Notifications">
                <field name="name"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
                <filter name="group_targeting" string="Targeting" context="{'group_by': 'targeting_mode'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_push_notification" model="ir.actions.act_window">
        <field name="name">Push Notifications</field>
        <field name="res_model">mint.push.notification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_push_notification_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a push notification
            </p>
            <p>
                Compose and send push notifications to all subscribed MintDeals app users.
            </p>
        </field>
    </record>

    <!-- ==================== Push Subscription Views ==================== -->

    <!-- List: subscriptions (read-only dashboard) -->
    <record id="view_push_subscription_list" model="ir.ui.view">
        <field name="name">mint.push.subscription.list</field>
        <field name="model">mint.push.subscription</field>
        <field name="arch" type="xml">
            <list string="Push Subscribers" create="0" edit="0">
                <field name="site_id"/>
                <field name="store_id"/>
                <field name="region"/>
                <field name="endpoint" string="Endpoint" widget="char"/>
                <field name="user_agent"/>
                <field name="is_active"/>
                <field name="last_sent"/>
                <field name="create_date" string="Subscribed"/>
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="view_push_subscription_search" model="ir.ui.view">
        <field name="name">mint.push.subscription.search</field>
        <field name="model">mint.push.subscription</field>
        <field name="arch" type="xml">
            <search string="Push Subscribers">
                <field name="endpoint"/>
                <field name="user_agent"/>
                <field name="store_id"/>
                <field name="region"/>
                <filter name="active" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('is_active', '=', False)]"/>
                <filter name="has_location" string="Has GPS" domain="[('latitude', '!=', False)]"/>
                <separator/>
                <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                <filter name="group_region" string="Region" context="{'group_by': 'region'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_push_subscription" model="ir.actions.act_window">
        <field name="name">Subscribers</field>
        <field name="res_model">mint.push.subscription</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_push_subscription_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No push subscribers yet
            </p>
            <p>
                When users enable push notifications on mintdeals.com, their subscriptions will appear here.
            </p>
        </field>
    </record>

</odoo>
