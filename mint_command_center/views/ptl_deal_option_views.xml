<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view (used embedded as one2many on ptl.deal form) -->
    <record id="view_ptl_deal_option_list" model="ir.ui.view">
        <field name="name">mint.ptl.deal.option.list</field>
        <field name="model">mint.ptl.deal.option</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="sales_details" optional="show"/>
                <field name="display_text" optional="show" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Form view (rarely used directly; mostly for admin inspection) -->
    <record id="view_ptl_deal_option_form" model="ir.ui.view">
        <field name="name">mint.ptl.deal.option.form</field>
        <field name="model">mint.ptl.deal.option</field>
        <field name="arch" type="xml">
            <form string="PTL Deal Option">
                <sheet>
                    <group>
                        <field name="ptl_deal_id"/>
                        <field name="sequence"/>
                        <field name="discount_type"/>
                        <field name="discount_value"/>
                    </group>
                    <group string="Display">
                        <field name="sales_details"/>
                        <field name="display_text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
