<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==================== Top-Level Mint Marketing Menu ==================== -->

    <menuitem id="menu_command_center_root"
              name="Mint Marketing"
              web_icon="mint_command_center,static/description/icon.png"
              sequence="5"/>

    <!-- Reparent the legacy mint_banner top-level "Mint Marketing" menu under
         the Command Center so there is a single Mint Marketing app tile. -->
    <record id="mint_banner.menu_mint_banner_root" model="ir.ui.menu">
        <field name="name">Storefront CMS</field>
        <field name="parent_id" ref="menu_command_center_root"/>
        <field name="web_icon">false</field>
        <field name="sequence">30</field>
    </record>

    <!-- ── Deals Section ──
         Single home for everything deal-related: PTL, Hot Box, Brand
         Calendar/Rankings, vendor submissions. The xmlid `menu_ptl` is reused
         (renamed) so existing references and bookmarks keep resolving. -->
    <menuitem id="menu_ptl"
              name="Deals"
              parent="menu_command_center_root"
              sequence="10"/>

    <menuitem id="menu_ptl_calendar"
              name="PTL Calendar"
              parent="menu_ptl"
              action="action_ptl_day"
              sequence="10"/>

    <menuitem id="menu_ptl_review_queue"
              name="Review Queue"
              parent="menu_ptl"
              action="action_ptl_deal_review_queue"
              sequence="15"/>

    <menuitem id="menu_ptl_deals"
              name="Deal Catalog"
              parent="menu_ptl"
              action="action_ptl_deal"
              sequence="20"/>

    <menuitem id="menu_brand_calendar"
              name="Brand Calendar"
              parent="menu_ptl"
              action="action_brand_calendar_entry"
              sequence="25"/>

    <menuitem id="menu_deal_submissions"
              name="Deal Submissions"
              parent="menu_ptl"
              action="action_deal_submission"
              sequence="30"/>

    <menuitem id="menu_national_promo"
              name="National Promo Log"
              parent="menu_ptl"
              action="action_national_promo"
              sequence="28"/>

    <menuitem id="menu_hotbox"
              name="Hot Box"
              parent="menu_ptl"
              action="action_hotbox_deal"
              sequence="35"/>

    <menuitem id="menu_brand_rankings"
              name="Brand Rankings"
              parent="menu_ptl"
              action="action_brand_ranking"
              sequence="40"/>

    <!-- ── Push Section ── (was "Marketing") -->
    <menuitem id="menu_marketing"
              name="Push"
              parent="menu_command_center_root"
              sequence="20"/>

    <menuitem id="menu_push_notifications"
              name="Push Notifications"
              parent="menu_marketing"
              action="action_push_notification"
              sequence="10"/>

    <menuitem id="menu_push_subscribers"
              name="Subscribers"
              parent="menu_marketing"
              action="action_push_subscription"
              sequence="20"/>

    <menuitem id="menu_push_sites"
              name="Sites"
              parent="menu_marketing"
              action="action_push_sites"
              sequence="25"/>

    <menuitem id="menu_push_banners"
              name="Banners"
              parent="menu_marketing"
              action="action_push_banner"
              sequence="30"/>

    <!-- ── Compliance Section ── -->
    <menuitem id="menu_compliance"
              name="Compliance"
              parent="menu_command_center_root"
              sequence="40"/>

    <menuitem id="menu_compliance_variances"
              name="Variances"
              parent="menu_compliance"
              action="action_compliance_variance"
              sequence="10"/>

</odoo>
