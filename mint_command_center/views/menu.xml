<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==================== Top-Level Mint Marketing Menu ==================== -->

    <menuitem id="menu_command_center_root"
              name="Mint Marketing"
              web_icon="mint_command_center,static/description/icon.png"
              sequence="5"/>

    <!-- Reparent the legacy mint_banner top-level "Mint Marketing" menu under
         the Command Center so there is a single Mint Marketing app tile. -->
    <record id="mint_banner.menu_mint_banner_root" model="ir.ui.menu">
        <field name="name">Storefront CMS</field>
        <field name="parent_id" ref="menu_command_center_root"/>
        <field name="web_icon">false</field>
        <field name="sequence">30</field>
    </record>

    <!-- ── Deals Section ──
         Single home for everything deal-related: PTL, Hot Box, Brand
         Calendar/Rankings, vendor submissions. The xmlid `menu_ptl` is reused
         (renamed) so existing references and bookmarks keep resolving. -->
    <menuitem id="menu_ptl"
              name="Deals"
              parent="menu_command_center_root"
              sequence="10"/>

    <menuitem id="menu_ptl_calendar"
              name="Daily Deals"
              parent="menu_ptl"
              action="action_ptl_day"
              sequence="10"/>

    <menuitem id="menu_ptl_review_queue"
              name="Review Queue"
              parent="menu_ptl"
              action="action_ptl_deal_review_queue"
              sequence="15"/>

    <menuitem id="menu_ptl_deals"
              name="National Promo Log"
              parent="menu_ptl"
              action="action_ptl_deal"
              sequence="20"/>

    <menuitem id="menu_brand_calendar"
              name="Brand Calendar"
              parent="menu_ptl"
              action="action_brand_calendar_entry"
              sequence="25"/>

    <!-- Temporarily hide "Brand Calendar". Re-enable by setting active back
         to True (prod xmlid row is pinned noupdate, so flip it live too). -->
    <record id="menu_brand_calendar" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem id="menu_deal_submissions"
              name="Deal Submissions"
              parent="menu_ptl"
              action="action_deal_submission"
              sequence="30"/>

    <!-- "Promo Campaigns" scoped to system administrators only
         (base.group_system). Hidden from the ~165 non-admin Mint Marketing
         users; the 9 admins still navigate to it normally. NOTE: on prod this
         menu's ir.model.data is pinned noupdate=True so the live group scope
         survives -u; this menuitem keeps source/fresh-installs consistent. -->
    <menuitem id="menu_national_promo"
              name="Promo Campaigns"
              parent="menu_ptl"
              action="action_national_promo"
              sequence="28"
              groups="base.group_system"/>

    <menuitem id="menu_hotbox"
              name="Hot Box"
              parent="menu_ptl"
              action="action_hotbox_deal"
              sequence="35"/>

    <!-- Hide "Hot Box" from the Mint Marketing menu. The action
         (action_hotbox_deal) and hotbox.deal model are retained and still
         reachable directly; re-enable by setting active back to True (prod
         xmlid row is pinned noupdate, so flip it live too). -->
    <record id="menu_hotbox" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem id="menu_brand_rankings"
              name="Brand Rankings"
              parent="menu_ptl"
              action="action_brand_ranking"
              sequence="40"/>

    <!-- Hide "Brand Rankings" — same pattern as Hot Box above. -->
    <record id="menu_brand_rankings" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- ── Push Section ── (was "Marketing") -->
    <menuitem id="menu_marketing"
              name="Push"
              parent="menu_command_center_root"
              sequence="20"/>

    <menuitem id="menu_push_notifications"
              name="Push Notifications"
              parent="menu_marketing"
              action="action_push_notification"
              sequence="10"/>

    <menuitem id="menu_push_subscribers"
              name="Subscribers"
              parent="menu_marketing"
              action="action_push_subscription"
              sequence="20"/>

    <menuitem id="menu_push_sites"
              name="Sites"
              parent="menu_marketing"
              action="action_push_sites"
              sequence="25"/>

    <menuitem id="menu_push_banners"
              name="Banners"
              parent="menu_marketing"
              action="action_push_banner"
              sequence="30"/>

    <!-- ── Loyalty Section ──
         Reparents the three menuitems that mint_api_v2 originally hung off a
         duplicate top-level "Mint Marketing" menu (menu_mint_discount_root).
         Same override pattern as mint_banner.menu_mint_banner_root above. -->
    <menuitem id="menu_command_center_loyalty"
              name="Loyalty"
              parent="menu_command_center_root"
              sequence="35"/>

    <record id="mint_api_v2.menu_mint_discount" model="ir.ui.menu">
        <field name="parent_id" ref="menu_command_center_loyalty"/>
        <field name="sequence">10</field>
    </record>

    <record id="mint_api_v2.menu_mint_redemptions" model="ir.ui.menu">
        <field name="parent_id" ref="menu_command_center_loyalty"/>
        <field name="sequence">20</field>
    </record>

    <record id="mint_api_v2.menu_mint_loyalty_products" model="ir.ui.menu">
        <field name="parent_id" ref="menu_command_center_loyalty"/>
        <field name="sequence">30</field>
    </record>

    <!-- Coupon Codes belongs to this module (its action lives in
         views/mint_discount_coupon_views.xml, which loads earlier). It is
         declared here rather than beside its action because its parent —
         menu_command_center_loyalty — is defined in this file, and because its
         previous parent (mint_api_v2.menu_mint_discount_root) is deleted just
         below. Referencing that deleted xmlid made every mint_command_center
         upgrade fail with "External ID not found in the system". -->
    <menuitem id="menu_mint_coupon_codes"
              name="Coupon Codes"
              parent="menu_command_center_loyalty"
              action="action_mint_coupon_codes"
              sequence="15"/>

    <delete id="mint_api_v2.menu_mint_discount_root" model="ir.ui.menu"/>

    <!-- ── Intel Section ──
         Competitive intelligence — competitor dispensaries and the deals
         they're running. Read by Marketing, edited by Operations. -->
    <menuitem id="menu_intel"
              name="Intel"
              parent="menu_command_center_root"
              sequence="33"/>

    <menuitem id="menu_competitors"
              name="Competitors"
              parent="menu_intel"
              action="action_competitor"
              sequence="10"/>

    <menuitem id="menu_competitor_deals"
              name="Competitor Deals"
              parent="menu_intel"
              action="action_competitor_deal"
              sequence="20"/>

    <!-- ── Operations Section ──
         Paid placements, billboards, advertising-vendor CRM. -->
    <menuitem id="menu_operations"
              name="Operations"
              parent="menu_command_center_root"
              sequence="36"/>

    <menuitem id="menu_placement_catalog"
              name="Placement Catalog"
              parent="menu_operations"
              action="action_placement_type"
              sequence="10"/>

    <menuitem id="menu_placement_inventory"
              name="Placement Inventory"
              parent="menu_operations"
              action="action_placement_inventory"
              sequence="20"/>

    <menuitem id="menu_placement_bookings"
              name="Bookings"
              parent="menu_operations"
              action="action_placement_booking"
              sequence="30"/>

    <menuitem id="menu_placement_revenue"
              name="Revenue"
              parent="menu_operations"
              action="action_placement_revenue"
              sequence="40"/>

    <menuitem id="menu_billboards"
              name="Billboards"
              parent="menu_operations"
              sequence="60"/>

    <menuitem id="menu_billboard_vendors"
              name="Vendors"
              parent="menu_billboards"
              action="action_billboard_vendor"
              sequence="10"/>

    <menuitem id="menu_billboard_boards"
              name="Boards"
              parent="menu_billboards"
              action="action_billboard_board"
              sequence="20"/>

    <menuitem id="menu_billboard_creatives"
              name="Creatives"
              parent="menu_billboards"
              action="action_billboard_creative"
              sequence="30"/>

    <menuitem id="menu_billboard_schedules"
              name="Schedules"
              parent="menu_billboards"
              action="action_billboard_schedule"
              sequence="40"/>

    <menuitem id="menu_advertising_vendors"
              name="Advertising Vendors"
              parent="menu_operations"
              action="action_ad_vendor"
              sequence="70"/>

    <!-- ── Field Team Section ──
         Brand ambassadors and the shifts they cover. Owned by group_operations
         with read/write for group_vendor_manager (vendors coordinate their
         own ambassadors). -->
    <menuitem id="menu_field_team"
              name="Field Team"
              parent="menu_command_center_root"
              sequence="37"/>

    <menuitem id="menu_ambassadors"
              name="Ambassadors"
              parent="menu_field_team"
              action="action_ambassador"
              sequence="10"/>

    <menuitem id="menu_ambassador_shifts"
              name="Shifts"
              parent="menu_field_team"
              action="action_ambassador_shift"
              sequence="20"/>

    <!-- ── Compliance Section ── -->
    <menuitem id="menu_compliance"
              name="Compliance"
              parent="menu_command_center_root"
              sequence="40"/>

    <menuitem id="menu_compliance_variances"
              name="Variances"
              parent="menu_compliance"
              action="action_compliance_variance"
              sequence="10"/>

    <!-- ── Setup Section ── -->
    <menuitem id="menu_command_center_setup"
              name="Setup"
              parent="menu_command_center_root"
              sequence="50"/>

    <menuitem id="menu_setup_brands"
              name="Brands"
              parent="menu_command_center_setup"
              action="action_mint_brand"
              sequence="10"/>

    <!-- ── Inventory Section ── -->
    <menuitem id="menu_command_center_inventory"
              name="Inventory"
              parent="menu_command_center_root"
              sequence="38"/>

    <menuitem id="menu_inventory_brand_reorder"
              name="Brand Reorder Builder"
              parent="menu_command_center_inventory"
              action="action_brand_reorder_wizard"
              sequence="10"/>

    <!-- ── Audit Section ── -->
    <menuitem id="menu_command_center_audit"
              name="Audit"
              parent="menu_command_center_root"
              sequence="45"/>

    <menuitem id="menu_audit_revocations"
              name="Revocation Log"
              parent="menu_command_center_audit"
              action="action_revocation_audit_log"
              sequence="10"/>

    <menuitem id="menu_audit_bulk_revoke"
              name="Bulk Revoke By Brand"
              parent="menu_command_center_audit"
              action="action_bulk_revoke_wizard"
              sequence="20"
              groups="mint_command_center.group_ptl_manager"/>

</odoo>
