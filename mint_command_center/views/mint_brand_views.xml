<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mint_brand_view_list" model="ir.ui.view">
        <field name="name">mint.brand.list</field>
        <field name="model">mint.brand</field>
        <field name="arch" type="xml">
            <list string="Brands" editable="bottom">
                <!-- Logo replaces the emoji as the at-a-glance identifier. The list is
                     editable="bottom", so this cell is also the upload target: dropping a
                     full-resolution image here syncs it to the CDN and fills Logo URL, which
                     is what the storefront reads and what makes the asset reusable.
                     display_emoji is NOT deleted - it still prefixes the brand name in the
                     budtender-facing PTL text exports - it is just no longer a default
                     column. Re-enable it from the column picker if you need it. -->
                <field name="logo" widget="image" string="Logo"
                       options="{'size': [40, 40]}" optional="show"/>
                <field name="name"/>
                <field name="display_emoji" string="Emoji" optional="hide"/>
                <field name="slug" optional="hide"/>
                <field name="dutchie_brand_id" optional="show"/>
                <field name="product_count" string="# Products"/>
                <!-- The thumbnail is the uploaded BINARY: widget="image" is proven on list
                     views here (res.partner, hr.employee, product.tag all use it), whereas
                     widget="image_url" has no list precedent on this instance and a bad view
                     aborts the whole module upgrade.
                     So read the two columns together: the thumbnail says "art was uploaded",
                     Banner URL says "the CDN sync landed". A row with a picture and an empty
                     URL is the silent-failure case — _sync_deal_banner_to_r2 swallows its
                     exceptions, so that pairing is the only way to see it without the log. -->
                <field name="deal_banner" widget="image" string="Deal Banner"
                       options="{'size': [96, 24]}" optional="show"/>
                <field name="deal_banner_url" string="Banner URL" optional="hide"/>
                <field name="logo_url" string="Logo URL" optional="hide"/>
                <field name="website" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mint_brand_view_form" model="ir.ui.view">
        <field name="name">mint.brand.form</field>
        <field name="model">mint.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_emoji" placeholder="🌿"
                                   style="font-size:1.5em;width:2em;"/>
                            <field name="name" placeholder="Brand name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="slug"/>
                            <field name="website" widget="url"/>
                            <field name="logo_url" widget="url"/>
                            <field name="deal_banner_url" widget="url"/>
                        </group>
                        <group>
                            <field name="dutchie_brand_id"/>
                            <field name="product_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Brand description..."/>
                        </page>
                        <page string="Logo">
                            <field name="logo" widget="image"/>
                        </page>
                        <page string="Deal Banner">
                            <div class="text-muted mb-2">
                                Deal banner art is 1240 x 310 (exactly 4:1). Uploading
                                here pushes the file to the CDN and fills in Deal Banner
                                URL, which is what the storefront reads.
                            </div>
                            <field name="deal_banner" widget="image"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mint_brand_view_search" model="ir.ui.view">
        <field name="name">mint.brand.search</field>
        <field name="model">mint.brand</field>
        <field name="arch" type="xml">
            <search string="Brands">
                <field name="name"/>
                <field name="dutchie_brand_id"/>
                <separator/>
                <filter name="has_emoji" string="Has Emoji"
                        domain="[('display_emoji', '!=', False)]"/>
                <filter name="missing_emoji" string="Missing Emoji"
                        domain="[('display_emoji', '=', False)]"/>
                <filter name="has_dutchie" string="Linked to Dutchie"
                        domain="[('dutchie_brand_id', '!=', False)]"/>
                <separator/>
                <!-- Keyed on logo_url, not the binary: same reasoning as the banner
                     filters - an upload whose CDN sync failed must read as MISSING,
                     because logo_url is what the storefront actually renders. -->
                <filter name="has_logo" string="Has Logo"
                        domain="[('logo_url', '!=', False)]"/>
                <filter name="missing_logo" string="Missing Logo"
                        domain="[('logo_url', '=', False)]"/>
                <separator/>
                <!-- Both filter on deal_banner_url rather than the binary. A brand whose
                     upload succeeded but whose CDN sync failed has the image and no URL,
                     and the storefront would show nothing — so "Missing" must catch it. -->
                <filter name="has_deal_banner" string="Has Deal Banner"
                        domain="[('deal_banner_url', '!=', False)]"/>
                <filter name="missing_deal_banner" string="Missing Deal Banner"
                        domain="[('deal_banner_url', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_mint_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">mint.brand</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mint_brand_view_search"/>
        <!-- The only UI entry point allowed to create brands; mint.brand.create
             refuses everything else (see BRAND_CREATE_CTX in mint_api_v2). -->
        <field name="context">{'mint_brand_allow_create': True}</field>
    </record>

</odoo>
