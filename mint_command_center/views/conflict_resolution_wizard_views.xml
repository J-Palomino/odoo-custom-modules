<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_conflict_resolution_wizard_form" model="ir.ui.view">
        <field name="name">mint.ptl.conflict.resolution.wizard.form</field>
        <field name="model">mint.ptl.conflict.resolution.wizard</field>
        <field name="arch" type="xml">
            <form string="Resolve Plot Conflicts">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Overlapping deals detected.</strong>
                        For each row below pick a resolution. Non-conflicting
                        entries in this batch will plot normally.
                    </div>
                    <group>
                        <field name="bulk_apply"/>
                        <field name="non_conflict_count" readonly="1"/>
                    </group>
                    <field name="conflict_line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="date"/>
                            <field name="brand_id"/>
                            <field name="existing_deal_id" readonly="1"
                                   options="{'no_open': True, 'no_create': True}"/>
                            <field name="proposed_deal_id" readonly="1"
                                   options="{'no_open': True, 'no_create': True}"/>
                            <field name="resolution" widget="selection"
                                   required="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_apply" type="object"
                            string="Apply Resolution &amp; Plot"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
