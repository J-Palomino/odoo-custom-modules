<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ptl_text_deals_wizard_form" model="ir.ui.view">
        <field name="name">mint.ptl.text.deals.wizard.form</field>
        <field name="model">mint.ptl.text.deals.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Text Deals">
                <sheet>
                    <group>
                        <field name="day_id" readonly="1"/>
                    </group>
                    <separator string="Plain-text deals (SMS / POS-paste friendly)"/>
                    <field name="output_text" nolabel="1" readonly="1"
                           options="{'rows': 20}"
                           placeholder="No deals on this day."/>
                    <p class="text-muted oe_grey">
                        Select all (Ctrl/Cmd-A) inside the box and copy.
                        Strikethrough on MSRP uses U+0336 combining overlay —
                        renders in iMessage, SMS, Slack, Notes, and most POS
                        terminals. If your target context strips combining
                        characters, fall back to the Print Menu PDF.
                    </p>
                </sheet>
                <footer>
                    <button name="action_download_txt" type="object"
                            string="Download .txt"
                            class="btn-primary"/>
                    <button special="cancel" string="Close"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
