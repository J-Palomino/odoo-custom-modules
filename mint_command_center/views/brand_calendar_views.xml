<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==================== Brand Calendar Views ==================== -->

    <!-- Form View -->
    <record id="view_brand_calendar_form" model="ir.ui.view">
        <field name="name">mint.brand.calendar.entry.form</field>
        <field name="model">mint.brand.calendar.entry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm"
                            type="object"
                            invisible="state != 'tentative'"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="btn-primary"
                            invisible="state not in ('tentative','confirmed')"/>
                    <button name="action_publish" string="Publish"
                            type="object" class="btn-success"
                            invisible="state not in ('confirmed','approved')"/>
                    <button name="action_unpublish" string="Unpublish"
                            type="object"
                            invisible="state != 'published'"/>
                    <button name="action_add_to_ptl" string="Add to PTL"
                            type="object"
                            invisible="state == 'published' or not deal_id"
                            confirm="This will create/link a PTL Day and add the deal. Continue?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="tentative,confirmed,approved,published"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="brand_id"/>
                            <field name="date"/>
                            <field name="market_id" options="{'no_create': True}"/>
                            <field name="campaign_id" options="{'no_create': True}"/>
                            <field name="slot_type"/>
                            <field name="is_published" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="sku_or_category"/>
                            <field name="product_template_id"
                                   options="{'no_create': True}"/>
                            <field name="product_category_id"
                                   options="{'no_create': True}"/>
                            <field name="deal_id"/>
                            <field name="submission_id" readonly="1"/>
                            <field name="ptl_day_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Promo">
                        <group>
                            <field name="promo_text"/>
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="original_price"/>
                        </group>
                        <group>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="vendor_funding_amount" widget="monetary"/>
                            <field name="vendor_funding_percent"/>
                            <field name="currency_id" column_invisible="True"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Internal notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_brand_calendar_list" model="ir.ui.view">
        <field name="name">mint.brand.calendar.entry.list</field>
        <field name="model">mint.brand.calendar.entry</field>
        <field name="arch" type="xml">
            <list string="Brand Calendar"
                  decoration-info="state == 'tentative'"
                  decoration-success="state == 'published'">
                <field name="date"/>
                <field name="brand_id"/>
                <field name="sku_or_category"/>
                <field name="promo_text"/>
                <field name="market_id"/>
                <field name="campaign_id" optional="show"/>
                <field name="discount_type" optional="hide"/>
                <field name="discount_value" optional="hide"/>
                <field name="deal_id" optional="hide"/>
                <field name="slot_type" optional="hide"/>
                <field name="ptl_day_id" optional="hide"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'tentative'"
                       decoration-warning="state == 'confirmed'"
                       decoration-primary="state == 'approved'"
                       decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_brand_calendar_calendar" model="ir.ui.view">
        <field name="name">mint.brand.calendar.entry.calendar</field>
        <field name="model">mint.brand.calendar.entry</field>
        <field name="arch" type="xml">
            <calendar string="Brand Calendar"
                      date_start="date"
                      color="brand_id"
                      quick_create="0">
                <field name="brand_id"/>
                <field name="deal_id"/>
                <field name="market_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_brand_calendar_kanban" model="ir.ui.view">
        <field name="name">mint.brand.calendar.entry.kanban</field>
        <field name="model">mint.brand.calendar.entry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="brand_id"/>
                <field name="date"/>
                <field name="market_id"/>
                <field name="deal_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="brand_id" class="fw-bold"/>
                        <field name="date"/>
                        <div class="d-flex justify-content-between">
                            <field name="market_id"/>
                            <field name="deal_id" class="text-muted"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_brand_calendar_search" model="ir.ui.view">
        <field name="name">mint.brand.calendar.entry.search</field>
        <field name="model">mint.brand.calendar.entry</field>
        <field name="arch" type="xml">
            <search string="Search Brand Calendar">
                <field name="brand_id"/>
                <field name="market_id"/>
                <field name="campaign_id"/>
                <field name="sku_or_category"/>
                <field name="deal_id"/>
                <filter name="tentative" string="Tentative" domain="[('state', '=', 'tentative')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <separator/>
                <filter name="ready_to_publish" string="Ready to Publish (next 7 days)"
                        domain="[('state','=','approved'),
                                 ('is_published','=', False),
                                 ('date','&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('date','&lt;=', (context_today()+relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="upcoming_7d" string="Upcoming (next 7 days)"
                        domain="[('date','&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('date','&lt;=', (context_today()+relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="featured" string="Featured" domain="[('slot_type', '=', 'featured')]"/>
                <filter name="is_published" string="Published flag"
                        domain="[('is_published','=', True)]"/>
                <separator/>
                <filter name="group_brand" string="Brand" context="{'group_by': 'brand_id'}"/>
                <filter name="group_campaign" string="Campaign" context="{'group_by': 'campaign_id'}"/>
                <filter name="group_sku" string="SKU/Category" context="{'group_by': 'sku_or_category'}"/>
                <filter name="group_market" string="Market" context="{'group_by': 'market_id'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'date:week'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_brand_calendar_entry" model="ir.actions.act_window">
        <field name="name">Brand Calendar</field>
        <field name="res_model">mint.brand.calendar.entry</field>
        <field name="view_mode">calendar,list,kanban,form</field>
        <field name="search_view_id" ref="view_brand_calendar_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No brand calendar entries yet
            </p>
            <p>
                Schedule brand promotion slots on specific dates.
                Confirmed entries can be added to PTL Days.
            </p>
        </field>
    </record>

</odoo>
