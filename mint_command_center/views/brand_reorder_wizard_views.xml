<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_brand_reorder_wizard_form" model="ir.ui.view">
        <field name="name">mint.brand.reorder.wizard.form</field>
        <field name="model">mint.brand.reorder.wizard</field>
        <field name="arch" type="xml">
            <form string="Brand Reorder Builder">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Pick a brand and (optionally) a subset of stores.
                        Click <strong>Build</strong> to compute reorder
                        recommendations from on-hand inventory + 30-day
                        sales velocity. Sorted lowest days-of-supply first.
                    </div>
                    <group>
                        <group>
                            <field name="brand_id" required="1"
                                   options="{'no_create': True}"/>
                            <field name="target_days_of_supply"/>
                        </group>
                        <group>
                            <field name="store_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="line_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0"
                              decoration-danger="days_of_supply &lt; 7"
                              decoration-warning="days_of_supply &gt;= 7 and days_of_supply &lt; 14">
                            <field name="store_id"/>
                            <field name="product_id"/>
                            <field name="qty_on_hand"/>
                            <field name="avg_daily_sales"/>
                            <field name="days_of_supply"/>
                            <field name="recommended_reorder_qty"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_build" type="object"
                            string="Build Recommendations"
                            class="btn-primary"/>
                    <button name="action_export_csv" type="object"
                            string="Download CSV"
                            class="btn-secondary"
                            invisible="line_count == 0"/>
                    <button special="cancel" string="Close"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_brand_reorder_wizard" model="ir.actions.act_window">
        <field name="name">Brand Reorder Builder</field>
        <field name="res_model">mint.brand.reorder.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
