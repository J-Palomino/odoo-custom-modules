<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="vendor_deal_form" name="Vendor Deal Submission">
        <t t-call="website.layout">
            <div class="container py-5" style="max-width: 720px;">

                <h1 class="mb-2">Submit a Deal</h1>
                <p class="text-muted mb-4">
                    Use this form to submit a promotional deal for review by the Mint marketing team.
                </p>

                <!-- Error Alert -->
                <t t-if="error">
                    <div class="alert alert-danger" role="alert">
                        <t t-esc="error"/>
                    </div>
                </t>

                <!-- Success Alert -->
                <t t-if="success">
                    <div class="alert alert-success" role="alert">
                        <t t-esc="success"/>
                    </div>
                </t>

                <!-- Form (hidden after success) -->
                <t t-if="not success">
                    <form method="POST" action="/promos" class="needs-validation" novalidate="">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <!-- Vendor Info -->
                        <fieldset class="mb-4">
                            <legend class="h5 mb-3">Vendor Information</legend>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="vendor_name">Company / Vendor Name *</label>
                                    <input type="text" class="form-control" id="vendor_name"
                                           name="vendor_name" required=""
                                           t-att-value="form_values.get('vendor_name', '')"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="brand_lookup">Brand</label>
                                    <input type="text" class="form-control" id="brand_lookup"
                                           list="brand_options"
                                           autocomplete="off"
                                           placeholder="Start typing your brand..."
                                           t-att-value="form_values.get('brand_lookup', '')"/>
                                    <input type="hidden" id="brand_id" name="brand_id"
                                           t-att-value="form_values.get('brand_id', '')"/>
                                    <datalist id="brand_options">
                                        <t t-foreach="brands" t-as="b">
                                            <option t-att-value="b['name']" t-att-data-id="b['id']"/>
                                        </t>
                                    </datalist>
                                    <small class="form-text text-muted">
                                        If your brand isn't listed, leave blank — we'll add it during review.
                                    </small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="vendor_email">Email *</label>
                                    <input type="email" class="form-control" id="vendor_email"
                                           name="vendor_email" required=""
                                           t-att-value="form_values.get('vendor_email', '')"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="vendor_contact">Contact Person</label>
                                    <input type="text" class="form-control" id="vendor_contact"
                                           name="vendor_contact"
                                           t-att-value="form_values.get('vendor_contact', '')"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="vendor_phone">Phone</label>
                                    <input type="tel" class="form-control" id="vendor_phone"
                                           name="vendor_phone"
                                           t-att-value="form_values.get('vendor_phone', '')"/>
                                </div>
                            </div>
                        </fieldset>

                        <!-- Deal Details -->
                        <fieldset class="mb-4">
                            <legend class="h5 mb-3">Deal Details</legend>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label" for="deal_name">Deal Name *</label>
                                    <input type="text" class="form-control" id="deal_name"
                                           name="deal_name" required=""
                                           placeholder="e.g. 30% Off All Flower"
                                           t-att-value="form_values.get('deal_name', '')"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="product_category">Product Category</label>
                                    <select class="form-select" id="product_category" name="product_category">
                                        <option value="">-- Select --</option>
                                        <t t-foreach="categories" t-as="cat">
                                            <option t-att-value="cat[0]"
                                                    t-att-selected="form_values.get('product_category') == cat[0]">
                                                <t t-esc="cat[1]"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="product_picker">
                                        Specific Products <span class="text-muted">(optional)</span>
                                    </label>
                                    <input type="text" class="form-control mb-1" id="product_search"
                                           autocomplete="off" disabled="disabled"
                                           placeholder="Select your brand above first…"/>
                                    <select class="form-select" id="product_picker" multiple="multiple"
                                            size="6" disabled="disabled">
                                        <option value="" disabled="disabled">Select your brand above to load its products…</option>
                                    </select>
                                    <input type="hidden" id="product_ids" name="product_ids"
                                           t-att-value="form_values.get('product_ids', '')"/>
                                    <small class="form-text text-muted" id="product_count_hint"></small>
                                    <small class="form-text text-muted">
                                        Leave empty to apply the deal to your whole brand + category.
                                        Pick one or more SKUs to restrict the deal to only those products.
                                    </small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="discount_type">Discount Type</label>
                                    <select class="form-select" id="discount_type" name="discount_type">
                                        <option value="">-- Select --</option>
                                        <t t-foreach="discount_types" t-as="dt">
                                            <option t-att-value="dt[0]"
                                                    t-att-selected="form_values.get('discount_type') == dt[0]">
                                                <t t-esc="dt[1]"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="original_price">MSRP ($)</label>
                                    <input type="number" class="form-control" id="original_price"
                                           name="original_price" step="0.01" min="0"
                                           t-att-value="form_values.get('original_price', '')"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="discount_value">Discount Value</label>
                                    <input type="number" class="form-control" id="discount_value"
                                           name="discount_value" step="0.01" min="0"
                                           placeholder="e.g. 30 for 30%"
                                           t-att-value="form_values.get('discount_value', '')"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="market_id">Market</label>
                                    <select class="form-select" id="market_id" name="market_id">
                                        <option value="">-- Select --</option>
                                        <t t-foreach="markets" t-as="m">
                                            <option t-att-value="m.id"
                                                    t-att-selected="form_values.get('market_id') == str(m.id)">
                                                <t t-esc="m.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="sales_details">Sales Details / Pricing Display</label>
                                    <textarea class="form-control" id="sales_details"
                                              name="sales_details" rows="2"
                                              placeholder="e.g. ~~$50~~ $35 | 30% Off"><t t-esc="form_values.get('sales_details', '')"/></textarea>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="details_exclusions">Details &amp; Exclusions</label>
                                    <textarea class="form-control" id="details_exclusions"
                                              name="details_exclusions" rows="2"
                                              placeholder="Any limits, exclusions, or conditions..."><t t-esc="form_values.get('details_exclusions', '')"/></textarea>
                                </div>
                            </div>
                        </fieldset>

                        <!-- Vendor Funding -->
                        <fieldset class="mb-4">
                            <legend class="h5 mb-3">Vendor Funding</legend>
                            <p class="text-muted small mb-3">
                                Procurement uses this to size the campaign. Funding is the amount
                                the vendor commits to underwrite the promotion. Leave blank if not
                                offering vendor-funded support.
                            </p>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="vendor_funding_amount">
                                        Funding Amount (<t t-esc="currency_symbol"/>)
                                    </label>
                                    <input type="number" class="form-control" id="vendor_funding_amount"
                                           name="vendor_funding_amount" step="0.01" min="0"
                                           placeholder="e.g. 5000"
                                           t-att-value="form_values.get('vendor_funding_amount', '')"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="vendor_funding_percent">
                                        Funding % of Discount
                                    </label>
                                    <input type="number" class="form-control" id="vendor_funding_percent"
                                           name="vendor_funding_percent" step="0.01" min="0" max="100"
                                           placeholder="e.g. 50 for 50%"
                                           t-att-value="form_values.get('vendor_funding_percent', '')"/>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <small class="text-muted">
                                        Either amount or %, or both. Procurement will finalize during review.
                                    </small>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="vendor_funding_terms">
                                        Funding Terms / Notes
                                    </label>
                                    <textarea class="form-control" id="vendor_funding_terms"
                                              name="vendor_funding_terms" rows="2"
                                              placeholder="Payment terms, MOQ, contingencies, etc."><t t-esc="form_values.get('vendor_funding_terms', '')"/></textarea>
                                </div>
                            </div>
                        </fieldset>

                        <!-- Date Preferences -->
                        <fieldset class="mb-4">
                            <legend class="h5 mb-3">Date Preferences</legend>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="preferred_start_date">Start Date</label>
                                    <input type="date" class="form-control" id="preferred_start_date"
                                           name="preferred_start_date"
                                           t-att-value="form_values.get('preferred_start_date', '')"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="preferred_end_date">End Date</label>
                                    <input type="date" class="form-control" id="preferred_end_date"
                                           name="preferred_end_date"
                                           t-att-value="form_values.get('preferred_end_date', '')"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="preferred_days">Preferred Days</label>
                                    <input type="text" class="form-control" id="preferred_days"
                                           name="preferred_days"
                                           placeholder="e.g. Mon, Wed, Fri"
                                           t-att-value="form_values.get('preferred_days', '')"/>
                                </div>
                            </div>
                        </fieldset>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            Submit Deal for Review
                        </button>
                    </form>

                    <!-- Resolve brand_lookup text → brand_id, then load that brand's
                         products into the optional "Specific Products" picker (#93642). -->
                    <script>
                        (function() {
                            var input = document.getElementById('brand_lookup');
                            var hidden = document.getElementById('brand_id');
                            var picker = document.getElementById('product_picker');
                            var prodHidden = document.getElementById('product_ids');
                            var search = document.getElementById('product_search');
                            var hint = document.getElementById('product_count_hint');
                            if (!input || !hidden) return;
                            var options = document.getElementById('brand_options').options;
                            var lastBrandId = null;
                            var selected = {};   // id -> label; persists across searches (#94167)
                            var debounceTimer = null;

                            function resolveBrand() {
                                var v = (input.value || '').trim().toLowerCase();
                                hidden.value = '';
                                if (v) {
                                    for (var i = 0; i &lt; options.length; i++) {
                                        if ((options[i].value || '').trim().toLowerCase() === v) {
                                            hidden.value = options[i].getAttribute('data-id') || '';
                                            break;
                                        }
                                    }
                                }
                                return hidden.value;
                            }

                            function setMsg(text) {
                                if (!picker) return;
                                picker.innerHTML = '';
                                var o = document.createElement('option');
                                o.value = ''; o.disabled = true; o.textContent = text;
                                picker.appendChild(o);
                                picker.disabled = true;
                            }

                            function label(it) {
                                return it.code ? (it.name + ' (' + it.code + ')') : it.name;
                            }

                            // Update `selected` from the currently-visible options (a search
                            // only shows a page, so only touch what's on screen), then write
                            // the hidden field from the full selected set.
                            function syncSelected() {
                                if (!picker || !prodHidden) return;
                                for (var i = 0; i &lt; picker.options.length; i++) {
                                    var op = picker.options[i];
                                    if (!op.value) continue;
                                    if (op.selected) selected[op.value] = op.textContent;
                                    else delete selected[op.value];
                                }
                                prodHidden.value = Object.keys(selected).join(',');
                            }

                            // Render selected-but-unlisted picks first so a search never drops
                            // an earlier selection, then the search/page results.
                            function render(items, total, term) {
                                picker.innerHTML = '';
                                var byId = {};
                                items.forEach(function(it) { byId[String(it.id)] = label(it); });
                                Object.keys(selected).forEach(function(id) { if (byId[id]) selected[id] = byId[id]; });
                                var shown = {};
                                Object.keys(selected).forEach(function(id) {
                                    var o = document.createElement('option');
                                    o.value = id; o.textContent = selected[id]; o.selected = true;
                                    picker.appendChild(o); shown[id] = true;
                                });
                                items.forEach(function(it) {
                                    if (shown[String(it.id)]) return;
                                    var o = document.createElement('option');
                                    o.value = it.id; o.textContent = label(it);
                                    picker.appendChild(o);
                                });
                                picker.disabled = false;
                                if (hint) {
                                    if (term) hint.textContent = 'Showing ' + items.length + ' match(es) of ' + total + ' in this brand.';
                                    else if (total &gt; items.length) hint.textContent = 'Showing first ' + items.length + ' of ' + total + ' — type to search the rest.';
                                    else hint.textContent = 'Showing all ' + total + ' products.';
                                }
                            }

                            function fetchProducts(brandId, term) {
                                var url = '/promos/brand-products?brand_id=' + encodeURIComponent(brandId);
                                if (term) url += '&amp;q=' + encodeURIComponent(term);
                                var total = 0;
                                fetch(url)
                                    .then(function(r) {
                                        total = parseInt(r.headers.get('X-Total-Count') || '0', 10) || 0;
                                        return r.json();
                                    })
                                    .then(function(items) {
                                        if (!items.length &amp;&amp; !Object.keys(selected).length) {
                                            setMsg(term ? 'No matches — try a different search.'
                                                        : 'No products on file for this brand — leave empty.');
                                            if (hint) hint.textContent = '';
                                            return;
                                        }
                                        render(items, total, term);
                                    })
                                    .catch(function() { setMsg('Could not load products — leave empty.'); });
                            }

                            function loadProducts(brandId) {
                                if (!picker) return;
                                if (!brandId) {
                                    setMsg('Select your brand above to load its products…');
                                    if (prodHidden) prodHidden.value = '';
                                    selected = {};
                                    if (search) { search.value = ''; search.disabled = true; search.placeholder = 'Select your brand above first…'; }
                                    if (hint) hint.textContent = '';
                                    lastBrandId = null;
                                    return;
                                }
                                if (brandId === lastBrandId) return;
                                lastBrandId = brandId;
                                // Seed selection from the hidden field (POST re-render); real
                                // labels get filled in by render() once the products load.
                                selected = {};
                                if (prodHidden &amp;&amp; prodHidden.value) {
                                    prodHidden.value.split(',').forEach(function(id) { if (id) selected[id] = id; });
                                }
                                if (search) { search.disabled = false; search.value = ''; search.placeholder = "Type to search this brand's products..."; }
                                fetchProducts(brandId, '');
                            }

                            function onBrand() { loadProducts(resolveBrand()); }

                            input.addEventListener('change', onBrand);
                            input.addEventListener('blur', onBrand);
                            if (picker) picker.addEventListener('change', syncSelected);
                            if (search) search.addEventListener('input', function() {
                                var term = (search.value || '').trim();
                                if (debounceTimer) clearTimeout(debounceTimer);
                                if (term.length === 1) return;   // wait for >= 2 chars
                                debounceTimer = setTimeout(function() {
                                    if (hidden.value) fetchProducts(hidden.value, term);
                                }, 250);
                            });
                            input.form &amp;&amp; input.form.addEventListener('submit', function() {
                                resolveBrand(); syncSelected();
                            });

                            // POST re-render: if a brand is already chosen, repopulate + re-select.
                            if (hidden.value) { loadProducts(hidden.value); }
                        })();
                    </script>
                </t>

            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- /promos — Market selection (public / not-logged-in vendors)   -->
    <!-- ============================================================ -->
    <template id="promos_market_select" name="Promos — Select Market">
        <t t-call="website.layout">
            <div class="container py-5">

                <div class="text-center mb-5">
                    <h1 class="mb-2">Run a Promo with Mint</h1>
                    <p class="text-muted">
                        Select your market to submit a deal for review by the Mint marketing team.
                        Already a partner? <a href="/web/login?redirect=/promos">Log in</a> to view your promo calendar.
                    </p>
                </div>

                <t t-if="not markets">
                    <div class="alert alert-info text-center">
                        No markets are available yet. Please check back soon.
                    </div>
                </t>

                <div class="row g-4">
                    <t t-foreach="markets" t-as="m">
                        <div class="col-12 col-sm-6 col-lg-4">
                            <a t-attf-href="/vendor-deals?market_id=#{m.id}"
                               class="card h-100 text-decoration-none text-reset shadow-sm border-0 promo-market-card">
                                <t t-if="m.hero_image_url">
                                    <img t-att-src="m.hero_image_url" class="card-img-top"
                                         style="height: 160px; object-fit: cover;"
                                         t-att-alt="m.name"/>
                                </t>
                                <t t-else="">
                                    <div class="card-img-top d-flex align-items-center justify-content-center bg-light"
                                         style="height: 160px;">
                                        <span class="display-6 text-muted"><t t-esc="m.name[:2].upper()"/></span>
                                    </div>
                                </t>
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <span class="h5 mb-0"><t t-esc="m.name"/></span>
                                    <span class="badge text-bg-secondary" t-if="m.store_count">
                                        <t t-esc="m.store_count"/> stores
                                    </span>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>

            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- /promos — Active promos calendar (logged-in vendors)         -->
    <!-- ============================================================ -->
    <template id="promos_calendar" name="Promos — My Calendar">
        <t t-call="website.layout">
            <div class="container py-5">

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                    <div>
                        <h1 class="mb-1">My Promo Calendar</h1>
                        <p class="text-muted mb-0"><t t-esc="brand_names"/></p>
                    </div>
                    <a href="/vendor-deals" class="btn btn-primary">+ Submit a Deal</a>
                </div>

                <!-- Month nav -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <a t-attf-href="/promos?month=#{prev_month}" class="btn btn-outline-secondary btn-sm">&#8592; Prev</a>
                    <h4 class="mb-0"><t t-esc="month_label"/></h4>
                    <a t-attf-href="/promos?month=#{next_month}" class="btn btn-outline-secondary btn-sm">Next &#8594;</a>
                </div>

                <t t-if="entry_count == 0">
                    <div class="alert alert-info">
                        No promos scheduled for <t t-esc="month_label"/>.
                        <a href="/vendor-deals">Submit a deal</a> to get on the calendar.
                    </div>
                </t>

                <div class="table-responsive">
                    <table class="table table-bordered text-center align-top mb-0" style="table-layout: fixed;">
                        <thead>
                            <tr>
                                <t t-foreach="weekday_labels" t-as="wl">
                                    <th class="bg-light text-muted small"><t t-esc="wl"/></th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="weeks" t-as="week">
                                <tr>
                                    <t t-foreach="week" t-as="cell">
                                        <td t-att-class="'p-1 ' + ('' if cell['in_month'] else 'bg-light text-muted')"
                                            style="height: 110px; vertical-align: top;">
                                            <div t-att-class="'small fw-bold mb-1 ' + ('text-success' if cell['is_today'] else '')">
                                                <t t-esc="cell['day']"/>
                                            </div>
                                            <t t-foreach="cell['entries']" t-as="e">
                                                <div t-att-class="'badge w-100 text-truncate mb-1 ' + {
                                                        'tentative': 'text-bg-secondary',
                                                        'confirmed': 'text-bg-info',
                                                        'approved': 'text-bg-primary',
                                                        'published': 'text-bg-success',
                                                     }.get(e.state, 'text-bg-light')"
                                                     style="display: block; text-align: left;"
                                                     t-att-title="(e.deal_id.name or e.brand_id.name or '') + ' — ' + (e.market_id.name or '')">
                                                    <t t-esc="e.deal_id.name or e.brand_id.name or e.slot_type"/>
                                                </div>
                                            </t>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 small text-muted d-flex flex-wrap gap-3">
                    <span><span class="badge text-bg-secondary">&#160;</span> Tentative</span>
                    <span><span class="badge text-bg-info">&#160;</span> Confirmed</span>
                    <span><span class="badge text-bg-primary">&#160;</span> Approved</span>
                    <span><span class="badge text-bg-success">&#160;</span> Published</span>
                </div>

            </div>
        </t>
    </template>

</odoo>
