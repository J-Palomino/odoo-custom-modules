<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==================== Deal Submission Views ==================== -->

    <!-- Form View -->
    <record id="view_deal_submission_form" model="ir.ui.view">
        <field name="name">mint.deal.submission.form</field>
        <field name="model">mint.deal.submission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_review" string="Start Review"
                            type="object" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="btn-primary"
                            invisible="state not in ('new', 'under_review')"/>
                    <button name="action_reject" string="Reject"
                            type="object" class="btn-danger"
                            invisible="state not in ('new', 'under_review')"/>
                    <button name="action_convert_to_deal" string="Schedule (Convert to PTL Deal)"
                            type="object" class="btn-success"
                            invisible="state != 'approved'"
                            confirm="This will create a PTL Deal from this submission and schedule it to go live. Continue?"/>
                    <button name="action_force_approve_and_plot"
                            string="Force Approve &amp; Plot"
                            type="object" class="btn-warning"
                            invisible="state != 'approved'"
                            groups="mint_command_center.group_ptl_manager"/>
                    <button name="action_to_final_review" string="Move to Final Review"
                            type="object" class="btn-primary"
                            invisible="state != 'scheduled'"/>
                    <button name="action_expire" string="Mark Expired"
                            type="object" class="btn-secondary"
                            invisible="state not in ('scheduled', 'final_review')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,under_review,approved,scheduled,final_review,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Deal Name"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'rejected'">
                        <strong>Rejected:</strong>
                        <field name="rejection_reason" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="state not in ('scheduled', 'final_review', 'expired')">
                        <strong>Scheduled — PTL Deal:</strong>
                        <field name="deal_id" nolabel="1" readonly="1"/>
                        <span> · runs through </span>
                        <field name="run_end_date" nolabel="1" readonly="1"
                               placeholder="open-ended"/>
                    </div>
                    <group>
                        <group string="Deal Details">
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="original_price" invisible="1"/>
                        </group>
                    </group>
                    <group string="Targeting">
                        <group>
                            <field name="market_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="store_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vendor Details" name="vendor_details">
                            <group>
                                <field name="vendor_name"/>
                                <field name="brand_id" options="{'no_create': True}"/>
                                <field name="vendor_email" widget="email"/>
                                <field name="vendor_contact"/>
                                <field name="vendor_phone" widget="phone"/>
                                <field name="crm_lead_id" options="{'no_create': True}"/>
                                <field name="campaign_id" options="{'no_create': True}"/>
                            </group>
                            <group string="Vendor Funding">
                                <group>
                                    <field name="vendor_funding_amount" widget="monetary"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="vendor_funding_percent"/>
                                </group>
                                <group>
                                    <field name="vendor_funding_terms" placeholder="Payment terms, MOQ, etc."/>
                                </group>
                            </group>
                        </page>
                        <page string="Schedule" name="schedule">
                            <group>
                                <field name="windows_summary" readonly="1"/>
                            </group>
                            <!-- The inner <list> is NOT rendered (the
                                 ptl_day_grid widget owns the DOM);
                                 it exists so date_start/date_end/sequence are
                                 ACTIVE fields. Without it the children load via
                                 the widget's relatedFields for display only,
                                 record.update() never tracks them into
                                 _changes, and web_save emits empty create
                                 commands ([0, virtual, {}]) → the server
                                 rejects with "Missing required value for
                                 'Start Date'". -->
                            <field name="window_ids"
                                   widget="ptl_day_grid"
                                   nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="day_count" readonly="1"/>
                                </list>
                            </field>
                            <group string="Legacy vendor preferences (read-only)"
                                   class="o_mdcc_legacy_prefs">
                                <field name="preferred_start_date" readonly="1"/>
                                <field name="preferred_end_date" readonly="1"/>
                                <field name="preferred_days" readonly="1"/>
                            </group>
                        </page>
                        <page string="Inclusions" name="inclusions">
                            <group>
                                <field name="product_category"/>
                            </group>
                            <group string="Specific Products (optional — overrides brand-wide matching)" col="1">
                                <field name="product_ids"
                                       nolabel="1"
                                       widget="many2many_tags"
                                       domain="[('brand_id','=',brand_id)]"
                                       options="{'no_create': True, 'no_create_edit': True}"
                                       invisible="not brand_id"
                                       placeholder="Pick specific products to restrict the deal. Leave empty for all of brand+category."/>
                            </group>
                            <group string="Sales Details" col="1">
                                <field name="sales_details" nolabel="1"
                                       placeholder="Auto-fills from Discount Type (e.g. 40% Off, $10, BOGO). Edit for custom wording / bundles."
                                       help="Auto-generated from the Discount Type + value when left blank. Edit freely for bundles, multi-buy, or any custom wording."/>
                            </group>
                        </page>
                        <page string="Exclusions" name="exclusions">
                            <group string="Exclusion Rules">
                                <field name="excluded_brand_ids" widget="many2many_tags"
                                       options="{'no_create_edit': True}"
                                       placeholder="Brands to exclude from this deal"/>
                                <field name="excluded_skus"
                                       placeholder="One SKU per line, or comma-separated&#10;e.g. STZ-001, STZ-002"/>
                            </group>
                            <group string="Details &amp; Exclusions Notes" col="1">
                                <field name="details_exclusions" nolabel="1"
                                       placeholder="Product exclusions and conditions..."/>
                            </group>
                        </page>
                        <page string="Review" name="review" invisible="not reviewed_by">
                            <group>
                                <group>
                                    <field name="reviewed_by"/>
                                    <field name="reviewed_at"/>
                                </group>
                                <group>
                                    <field name="reviewer_notes"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_deal_submission_list" model="ir.ui.view">
        <field name="name">mint.deal.submission.list</field>
        <field name="model">mint.deal.submission</field>
        <field name="arch" type="xml">
            <list string="Deal Submissions"
                  decoration-info="state == 'new'"
                  decoration-warning="state in ('under_review', 'final_review')"
                  decoration-primary="state == 'approved'"
                  decoration-success="state == 'scheduled'"
                  decoration-muted="state == 'expired'"
                  decoration-danger="state == 'rejected'">
                <field name="create_date" string="Submitted"/>
                <field name="vendor_name"/>
                <field name="name"/>
                <field name="product_category"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="market_id"/>
                <field name="run_end_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state in ('under_review', 'final_review')"
                       decoration-primary="state == 'approved'"
                       decoration-success="state == 'scheduled'"
                       decoration-muted="state == 'expired'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Kanban View (review board) -->
    <record id="view_deal_submission_kanban" model="ir.ui.view">
        <field name="name">mint.deal.submission.kanban</field>
        <field name="model">mint.deal.submission</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="vendor_name"/>
                <field name="name"/>
                <field name="product_category"/>
                <field name="market_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="vendor_name" class="text-muted"/>
                        <div class="d-flex justify-content-between">
                            <field name="product_category"/>
                            <field name="market_id"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_deal_submission_search" model="ir.ui.view">
        <field name="name">mint.deal.submission.search</field>
        <field name="model">mint.deal.submission</field>
        <field name="arch" type="xml">
            <search string="Search Submissions">
                <field name="name"/>
                <field name="vendor_name"/>
                <field name="brand_id"/>
                <field name="market_id"/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="under_review" string="Under Review" domain="[('state', '=', 'under_review')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter name="final_review" string="Final Review" domain="[('state', '=', 'final_review')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_market" string="Market" context="{'group_by': 'market_id'}"/>
                <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_name'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_deal_submission" model="ir.actions.act_window">
        <field name="name">Deal Submissions</field>
        <field name="res_model">mint.deal.submission</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_deal_submission_search"/>
        <field name="context">{'search_default_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No deal submissions yet
            </p>
            <p>
                Vendors land on /promos (market picker or, when logged in, their promo calendar)
                and submit deals via the /vendor-deals form.
                Review, approve, and convert submissions into PTL Deals.
            </p>
        </field>
    </record>

</odoo>
