<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_force_approve_wizard_form" model="ir.ui.view">
        <field name="name">mint.deal.force.approve.wizard.form</field>
        <field name="model">mint.deal.force.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Force Approve &amp; Plot">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Override the campaign-approval gate.</strong>
                        Use this when the parent National Promo Campaign isn't
                        approved yet but the deal needs to plot right now (vendor
                        pre-pay, time-sensitive promo, fixing an over-revoke).
                        Your reason is written to chatter on both the submission
                        and the campaign for audit.
                    </div>
                    <group>
                        <group>
                            <field name="submission_id" readonly="1"/>
                            <field name="campaign_id" readonly="1"
                                   options="{'no_open': True}"/>
                            <field name="campaign_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="also_approve_campaign"/>
                        </group>
                    </group>
                    <separator string="Override Reason (required, audit-logged)"/>
                    <field name="reason" nolabel="1"
                           placeholder="Required. Will be written to chatter on both the submission and the campaign."/>
                </sheet>
                <footer>
                    <button name="action_apply" type="object"
                            string="Force Approve &amp; Plot"
                            class="btn-danger"
                            confirm="This will bypass the campaign-approval gate and create a PTL Deal. The reason will be permanent in chatter. Continue?"/>
                    <button special="cancel" string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
