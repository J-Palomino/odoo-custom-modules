<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="view_national_promo_list" model="ir.ui.view">
        <field name="name">mint.national.promo.list</field>
        <field name="model">mint.national.promo</field>
        <field name="arch" type="xml">
            <list string="National Promo Campaigns" decoration-success="state == 'active'"
                  decoration-muted="state == 'closed'" decoration-info="state == 'approved'">
                <field name="brand_id"/>
                <field name="market_id"/>
                <field name="year"/>
                <field name="contact_status"/>
                <field name="state"/>
                <field name="entry_count"/>
                <field name="submission_count"/>
                <field name="vendor_funding_total" widget="monetary"/>
                <field name="vendor_funding_currency_id" column_invisible="True"/>
                <field name="ready_to_plot" widget="boolean_toggle"/>
                <field name="plotted" widget="boolean_toggle"/>
                <field name="crm_lead_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban grouped by state -->
    <record id="view_national_promo_kanban" model="ir.ui.view">
        <field name="name">mint.national.promo.kanban</field>
        <field name="model">mint.national.promo</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="brand_id"/>
                <field name="market_id"/>
                <field name="year"/>
                <field name="contact_status"/>
                <field name="entry_count"/>
                <field name="vendor_funding_total"/>
                <field name="vendor_funding_currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="brand_id"/>
                                    </strong>
                                    <span class="o_kanban_record_subtitle">
                                        <field name="market_id"/> · <field name="year"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="badge badge-pill">
                                    <field name="contact_status"/>
                                </span>
                                <div class="mt-1">
                                    Entries: <field name="entry_count"/>
                                </div>
                                <div t-if="record.vendor_funding_total.raw_value">
                                    Funding:
                                    <field name="vendor_funding_total" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pivot: brand × month of entries -->
    <record id="view_national_promo_pivot" model="ir.ui.view">
        <field name="name">mint.national.promo.pivot</field>
        <field name="model">mint.national.promo</field>
        <field name="arch" type="xml">
            <pivot string="Promo Campaigns Pivot">
                <field name="brand_id" type="row"/>
                <field name="market_id" type="row"/>
                <field name="year" type="col"/>
                <field name="entry_count" type="measure"/>
                <field name="vendor_funding_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_national_promo_form" model="ir.ui.view">
        <field name="name">mint.national.promo.form</field>
        <field name="model">mint.national.promo</field>
        <field name="arch" type="xml">
            <form string="National Promo Campaign">
                <header>
                    <button name="action_start_planning" string="Plan"
                            type="object" invisible="state == 'planning'"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="btn-primary"
                            invisible="state != 'planning'"/>
                    <button name="action_activate" string="Activate"
                            type="object" class="btn-primary"
                            invisible="state not in ('planning','approved')"/>
                    <button name="action_close" string="Close"
                            type="object" invisible="state == 'closed'"/>
                    <button name="action_create_lead" string="Create CRM Lead"
                            type="object" invisible="crm_lead_id"/>
                    <button name="action_open_lead" string="Open CRM Lead"
                            type="object" invisible="not crm_lead_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planning,approved,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="brand_id"/>
                            <field name="market_id"/>
                            <field name="year"/>
                            <field name="crm_lead_id"/>
                        </group>
                        <group>
                            <field name="contact_status"/>
                            <field name="ready_to_plot"/>
                            <field name="plotted"/>
                            <field name="source_file" readonly="1"
                                   invisible="not source_file"/>
                        </group>
                    </group>
                    <group string="Vendor Funding">
                        <field name="vendor_funding_total" widget="monetary"/>
                        <field name="vendor_funding_currency_id"/>
                        <field name="vendor_funding_terms"/>
                    </group>
                    <notebook>
                        <page string="Entries" name="entries">
                            <field name="entry_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="sku_or_category"/>
                                    <field name="promo_text"/>
                                    <field name="discount_type"/>
                                    <field name="discount_value"/>
                                    <field name="state"/>
                                    <field name="is_published"/>
                                </list>
                            </field>
                        </page>
                        <page string="Submissions" name="submissions">
                            <field name="submission_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="vendor_name"/>
                                    <field name="discount_type"/>
                                    <field name="discount_value"/>
                                    <field name="vendor_funding_amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_national_promo_search" model="ir.ui.view">
        <field name="name">mint.national.promo.search</field>
        <field name="model">mint.national.promo</field>
        <field name="arch" type="xml">
            <search string="National Promos">
                <field name="brand_id"/>
                <field name="market_id"/>
                <field name="year"/>
                <field name="crm_lead_id"/>
                <filter name="planning" string="Planning"
                        domain="[('state','=','planning')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state','=','approved')]"/>
                <filter name="active" string="Active"
                        domain="[('state','=','active')]"/>
                <filter name="ready_to_plot" string="Ready to Plot"
                        domain="[('ready_to_plot','=',True)]"/>
                <filter name="plotted" string="Plotted"
                        domain="[('plotted','=',True)]"/>
                <filter name="not_plotted" string="Not Plotted"
                        domain="[('plotted','=',False)]"/>
                <filter name="group_brand" string="Brand"
                        context="{'group_by': 'brand_id'}"/>
                <filter name="group_market" string="Market"
                        context="{'group_by': 'market_id'}"/>
                <filter name="group_year" string="Year"
                        context="{'group_by': 'year'}"/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                <filter name="group_contact" string="Outreach Status"
                        context="{'group_by': 'contact_status'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_national_promo" model="ir.actions.act_window">
        <field name="name">Promo Campaigns</field>
        <field name="res_model">mint.national.promo</field>
        <field name="view_mode">kanban,list,pivot,form</field>
        <field name="search_view_id" ref="view_national_promo_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start tracking national promo campaigns.
            </p>
            <p>
                One campaign per brand × market × year. Links vendor CRM
                leads, deal submissions, and daily calendar entries into
                a single funded-promo ledger.
            </p>
        </field>
    </record>

</odoo>
