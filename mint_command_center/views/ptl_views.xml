<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==================== PTL Day Views ==================== -->

    <!-- PTL Day: Form View -->
    <record id="view_ptl_day_form" model="ir.ui.view">
        <field name="name">mint.ptl.day.form</field>
        <field name="model">mint.ptl.day</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish"
                            string="Publish to Frontend"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'published'"
                            confirm="This will sync all deals to the live website. Continue?"/>
                    <button name="action_unpublish"
                            string="Unpublish"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'published'"
                            confirm="This will pull this day's deals from the live website. Deals shared with other published days are kept alive for those days. Continue?"/>
                    <button name="action_open_stock_check"
                            string="Check Stock"
                            type="object"
                            class="btn-secondary"
                            invisible="deal_count == 0"/>
                    <button name="action_open_text_deals_wizard"
                            string="Export Text Deals"
                            type="object"
                            class="btn-secondary"
                            invisible="deal_count == 0"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="PTL Day Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="market_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="deal_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Deals" name="deals">
                            <field name="deal_ids" widget="many2many">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="product_category"/>
                                    <field name="sale_type"/>
                                    <field name="discount_type"/>
                                    <field name="discount_value"/>
                                    <field name="display_text"/>
                                    <field name="stock_status"
                                           decoration-success="stock_status == 'in_stock'"
                                           decoration-warning="stock_status == 'low_stock'"
                                           decoration-danger="stock_status == 'out_of_stock'"
                                           widget="badge"/>
                                    <field name="is_featured"/>
                                    <field name="state"
                                           decoration-warning="state == 'pending'"
                                           decoration-success="state == 'live'"
                                           decoration-danger="state == 'rejected'"
                                           decoration-muted="state == 'expired'"
                                           widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- PTL Day: List View -->
    <record id="view_ptl_day_list" model="ir.ui.view">
        <field name="name">mint.ptl.day.list</field>
        <field name="model">mint.ptl.day</field>
        <field name="arch" type="xml">
            <list string="PTL Calendar"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'published'">
                <field name="date"/>
                <field name="market_id" optional="show"/>
                <field name="deal_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- PTL Day: Calendar View -->
    <record id="view_ptl_day_calendar" model="ir.ui.view">
        <field name="name">mint.ptl.day.calendar</field>
        <field name="model">mint.ptl.day</field>
        <field name="arch" type="xml">
            <calendar string="PTL Calendar"
                      date_start="date"
                      color="state"
                      quick_create="0"
                      js_class="ptl_calendar">
                <field name="deal_count"/>
                <field name="market_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- PTL Day: Kanban View -->
    <record id="view_ptl_day_kanban" model="ir.ui.view">
        <field name="name">mint.ptl.day.kanban</field>
        <field name="model">mint.ptl.day</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="date"/>
                <field name="market_id"/>
                <field name="deal_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="date"/>
                        <field name="market_id"/>
                        <div>
                            <field name="deal_count"/> deals
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- PTL Day: Search View -->
    <record id="view_ptl_day_search" model="ir.ui.view">
        <field name="name">mint.ptl.day.search</field>
        <field name="model">mint.ptl.day</field>
        <field name="arch" type="xml">
            <search string="Search PTL Days">
                <field name="name"/>
                <field name="date"/>
                <field name="market_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('date', '=', context_today())]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'date:week'}"/>
                <filter name="group_market" string="Market" context="{'group_by': 'market_id'}"/>
            </search>
        </field>
    </record>

    <!-- PTL Day: Action -->
    <record id="action_ptl_day" model="ir.actions.act_window">
        <field name="name">PTL Calendar</field>
        <field name="res_model">mint.ptl.day</field>
        <field name="view_mode">list,calendar,kanban,form</field>
        <field name="search_view_id" ref="view_ptl_day_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first PTL Day
            </p>
            <p>
                PTL Days define the promotional lineup for a given date.
                Deals are shared templates — add them to multiple days.
            </p>
        </field>
    </record>

    <!-- ==================== PTL Deal Views ==================== -->

    <!-- PTL Deal: Form View -->
    <record id="view_ptl_deal_form" model="ir.ui.view">
        <field name="name">mint.ptl.deal.form</field>
        <field name="model">mint.ptl.deal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve"
                            type="object" class="btn-primary"
                            invisible="state not in ('pending', 'rejected')"/>
                    <button name="action_reject" string="Reject"
                            type="object" class="btn-danger"
                            invisible="state != 'pending'"/>
                    <button name="action_set_live" string="Set Live"
                            type="object" class="btn-success"
                            invisible="state != 'approved'"/>
                    <button name="action_expire" string="Expire"
                            type="object"
                            invisible="state not in ('approved', 'live')"/>
                    <button name="action_reset_to_pending" string="Reset to Pending"
                            type="object"
                            invisible="state not in ('rejected', 'expired')"/>
                    <button name="action_open_revoke_wizard"
                            string="Revoke"
                            type="object" class="btn-danger"
                            invisible="state == 'pending'"
                            groups="mint_command_center.group_ptl_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,live"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_days" icon="fa-calendar"
                                invisible="day_count == 0">
                            <field name="day_count" widget="statinfo" string="Days"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Deal Name"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'rejected'">
                        <strong>Rejected:</strong>
                        <field name="rejection_reason" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="stock_status != 'out_of_stock'">
                        <strong>OUT OF STOCK</strong> — Do not create graphics for this deal.
                    </div>
                    <group>
                        <group>
                            <field name="market_id" options="{'no_create': True}"/>
                            <field name="pricing_tier"
                                   invisible="not market_id"/>
                        </group>
                        <group>
                            <field name="sale_type"/>
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="original_price"/>
                            <field name="display_text" readonly="1"/>
                            <field name="format_key" readonly="1"
                                   help="Blank until the matching product has a Product Line set"/>
                            <label for="weight_value" string="Weight"/>
                            <div class="o_row">
                                <field name="weight_value" nolabel="1"/>
                                <field name="weight_unit" nolabel="1"/>
                            </div>
                            <field name="is_featured"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group string="Validity">
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="date_range_label" readonly="1"/>
                            <field name="is_active_today" widget="boolean_toggle" readonly="1"/>
                        </group>
                    </group>
                    <group string="Availability">
                        <field name="store_ids" widget="many2many_tags"
                               domain="[('is_dispensary','=',True),('dutchie_store_id','!=',False)]"
                               options="{'no_create': True}"
                               placeholder="All stores (leave empty for all)"/>
                        <field name="day_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <group string="Stock Status" invisible="stock_status == 'unchecked'">
                        <group>
                            <field name="stock_status" widget="badge"
                                   decoration-success="stock_status == 'in_stock'"
                                   decoration-warning="stock_status == 'low_stock'"
                                   decoration-danger="stock_status == 'out_of_stock'"/>
                            <field name="stock_checked_at"/>
                        </group>
                        <group>
                            <field name="stock_locations_in"/>
                            <field name="stock_locations_total"/>
                        </group>
                    </group>
                    <group string="Review" invisible="not reviewed_by">
                        <field name="reviewed_by"/>
                        <field name="reviewed_at"/>
                        <field name="submitted_by"/>
                        <field name="submitted_at"/>
                    </group>
                    <group string="Description" invisible="not description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Included" name="included">
                            <group>
                                <field name="brand_id"
                                       domain="[('product_count','&gt;',0)]"
                                       options="{'no_create': True}"/>
                                <field name="product_category"/>
                            </group>
                            <group string="Sales Details" col="1">
                                <field name="sales_details" nolabel="1"
                                       placeholder="Formatted pricing (e.g. $45 $22.50 Each When you buy 2)"/>
                            </group>
                            <group string="Explicit Products (overrides brand-wide matching when populated)" col="1">
                                <field name="explicit_product_ids"
                                       nolabel="1"
                                       readonly="1"
                                       widget="many2many_tags"/>
                            </group>
                            <group string="Matching SKUs (resolved from brand + category, or explicit set above)" col="1">
                                <field name="matching_product_count" readonly="1"/>
                                <field name="matching_product_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="default_code" string="SKU"/>
                                        <field name="name"/>
                                        <field name="x_display_label_override"
                                               string="Budtender Label"
                                               optional="show"/>
                                        <field name="categ_id"/>
                                        <field name="list_price"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Excluded" name="excluded">
                            <group string="Exclusion Rules">
                                <field name="excluded_brand_ids" widget="many2many_tags"
                                       domain="[('product_count','&gt;',0)]"
                                       options="{'no_create_edit': True}"
                                       placeholder="Brands to exclude from this deal"/>
                                <field name="excluded_skus"
                                       placeholder="One SKU per line, or comma-separated&#10;e.g. STZ-001, STZ-002&#10;CRT-PINEAPPLE"/>
                            </group>
                            <group string="Details &amp; Exclusions" col="1">
                                <field name="details_exclusions" nolabel="1"
                                       placeholder="Product exclusions and conditions..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- PTL Deal: List View -->
    <record id="view_ptl_deal_list" model="ir.ui.view">
        <field name="name">mint.ptl.deal.list</field>
        <field name="model">mint.ptl.deal</field>
        <field name="arch" type="xml">
            <list string="PTL Deals"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'live'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'expired'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="brand_id" optional="show"/>
                <field name="product_category"/>
                <field name="market_id" optional="show"/>
                <field name="sale_type"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="display_text" optional="show"/>
                <field name="date_start" optional="show"/>
                <field name="date_end" optional="show"/>
                <field name="is_active_today" widget="boolean_toggle" optional="hide" readonly="1"/>
                <field name="stock_status" widget="badge" optional="hide"
                       decoration-success="stock_status == 'in_stock'"
                       decoration-warning="stock_status == 'low_stock'"
                       decoration-danger="stock_status == 'out_of_stock'"/>
                <field name="day_count"/>
                <field name="is_featured"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'live'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'expired'"/>
            </list>
        </field>
    </record>

    <!-- PTL Deal: Search View -->
    <record id="view_ptl_deal_search" model="ir.ui.view">
        <field name="name">mint.ptl.deal.search</field>
        <field name="model">mint.ptl.deal</field>
        <field name="arch" type="xml">
            <search string="Search PTL Deals">
                <field name="name"/>
                <field name="brand_id"/>
                <field name="product_category"/>
                <field name="market_id"/>
                <filter name="featured" string="Featured" domain="[('is_featured', '=', True)]"/>
                <separator/>
                <filter name="edlp" string="EDLP" domain="[('sale_type', '=', 'edlp')]"/>
                <filter name="weekly_bundle" string="Weekly Bundle" domain="[('sale_type', '=', 'weekly_bundle')]"/>
                <filter name="special_offer" string="Special Offer" domain="[('sale_type', '=', 'special_offer')]"/>
                <separator/>
                <filter name="points_multiplier" string="Loyalty Points Multiplier"
                        domain="[('discount_type', '=', 'points_multiplier')]"/>
                <filter name="clearance" string="Clearance"
                        domain="[('discount_type', '=', 'clearance')]"/>
                <separator/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="live" string="Live" domain="[('state', '=', 'live')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter name="in_stock" string="In Stock" domain="[('stock_status', '=', 'in_stock')]"/>
                <filter name="out_of_stock" string="Out of Stock" domain="[('stock_status', '=', 'out_of_stock')]"/>
                <separator/>
                <filter name="active_today" string="Active Today" domain="[('is_active_today', '=', True)]"/>
                <filter name="missing_dates" string="Missing Date Range"
                        domain="['|', ('date_start', '=', False), ('date_end', '=', False)]"/>
                <filter name="ending_this_week" string="Ending This Week"
                        domain="[('date_end', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('date_end', '&lt;=', (context_today()+relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_brand" string="Brand" context="{'group_by': 'brand_id'}"/>
                <filter name="group_category" string="Category" context="{'group_by': 'product_category'}"/>
                <filter name="group_sale_type" string="Sale Type" context="{'group_by': 'sale_type'}"/>
                <filter name="group_market" string="Market" context="{'group_by': 'market_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- PTL Deal: Action (standalone catalog) -->
    <record id="action_ptl_deal" model="ir.actions.act_window">
        <field name="name">National Promo Log</field>
        <field name="res_model">mint.ptl.deal</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ptl_deal_search"/>
    </record>

    <!-- PTL Deal: Review Queue Action (filtered to pending) -->
    <record id="action_ptl_deal_review_queue" model="ir.actions.act_window">
        <field name="name">Review Queue</field>
        <field name="res_model">mint.ptl.deal</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ptl_deal_search"/>
        <field name="domain">[('state', '=', 'pending')]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No deals pending review
            </p>
            <p>
                Deals submitted by vendors or created internally appear here
                until they are approved or rejected.
            </p>
        </field>
    </record>

</odoo>
