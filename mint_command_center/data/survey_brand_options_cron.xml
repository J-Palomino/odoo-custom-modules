<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Keeps survey choice questions flagged "Options from Brand Catalog"
             (the sample-review "Brand Name" question) in step with the brands
             that have an employee-sample SKU in the catalog. -->
        <record id="cron_sync_survey_brand_options" model="ir.cron">
            <field name="name">Mint: Sync survey brand options from catalog</field>
            <field name="model_id" ref="survey.model_survey_question"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_mint_brand_options()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
