<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Daily cancel-stale-orders cron.

            Targets mint.pos.order rows that are still in an active swimlane
            state (lobby / sales_floor / pickup / processing / online_orders
            / etc.) but were created more than 24 hours ago. These are
            abandoned customers — Dutchie left them in the lane and they
            never actually rang at the register. Without this cron they
            accumulate forever on the kanban as $0 / 0-item ghost cards.

            Scheduled at 10:00 UTC daily ≈ 3am MST (Mint AZ headquarters
            timezone). Other LSPs (MI/MO/IL/NV/FL) run between 3am and 6am
            local — well after close, well before open.

            See models/pos_order.py::_cron_cancel_stale_orders for logic.
        -->
        <record id="cron_cancel_stale_orders" model="ir.cron">
            <field name="name">Mint POS: cancel stale active-lane orders (>24h)</field>
            <field name="model_id" ref="model_mint_pos_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_cancel_stale_orders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=10, minute=0, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!--
            Nightly partner dedupe (Phase 6, issue #278).

            Reconciles walk-in stub partners with full records:
              - exactly one non-stub strong-key match: auto-merge
              - 2+ strong, or weak-only matches: flag Needs Merge Review
            Plus a flag-only sweep for non-stub duplicate clusters on
            loyalty id / identity key.

            SHIPS IN DRY-RUN: set ir.config_parameter
            mint_pos_bridge.partner_merge_dry_run = 0 to go live after
            reviewing the dry-run rows in the merge log.

            03:00 UTC per the Phase 6 spec (8pm MST - after close for AZ,
            before the 06:00 UTC dutchie-import cron touches partners).
        -->
        <record id="cron_partner_dedupe" model="ir.cron">
            <field name="name">Mint POS: dedupe walk-in stub partners</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_dedupe_stubs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
