<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Daily cancel-stale-orders cron.

            Targets mint.pos.order rows that are still in an active swimlane
            state (lobby / sales_floor / pickup / processing / online_orders
            / etc.) but were created more than 24 hours ago. These are
            abandoned customers — Dutchie left them in the lane and they
            never actually rang at the register. Without this cron they
            accumulate forever on the kanban as $0 / 0-item ghost cards.

            Scheduled at 10:00 UTC daily ≈ 3am MST (Mint AZ headquarters
            timezone). Other LSPs (MI/MO/IL/NV/FL) run between 3am and 6am
            local — well after close, well before open.

            See models/pos_order.py::_cron_cancel_stale_orders for logic.
        -->
        <record id="cron_cancel_stale_orders" model="ir.cron">
            <field name="name">Mint POS: cancel stale active-lane orders (>24h)</field>
            <field name="model_id" ref="model_mint_pos_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_cancel_stale_orders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=10, minute=0, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!--
            Self-healing staff-flag guard.

            Backstop for the customer-isolation rule (mint_customer_api
            partner_rule_hide_web_customers): strips Dutchie/POS customer
            flags (x_dutchie_customer_id, walk-in/web_checkout origin) off
            any staff partner that picked them up. Staff who also shop can
            get matched by phone/email and stamped as customers, which then
            hides their own contact from colleagues and breaks ticket-
            follower rendering for internal users. Runs hourly so a stray
            mislabel self-corrects long before anyone hits the error.

            Does NOT clear is_web_customer (genuine-signup signal — human
            decision). See models/pos_partner.py::_cron_clear_staff_customer_flags.
        -->
        <record id="cron_clear_staff_customer_flags" model="ir.cron">
            <field name="name">Mint: clear customer flags off staff partners (guard)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_clear_staff_customer_flags()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
