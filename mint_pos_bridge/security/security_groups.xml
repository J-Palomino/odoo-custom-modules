<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Budtender: view/update orders for their store only -->
        <record id="group_pos_budtender" model="res.groups">
            <field name="name">Mint POS / Budtender</field>
            <field name="comment">View and update POS orders for assigned store(s). Cannot see Dutchie credentials or other stores' data.</field>
        </record>

        <!-- Manager: all stores, settings, employee management -->
        <record id="group_pos_manager" model="res.groups">
            <field name="name">Mint POS / Manager</field>
            <field name="comment">Full POS access across all stores. Can manage employee credentials and view all order data.</field>
            <field name="implied_ids" eval="[(4, ref('group_pos_budtender'))]"/>
        </record>

    </data>

    <!-- Applied on every upgrade (NOT noupdate) so it lands on existing
         installs: the swimlane board now nests under the native Point of
         Sale app, whose root menu is only visible to point_of_sale.group_pos_user.
         Budtenders must therefore be POS users to see the app + the board.
         group_pos_manager implies budtender, so it inherits this. -->
    <data>
        <record id="group_pos_budtender" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        </record>
    </data>
</odoo>
