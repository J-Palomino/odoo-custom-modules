<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- POS Order: budtenders restricted to their allowed companies -->
        <record id="rule_pos_order_company" model="ir.rule">
            <field name="name">POS Order: multi-company</field>
            <field name="model_id" ref="model_mint_pos_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- POS Order Line: follows parent order company rule -->
        <record id="rule_pos_order_line_company" model="ir.rule">
            <field name="name">POS Order Line: multi-company</field>
            <field name="model_id" ref="model_mint_pos_order_line"/>
            <field name="domain_force">['|', ('order_id.company_id', '=', False), ('order_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Employee Credentials: managers only, company-scoped -->
        <record id="rule_pos_employee_cred_company" model="ir.rule">
            <field name="name">POS Employee Credential: multi-company</field>
            <field name="model_id" ref="model_mint_pos_employee_credential"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pos_manager'))]"/>
        </record>

    </data>
</odoo>
