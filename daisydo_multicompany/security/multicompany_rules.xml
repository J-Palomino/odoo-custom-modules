<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Multi-Company Record Rules
        ==========================
        Global rules that restrict records to the user's allowed companies.
        Domain: [('company_id', 'in', company_ids + ([False] if 1 in company_ids else []))]
          - Daisy+ users (company 1 in their list): see their records + unassigned records
          - Other company users: see ONLY their company's records (no unassigned)
          - Admin (has all companies including 1): unchanged, sees everything

        These are global rules (no group_id) so they apply to ALL users including admins.
        Superuser (uid=1) bypasses all record rules automatically.
    -->

    <!-- ============================================================ -->
    <!-- SALES                                                        -->
    <!-- ============================================================ -->

    <record id="rule_sale_order_company" model="ir.rule">
        <field name="name">Sale Order: multi-company isolation</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids + ([False] if 1 in company_ids else []))]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_sale_order_line_company" model="ir.rule">
        <field name="name">Sale Order Line: multi-company isolation</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + ([False] if 1 in company_ids else []))]</field>
        <field name="global" eval="True"/>
    </record>

