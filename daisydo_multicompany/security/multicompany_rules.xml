    <!-- discuss.channel and im_livechat.channel have no company_id in Odoo 19 — skipped -->

    <!-- ============================================================ -->
    <!-- USERS (res.users)                                            -->
    <!-- Uses company_ids (M2M) — each user has explicit assignments. -->
    <!-- Replaces Odoo's default rule that exposes all internal users. -->
    <!-- ============================================================ -->

    <record id="rule_res_users_company" model="ir.rule">
        <field name="name">User: multi-company isolation</field>
        <field name="model_id" ref="base.model_res_users"/>
