<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Filter "Responsible" field by selected team's members -->
    <record id="maintenance_request_form_filter_responsible" model="ir.ui.view">
        <field name="name">maintenance.request.form.filter.responsible</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="attributes">
                <attribute name="domain">[('id', 'in', maintenance_team_id.member_ids.ids)]</attribute>
            </field>
        </field>
    </record>

    <!-- Show "Intake Channel" on the request form (badge) -->
    <record id="maintenance_request_form_intake_channel" model="ir.ui.view">
        <field name="name">maintenance.request.form.intake.channel</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="x_intake_channel" widget="badge"/>
            </field>
        </field>
    </record>

    <!-- Add "Intake Channel" column to the request list view -->
    <record id="maintenance_request_tree_intake_channel" model="ir.ui.view">
        <field name="name">maintenance.request.tree.intake.channel</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="x_intake_channel" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Add "Intake Channel" filters + group-by to the request search view -->
    <record id="maintenance_request_search_intake_channel" model="ir.ui.view">
        <field name="name">maintenance.request.search.intake.channel</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="x_intake_channel"/>
                <separator/>
                <filter string="Phone" name="channel_phone" domain="[('x_intake_channel', '=', 'phone')]"/>
                <filter string="SMS" name="channel_sms" domain="[('x_intake_channel', '=', 'sms')]"/>
                <filter string="Web Form" name="channel_web" domain="[('x_intake_channel', '=', 'web')]"/>
                <filter string="Group by Intake Channel" name="group_intake_channel" context="{'group_by': 'x_intake_channel'}"/>
            </field>
        </field>
    </record>

    <!-- Add "Team" column to Equipment list view -->
    <record id="equipment_tree_add_team" model="ir.ui.view">
        <field name="name">maintenance.equipment.tree.add.team</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="maintenance_team_id" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Add team filters to Equipment search view -->
    <record id="equipment_search_add_team" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.add.team</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="maintenance_team_id"/>
                <filter string="IT" name="filter_it" domain="[('maintenance_team_id', '=', 2)]"/>
                <filter string="Engineering" name="filter_engineering" domain="[('maintenance_team_id', '=', 4)]"/>
                <filter string="Facilities" name="filter_facilities" domain="[('maintenance_team_id', '=', 1)]"/>
                <filter string="Graphics" name="filter_graphics" domain="[('maintenance_team_id', '=', 3)]"/>
                <filter string="Group by Team" name="group_team" context="{'group_by': 'maintenance_team_id'}"/>
            </field>
        </field>
    </record>

    <!--
      Show "Related Requests" on the request form, below Priority in the
      right-hand column (clear of the conditional recurring-maintenance block).

      no_create/no_quick_create are deliberate: without them, typing a name that
      matches nothing silently CREATES a new maintenance request from the tag
      box, which on a ticketing model is a footgun.

      Adopts the manual view created live 2026-07-28; the 19.0.9.9.0 migration
      drops that orphan so the field is not rendered twice.
    -->
    <record id="maintenance_request_form_related_requests" model="ir.ui.view">
        <field name="name">maintenance.request.form.related.requests</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="priority" position="after">
                <field name="x_related_request_ids"
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_quick_create': True}"
                       placeholder="Link related requests..."/>
            </field>
        </field>
    </record>
</odoo>
