<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="request_form" name="Maintenance Request Form">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <h1 class="mb-2">Submit a Maintenance Request</h1>
                            <p class="text-muted mb-4">
                                Use this form to submit IT, graphics, or internal maintenance requests.
                            </p>

                            <t t-if="error">
                                <div class="alert alert-danger" role="alert">
                                    <t t-esc="error"/>
                                </div>
                            </t>
                            <t t-if="success">
                                <div class="alert alert-success" role="alert">
                                    <t t-esc="success"/>
                                </div>
                            </t>

                            <t t-if="not success">
                                <form action="/maintenance/request" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="submitter_name" class="form-label fw-bold">
                                                Your Name <span class="text-danger">*</span>
                                            </label>
                                            <input type="text" class="form-control" id="submitter_name"
                                                   name="submitter_name" required="required"
                                                   placeholder="Your full name"
                                                   t-att-value="form_values.get('submitter_name', '')"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="submitter_email" class="form-label fw-bold">
                                                Your Email <span class="text-danger">*</span>
                                            </label>
                                            <input type="email" class="form-control" id="submitter_email"
                                                   name="submitter_email" required="required"
                                                   placeholder="your.email@mintcannabis.com"
                                                   t-att-value="form_values.get('submitter_email', '')"/>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="name" class="form-label fw-bold">
                                            Request Title <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control" id="name" name="name"
                                               required="required"
                                               placeholder="Brief description of the issue"
                                               t-att-value="form_values.get('name', '')"/>
                                    </div>

                                    <div class="mb-3">
                                        <label for="maintenance_team_id" class="form-label fw-bold">
                                            Team <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-select" id="maintenance_team_id"
                                                name="maintenance_team_id" required="required">
                                            <option value="">-- Select a Team --</option>
                                            <t t-foreach="teams" t-as="team">
                                                <option t-att-value="team.id"
                                                        t-att-selected="str(team.id) == form_values.get('maintenance_team_id', '')">
                                                    <t t-esc="team.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="priority" class="form-label fw-bold">Priority</label>
                                            <select class="form-select" id="priority" name="priority">
                                                <t t-foreach="priorities" t-as="p">
                                                    <option t-att-value="p[0]"
                                                            t-att-selected="p[0] == form_values.get('priority', '2')">
                                                        <t t-esc="p[1]"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="maintenance_type" class="form-label fw-bold">Type</label>
                                            <select class="form-select" id="maintenance_type" name="maintenance_type">
                                                <option value="">-- Select Type --</option>
                                                <t t-foreach="maintenance_types" t-as="mt">
                                                    <option t-att-value="mt[0]"
                                                            t-att-selected="mt[0] == form_values.get('maintenance_type', '')">
                                                        <t t-esc="mt[1]"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="company_id" class="form-label fw-bold">Store / Location</label>
                                            <select class="form-select" id="company_id" name="company_id">
                                                <option value="">-- Select Store --</option>
                                                <t t-foreach="companies" t-as="company">
                                                    <option t-att-value="company.id"
                                                            t-att-selected="str(company.id) == form_values.get('company_id', '')">
                                                        <t t-esc="company.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="category_id" class="form-label fw-bold">Equipment Category</label>
                                            <select class="form-select" id="category_id" name="category_id">
                                                <option value="">-- Select Category --</option>
                                                <t t-foreach="categories" t-as="cat">
                                                    <option t-att-value="cat.id"
                                                            t-att-selected="str(cat.id) == form_values.get('category_id', '')">
                                                        <t t-esc="cat.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="description" class="form-label fw-bold">
                                            Description <span class="text-danger">*</span>
                                        </label>
                                        <textarea class="form-control" id="description" name="description"
                                                  rows="5" required="required"
                                                  placeholder="Describe the issue in detail..."><t t-esc="form_values.get('description', '')"/></textarea>
                                    </div>

                                    <div class="mb-4">
                                        <label for="schedule_date" class="form-label fw-bold">
                                            Preferred Schedule Date
                                        </label>
                                        <input type="date" class="form-control w-50" id="schedule_date"
                                               name="schedule_date"
                                               t-att-value="form_values.get('schedule_date', '')"/>
                                        <div class="form-text">Optional — leave blank if no date preference.</div>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-lg">
                                        Submit Request
                                    </button>
                                </form>
                            </t>

                            <t t-if="success">
                                <a href="/maintenance/request" class="btn btn-outline-primary mt-3">
                                    Submit Another Request
                                </a>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
