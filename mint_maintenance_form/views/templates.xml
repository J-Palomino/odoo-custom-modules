<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="request_form" name="IT Maintenance Request Form">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <h1 class="mb-2">IT Maintenance Request</h1>
                            <p class="text-muted mb-4">
                                Submit an IT maintenance request. This creates a ticket assigned to the IT team.
                            </p>

                            <t t-if="error">
                                <div class="alert alert-danger" role="alert">
                                    <t t-esc="error"/>
                                </div>
                            </t>
                            <t t-if="success">
                                <div class="alert alert-success" role="alert">
                                    <t t-esc="success"/>
                                </div>
                            </t>

                            <t t-if="not success">
                                <!-- Data for JS -->
                                <script type="application/json" id="subtype-data"><t t-out="subtype_options_json"/></script>
                                <input type="hidden" id="saved_equipment_type"
                                       t-att-value="form_values.get('equipment_type', '')"/>
                                <input type="hidden" id="saved_subtype"
                                       t-att-value="form_values.get('subtype', '')"/>

                                <form action="/maintenance/request" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <!-- Your Name & Email -->
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="submitter_name" class="form-label fw-bold">
                                                Your Name <span class="text-danger">*</span>
                                            </label>
                                            <t t-if="is_logged_in">
                                                <input type="text" class="form-control" id="submitter_name"
                                                       name="submitter_name" readonly="readonly"
                                                       t-att-value="form_values.get('submitter_name', '')"
                                                       style="background-color: #f8f9fa;"/>
                                            </t>
                                            <t t-else="">
                                                <input type="text" class="form-control" id="submitter_name"
                                                       name="submitter_name" required="required"
                                                       placeholder="Your full name"
                                                       t-att-value="form_values.get('submitter_name', '')"/>
                                            </t>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="submitter_email" class="form-label fw-bold">
                                                Your Email <span class="text-danger">*</span>
                                            </label>
                                            <t t-if="is_logged_in">
                                                <input type="email" class="form-control" id="submitter_email"
                                                       name="submitter_email" readonly="readonly"
                                                       t-att-value="form_values.get('submitter_email', '')"
                                                       style="background-color: #f8f9fa;"/>
                                            </t>
                                            <t t-else="">
                                                <input type="email" class="form-control" id="submitter_email"
                                                       name="submitter_email" required="required"
                                                       placeholder="your.email@mintcannabis.com"
                                                       t-att-value="form_values.get('submitter_email', '')"/>
                                            </t>
                                        </div>
                                    </div>

                                    <!-- State & Store -->
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="state" class="form-label fw-bold">State</label>
                                            <select class="form-select" id="state" name="state">
                                                <option value="">-- Select State --</option>
                                                <t t-foreach="states" t-as="s">
                                                    <option t-att-value="s"
                                                            t-att-selected="s == form_values.get('state', '')">
                                                        <t t-esc="s"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="company_id" class="form-label fw-bold">Store / Location</label>
                                            <select class="form-select" id="company_id" name="company_id">
                                                <option value="">-- Select Store --</option>
                                                <t t-foreach="companies" t-as="c">
                                                    <option t-att-value="c['id']"
                                                            t-att-data-state="c['state']"
                                                            t-att-selected="str(c['id']) == form_values.get('company_id', '')">
                                                        <t t-esc="c['name']"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Equipment Type & Sub-type -->
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="equipment_type" class="form-label fw-bold">
                                                Equipment Type <span class="text-danger">*</span>
                                            </label>
                                            <select class="form-select" id="equipment_type"
                                                    name="equipment_type" required="required">
                                                <option value="">-- Select Type --</option>
                                                <t t-foreach="equipment_types" t-as="et">
                                                    <option t-att-value="et[0]"
                                                            t-att-selected="et[0] == form_values.get('equipment_type', '')">
                                                        <t t-esc="et[1]"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3" id="subtype_wrapper" style="display:none">
                                            <label for="subtype" class="form-label fw-bold">Specify</label>
                                            <select class="form-select" id="subtype" name="subtype">
                                                <option value="">-- Select --</option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Priority -->
                                    <div class="mb-3">
                                        <label for="priority" class="form-label fw-bold">
                                            Priority <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-select w-50" id="priority"
                                                name="priority" required="required">
                                            <t t-foreach="priorities" t-as="p">
                                                <option t-att-value="p[0]"
                                                        t-att-selected="p[0] == form_values.get('priority', '2')">
                                                    <t t-esc="p[1]"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <!-- Description -->
                                    <div class="mb-3">
                                        <label for="description" class="form-label fw-bold">
                                            Description of Issue <span class="text-danger">*</span>
                                        </label>
                                        <textarea class="form-control" id="description" name="description"
                                                  rows="5" required="required"
                                                  placeholder="Describe the issue in detail..."><t t-esc="form_values.get('description', '')"/></textarea>
                                    </div>

                                    <!-- Photos -->
                                    <div class="mb-4">
                                        <label for="photos" class="form-label fw-bold">
                                            Photos / Screenshots
                                        </label>
                                        <input type="file" class="form-control" id="photos"
                                               name="photos" multiple="multiple"
                                               accept="image/*,.pdf"/>
                                        <div class="form-text">
                                            Optional — attach photos or screenshots of the issue (max 5 files, 10 MB each).
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-lg">
                                        Submit Request
                                    </button>
                                </form>

                                <script>
                                    (function () {
                                        var subtypeData = JSON.parse(
                                            document.getElementById('subtype-data').textContent || '{}'
                                        );
                                        var savedSubtype = document.getElementById('saved_subtype').value || '';

                                        /* --- Equipment sub-type conditional --- */
                                        var equipSelect = document.getElementById('equipment_type');
                                        var subtypeWrapper = document.getElementById('subtype_wrapper');
                                        var subtypeSelect = document.getElementById('subtype');

                                        function updateSubtype() {
                                            var opts = subtypeData[equipSelect.value];
                                            subtypeSelect.innerHTML = '<option value="">-- Select --</option>';
                                            if (opts) {
                                                opts.forEach(function (o) {
                                                    var el = document.createElement('option');
                                                    el.value = o[0];
                                                    el.textContent = o[1];
                                                    if (o[0] === savedSubtype) el.selected = true;
                                                    subtypeSelect.appendChild(el);
                                                });
                                                subtypeWrapper.style.display = '';
                                            } else {
                                                subtypeWrapper.style.display = 'none';
                                            }
                                            savedSubtype = '';
                                        }

                                        equipSelect.addEventListener('change', updateSubtype);
                                        updateSubtype();

                                        /* --- State -> Store filter --- */
                                        var stateSelect = document.getElementById('state');
                                        var storeSelect = document.getElementById('company_id');
                                        var allStores = [];
                                        Array.from(storeSelect.options).forEach(function (opt) {
                                            if (opt.value) {
                                                allStores.push({
                                                    value: opt.value,
                                                    text: opt.text,
                                                    state: opt.dataset.state || '',
                                                    selected: opt.selected
                                                });
                                            }
                                        });

                                        function filterStores(reset) {
                                            var sel = stateSelect.value;
                                            var cur = storeSelect.value;
                                            while (storeSelect.options.length > 0) storeSelect.remove(0);
                                            var ph = document.createElement('option');
                                            ph.value = '';
                                            ph.textContent = sel ? '-- Select Store --' : '-- Select a state first --';
                                            storeSelect.appendChild(ph);
                                            if (sel) {
                                                allStores.forEach(function (s) {
                                                    if (s.state === sel) {
                                                        var el = document.createElement('option');
                                                        el.value = s.value;
                                                        el.textContent = s.text;
                                                        if (!reset &amp;&amp; s.value === cur) el.selected = true;
                                                        storeSelect.appendChild(el);
                                                    }
                                                });
                                            }
                                            if (reset) storeSelect.value = '';
                                        }

                                        stateSelect.addEventListener('change', function () {
                                            filterStores(true);
                                        });
                                        filterStores(false);
                                    })();
                                </script>
                            </t>

                            <t t-if="success">
                                <a href="/maintenance/request" class="btn btn-outline-primary mt-3">
                                    Submit Another Request
                                </a>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="request_list" name="My Maintenance Requests">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1 class="mb-0">My Open Requests</h1>
                        <a href="/maintenance/request" class="btn btn-primary">
                            New Request
                        </a>
                    </div>

                    <t t-if="not requests">
                        <div class="alert alert-info">
                            You have no open maintenance requests.
                        </div>
                    </t>

                    <t t-if="requests">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Request</th>
                                        <th>Store</th>
                                        <th>Equipment</th>
                                        <th>Priority</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="requests" t-as="r">
                                        <tr>
                                            <td>
                                                <strong><t t-esc="r['name']"/></strong>
                                            </td>
                                            <td><t t-esc="r['company']"/></td>
                                            <td><t t-esc="r['equipment']"/></td>
                                            <td>
                                                <t t-if="r['priority'] == 'High'">
                                                    <span class="badge bg-danger"><t t-esc="r['priority']"/></span>
                                                </t>
                                                <t t-elif="r['priority'] == 'Normal'">
                                                    <span class="badge bg-warning text-dark"><t t-esc="r['priority']"/></span>
                                                </t>
                                                <t t-else="">
                                                    <span class="badge bg-secondary"><t t-esc="r['priority']"/></span>
                                                </t>
                                            </td>
                                            <td>
                                                <span class="badge bg-info text-dark"><t t-esc="r['stage']"/></span>
                                            </td>
                                            <td><t t-esc="r['request_date']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
