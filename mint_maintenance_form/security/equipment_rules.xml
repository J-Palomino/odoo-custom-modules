<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!--
            Global rule: regular users see only equipment from their
            maintenance team(s) + unassigned equipment.
            Managers (group_equipment_manager) see everything.
            The domain_force is a Python expression evaluated per-user.
        -->
        <record id="equipment_team_rule" model="ir.rule">
            <field name="name">Equipment: own team (managers see all)</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('maintenance.group_equipment_manager') else [
                '|',
                ('maintenance_team_id', '=', False),
                ('maintenance_team_id.member_ids', 'in', [user.id])
            ]</field>
        </record>
    </data>
</odoo>
