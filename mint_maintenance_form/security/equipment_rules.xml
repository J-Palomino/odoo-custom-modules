<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!--
            Regular maintenance users only see equipment from their team(s)
            + unassigned equipment. Rules from multiple groups are OR'd,
            so managers (who inherit group_equipment_user) also get the
            "see all" rule below, which overrides this restriction.
        -->
        <record id="equipment_team_rule_user" model="ir.rule">
            <field name="name">Equipment: own team only (users)</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="domain_force">[
                '|',
                ('maintenance_team_id', '=', False),
                ('maintenance_team_id.member_ids', 'in', [user.id])
            ]</field>
            <field name="groups" eval="[(4, ref('maintenance.group_equipment_user'))]"/>
        </record>

        <!-- Managers see all equipment regardless of team -->
        <record id="equipment_team_rule_manager" model="ir.rule">
            <field name="name">Equipment: all (managers)</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('maintenance.group_equipment_manager'))]"/>
        </record>
    </data>
</odoo>
