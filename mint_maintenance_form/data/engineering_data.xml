        </record>
        <record id="categ_eng_wazuh" model="maintenance.equipment.category">
            <field name="name">Security / SIEM</field>
        </record>

        <!-- Engineering Equipment Records (team_id=4 = Engineering) -->
        <record id="equip_eng_website" model="maintenance.equipment">
            <field name="name">Website</field>
            <field name="category_id" ref="categ_eng_website"/>
