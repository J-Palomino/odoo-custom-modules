            <field name="name">Wazuh Manager (SIEM)</field>
            <field name="category_id" ref="categ_eng_wazuh"/>
            <field name="company_id" eval="False"/>
            <field name="note"><![CDATA[
<p><b>Wazuh Security Manager</b></p>
<p><b>Hostname:</b> wazuh-manager.wazuh.svc.cluster.local</p>
<p><b>Type:</b> ClusterIP (internal only, no external exposure)</p>
<p><b>Namespace:</b> wazuh</p>
<p><b>Image:</b> wazuh/wazuh-manager:4.14.4</p>
<p><b>Ports:</b></p>
<ul>
    <li>1514/TCP — Agent communication</li>
    <li>1515/TCP — Agent enrollment</li>
    <li>55000/TCP — Wazuh API</li>
</ul>
<p><b>K8s Manifests:</b> k8s/wazuh/ (StatefulSet, Service, ConfigMap, DaemonSet agent)</p>
<p><b>Dashboard:</b> Grafana wazuh-dashboard (k8s/monitoring/wazuh-dashboard.yaml)</p>
]]></field>
        </record>
    </data>
</odoo>
