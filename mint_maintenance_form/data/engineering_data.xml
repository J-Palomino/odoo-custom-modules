        </record>
        <record id="equip_eng_ecommerce" model="maintenance.equipment">
            <field name="name">E-Commerce / Online Menu</field>
            <field name="category_id" ref="categ_eng_ecommerce"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="equip_eng_mobile" model="maintenance.equipment">
            <field name="name">Mobile App</field>
            <field name="category_id" ref="categ_eng_mobile"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="equip_eng_ai_chat" model="maintenance.equipment">
            <field name="name">AI / Chat</field>
            <field name="category_id" ref="categ_eng_ai_chat"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="equip_eng_erp" model="maintenance.equipment">
            <field name="name">Internal Software / ERP</field>
            <field name="category_id" ref="categ_eng_erp"/>
