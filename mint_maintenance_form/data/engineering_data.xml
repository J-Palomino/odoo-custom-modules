        <!-- Engineering Equipment Categories -->
        <record id="categ_eng_website" model="maintenance.equipment.category">
            <field name="name">Website</field>
        </record>
        <record id="categ_eng_ecommerce" model="maintenance.equipment.category">
            <field name="name">E-Commerce / Online Menu</field>
        </record>
        <record id="categ_eng_mobile" model="maintenance.equipment.category">
            <field name="name">Mobile App</field>
        </record>
        <record id="categ_eng_ai_chat" model="maintenance.equipment.category">
