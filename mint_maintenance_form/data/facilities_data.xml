        </record>
        <record id="categ_facilities_parking" model="maintenance.equipment.category">
            <field name="name">Parking Lot</field>
        </record>
        <record id="categ_facilities_signage" model="maintenance.equipment.category">
            <field name="name">Signage</field>
        </record>
        <record id="categ_facilities_furniture" model="maintenance.equipment.category">
            <field name="name">Furniture / Fixtures</field>
        </record>

