<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Facilities Maintenance Team -->
        <record id="team_facilities" model="maintenance.team">
            <field name="name">Facilities</field>
        </record>

        <!-- Facilities Equipment Categories -->
        <record id="categ_facilities_hvac" model="maintenance.equipment.category">
            <field name="name">HVAC</field>
        </record>
        <record id="categ_facilities_plumbing" model="maintenance.equipment.category">
            <field name="name">Plumbing</field>
        </record>
        <record id="categ_facilities_electrical" model="maintenance.equipment.category">
