<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Gate all vault access behind this group (staging lockdown).
         Only users explicitly added to this group can see/use the Vault.
         User assignment by email is done in post_init_hook. -->
    <record id="group_vault_user" model="res.groups">
        <field name="name">Vault User</field>
        <field name="comment">Restrict vault access until staging is validated.</field>
    </record>

    <record id="group_vault_export" model="res.groups">
        <field name="name">Allow to export vaults</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>
    <record id="group_vault_import" model="res.groups">
        <field name="name">Allow to import vaults</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>
</odoo>
