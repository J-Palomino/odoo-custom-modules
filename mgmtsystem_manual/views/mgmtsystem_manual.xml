<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Odoo 19 removed the `ir.actions.act_window.view` model. The window's
        view_ids m2m on ir.actions.act_window is the v19 replacement. Here
        the action's view_mode + view_id are sufficient for the list view;
        the form view is resolved by view_mode='list,form' falling back to
        the model's default form view registered by document_page.
    -->
    <record model="ir.actions.act_window" id="action_manuals">
        <field name="name">Manuals</field>
        <field name="res_model">document.page</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="document_page.view_wiki_tree" />
        <field name="search_view_id" ref="document_page.view_wiki_filter" />
        <field name="help">Manuals of your management systems.</field>
        <field name="domain" eval="[('parent_id', 'ilike', 'manual')]" />
    </record>

    <menuitem
        id="menu_mgmtsystem_manuals_manuals"
        name="Manuals"
        action="action_manuals"
        parent="mgmtsystem.menu_mgmtsystem_manuals"
        sequence="0"
        groups="mgmtsystem.group_mgmtsystem_viewer"
    />
</odoo>
