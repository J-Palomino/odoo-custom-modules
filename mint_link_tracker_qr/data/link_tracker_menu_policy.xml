<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Link Tracker GUI policy: internal users work with link.tracker only
         through their agents (RPC — see security/ir.model.access.csv, keyed
         on daisydo_agents.group_daisy_agents). Every backend menu that
         surfaces link.tracker is restricted to Settings administrators.

         noupdate stays OFF on purpose: an upgrade of an owning stock module
         (utm / link_tracker / mass_mailing / mass_mailing_sms / website_links)
         restores its stock menu groups; the NEXT -u of this module then
         re-asserts the policy. After any stock-module upgrade, re-run
         -u mint_link_tracker_qr. -->

    <record id="utm.menu_link_tracker_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <record id="link_tracker.link_tracker_menu_main" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <record id="mass_mailing.link_tracker_menu_mass_mailing" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <record id="mass_mailing_sms.link_tracker_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <record id="website_links.menu_link_tracker" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <!-- The hand-made "Project / Link Tracker" prod menu has no external id
         and is archived once by the 19.0.2.0.0 post-migration, not here:
         a search-by-name in noupdate-off data would re-run forever and
         silently archive any future menu that happens to match. -->
</odoo>
