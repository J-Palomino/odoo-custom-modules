<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_social_sync_profiles" model="ir.cron">
            <field name="name">Social Publish: sync connected accounts from posts.agency</field>
            <field name="model_id" ref="model_mint_social_profile"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_profiles()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_social_publish" model="ir.cron">
            <field name="name">Social Publish: forward scheduled posts to posts.agency</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="state">code</field>
            <field name="code">model._cron_social_publish()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
