<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_mint_oauth_client_list" model="ir.ui.view">
        <field name="name">mint.oauth.client.list</field>
        <field name="model">mint.oauth.client</field>
        <field name="arch" type="xml">
            <list string="OIDC Clients">
                <field name="name"/>
                <field name="client_id"/>
                <field name="scopes"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_mint_oauth_client_form" model="ir.ui.view">
        <field name="name">mint.oauth.client.form</field>
        <field name="model">mint.oauth.client</field>
        <field name="arch" type="xml">
            <form string="OIDC Client">
                <header>
                    <button name="action_generate_secret" type="object"
                            string="Generate Client Secret" class="btn-primary"
                            confirm="This invalidates the current secret immediately. Any application still using it will fail to authenticate until updated. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Penpot"/></h1>
                    </div>
                    <group>
                        <group string="Credentials">
                            <field name="client_id" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group string="Token Lifetimes">
                            <field name="access_token_ttl"/>
                            <field name="refresh_token_ttl"/>
                        </group>
                    </group>
                    <group string="Scopes">
                        <field name="scopes" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Redirect URIs">
                            <div class="alert alert-info" role="status">
                                Matched exactly — no wildcards or prefixes. Register
                                every environment's callback URL explicitly.
                            </div>
                            <field name="redirect_uri_ids">
                                <list editable="bottom">
                                    <field name="uri" placeholder="https://ux.letsgomint.us/api/auth/oauth/oidc/callback"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mint_oauth_client" model="ir.actions.act_window">
        <field name="name">OIDC Clients</field>
        <field name="res_model">mint.oauth.client</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a relying party</p>
            <p>
                An OIDC client is an application that authenticates its users
                against this Odoo instance — Penpot, for example.
            </p>
        </field>
    </record>

    <record id="view_mint_oauth_token_list" model="ir.ui.view">
        <field name="name">mint.oauth.token.list</field>
        <field name="model">mint.oauth.token</field>
        <field name="arch" type="xml">
            <!-- Revoking here cuts access immediately: access tokens are
                 opaque and checked against this table on every /userinfo call,
                 rather than being self-contained JWTs that stay valid until
                 they expire. -->
            <list string="Issued Tokens" create="false">
                <field name="user_id"/>
                <field name="client_id"/>
                <field name="token_type"/>
                <field name="scope"/>
                <field name="expires_at"/>
                <field name="revoked"/>
                <button name="action_revoke" type="object" string="Revoke"
                        icon="fa-ban" invisible="revoked"/>
            </list>
        </field>
    </record>

    <record id="action_mint_oauth_token" model="ir.actions.act_window">
        <field name="name">Issued Tokens</field>
        <field name="res_model">mint.oauth.token</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
