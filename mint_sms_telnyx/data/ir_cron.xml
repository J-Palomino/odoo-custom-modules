<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_proxy_health" model="ir.cron">
        <field name="name">SMS: BlueBubbles proxy health probe</field>
        <field name="model_id" ref="model_mint_sms_message"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_proxy_health()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
