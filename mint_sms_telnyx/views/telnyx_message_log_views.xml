<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telnyx_message_log_list" model="ir.ui.view">
        <field name="name">telnyx.message.log.list</field>
        <field name="model">telnyx.message.log</field>
        <field name="arch" type="xml">
            <list string="Telnyx Messages" default_order="create_date desc">
                <field name="create_date"/>
                <field name="direction"/>
                <field name="from_number"/>
                <field name="to_number"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="error_code"/>
                <field name="telnyx_message_id"/>
            </list>
        </field>
    </record>

    <record id="view_telnyx_message_log_form" model="ir.ui.view">
        <field name="name">telnyx.message.log.form</field>
        <field name="model">telnyx.message.log</field>
        <field name="arch" type="xml">
            <form string="Telnyx Message">
                <sheet>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="state"/>
                            <field name="telnyx_message_id"/>
                            <field name="sms_sms_id"/>
                        </group>
                        <group>
                            <field name="from_number"/>
                            <field name="to_number"/>
                            <field name="partner_id"/>
                            <field name="sent_at"/>
                            <field name="delivered_at"/>
                        </group>
                    </group>
                    <group string="Body">
                        <field name="body" nolabel="1"/>
                    </group>
                    <group string="Error" invisible="not error_code and not error_message">
                        <field name="error_code"/>
                        <field name="error_message"/>
                    </group>
                    <notebook>
                        <page string="Raw Request" invisible="not raw_request">
                            <field name="raw_request" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Raw Response">
                            <field name="raw_response" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telnyx_message_log_search" model="ir.ui.view">
        <field name="name">telnyx.message.log.search</field>
        <field name="model">telnyx.message.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="telnyx_message_id"/>
                <field name="from_number"/>
                <field name="to_number"/>
                <field name="partner_id"/>
                <filter string="Outbound" name="outbound" domain="[('direction','=','outbound')]"/>
                <filter string="Inbound" name="inbound" domain="[('direction','=','inbound')]"/>
                <separator/>
                <filter string="Delivered" name="delivered" domain="[('state','=','delivered')]"/>
                <filter string="Failed" name="failed"
                        domain="[('state','in',['delivery_failed','sending_failed','error'])]"/>
                <separator/>
                <filter string="Direction" name="grp_direction" context="{'group_by': 'direction'}"/>
                <filter string="State" name="grp_state" context="{'group_by': 'state'}"/>
                <filter string="Partner" name="grp_partner" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_telnyx_message_log" model="ir.actions.act_window">
        <field name="name">Telnyx Messages</field>
        <field name="res_model">telnyx.message.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_telnyx_message_log_search"/>
    </record>

    <menuitem id="menu_telnyx_message_log_root"
              name="Telnyx SMS"
              parent="mail.menu_root_discuss"
              sequence="100"/>
    <menuitem id="menu_telnyx_message_log"
              name="Messages"
              parent="menu_telnyx_message_log_root"
              action="action_telnyx_message_log"
              sequence="10"/>
</odoo>
