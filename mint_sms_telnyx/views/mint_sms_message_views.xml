<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mint_sms_message_view_list" model="ir.ui.view">
        <field name="name">mint.sms.message.list</field>
        <field name="model">mint.sms.message</field>
        <field name="arch" type="xml">
            <!-- Compose is allowed from here (2026-08-13): model access grants
                 create only to the SMS Sender group, so the New button simply
                 doesn't render for anyone else. The action's
                 mint_sms_no_autosend context keeps a composed record in draft
                 until its Send button is clicked — and action_send still runs
                 the full consent/whitelist gate. -->
            <list string="Outbound Texts">
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="number"/>
                <field name="category" optional="show"/>
                <field name="body"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-danger="state in ('failed','blocked')"
                       decoration-muted="state == 'draft'"/>
                <field name="block_reason" optional="show"/>
                <field name="sent_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mint_sms_message_view_form" model="ir.ui.view">
        <field name="name">mint.sms.message.form</field>
        <field name="model">mint.sms.message</field>
        <field name="arch" type="xml">
            <form string="Outbound Text">
                <header>
                    <button name="action_send" type="object" string="Send"
                            class="btn-primary"
                            invisible="state == 'sent'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="number"/>
                            <field name="category"/>
                            <field name="channel"/>
                        </group>
                        <group>
                            <field name="sent_at"/>
                            <field name="delivered_at" invisible="not delivered_at"/>
                            <field name="delivery_verified" invisible="state != 'sent'"/>
                            <field name="block_reason" invisible="state != 'blocked'"/>
                            <field name="error_message" invisible="state != 'failed'"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="body" nolabel="1"/>
                    </group>
                    <group string="Transport" groups="base.group_no_one">
                        <field name="chat_guid"/>
                        <field name="temp_guid"/>
                        <field name="response_payload"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mint_sms_message_action" model="ir.actions.act_window">
        <field name="name">Outbound Texts</field>
        <field name="res_model">mint.sms.message</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'mint_sms_no_autosend': 1}</field>
    </record>

    <menuitem id="menu_mint_sms_messages"
              name="Outbound Texts"
              parent="menu_telnyx_message_log_root"
              action="mint_sms_message_action"
              sequence="5"/>
</odoo>
