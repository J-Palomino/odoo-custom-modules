<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Print Node -->
    <record id="view_mint_print_node_form" model="ir.ui.view">
        <field name="name">mint.print.node.form</field>
        <field name="model">mint.print.node</field>
        <field name="arch" type="xml">
            <form string="Print Node">
                <header>
                    <button name="action_rotate_token" type="object"
                            string="Rotate Token" icon="fa-refresh"
                            confirm="Rotate the agent token? The agent must be reconfigured."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Online" bg_color="text-bg-success"
                            invisible="not online"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Tempe Register 1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="hostname" readonly="1"/>
                            <field name="last_seen" readonly="1"/>
                            <field name="online" readonly="1"/>
                        </group>
                        <group>
                            <field name="agent_url"/>
                            <field name="token" password="True"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Printers" name="printers">
                            <field name="printer_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="system_name"/>
                                    <field name="role"/>
                                    <field name="is_default"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mint_print_node_list" model="ir.ui.view">
        <field name="name">mint.print.node.list</field>
        <field name="model">mint.print.node</field>
        <field name="arch" type="xml">
            <list string="Print Nodes">
                <field name="name"/>
                <field name="company_id"/>
                <field name="hostname"/>
                <field name="online" widget="boolean_toggle"/>
                <field name="last_seen"/>
                <field name="job_count" string="Pending"/>
            </list>
        </field>
    </record>

    <record id="action_mint_print_node" model="ir.actions.act_window">
        <field name="name">Print Nodes</field>
        <field name="res_model">mint.print.node</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Print Jobs -->
    <record id="view_mint_print_job_list" model="ir.ui.view">
        <field name="name">mint.print.job.list</field>
        <field name="model">mint.print.job</field>
        <field name="arch" type="xml">
            <list string="Print Jobs" create="false">
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="node_id"/>
                <field name="printer_id"/>
                <field name="role"/>
                <field name="source"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'pending'"/>
                <field name="error" optional="hide"/>
                <button name="action_retry" type="object" string="Retry" icon="fa-refresh"
                        invisible="state not in ('error','cancelled')"/>
                <button name="action_cancel" type="object" string="Cancel" icon="fa-times"
                        invisible="state not in ('pending','printing')"/>
            </list>
        </field>
    </record>

    <record id="action_mint_print_job" model="ir.actions.act_window">
        <field name="name">Print Jobs</field>
        <field name="res_model">mint.print.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mint_print_root" name="Print Network"
              parent="point_of_sale.menu_point_root" sequence="92"/>
    <menuitem id="menu_mint_print_node" name="Print Nodes"
              parent="menu_mint_print_root" action="action_mint_print_node" sequence="10"/>
    <menuitem id="menu_mint_print_job" name="Print Jobs"
              parent="menu_mint_print_root" action="action_mint_print_job" sequence="20"/>

</odoo>
