<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_expire_pending" model="ir.cron">
        <field name="name">Mail Approval: expire stale review requests</field>
        <field name="model_id" ref="mail.model_mail_mail"/>
        <field name="state">code</field>
        <field name="code">model._mma_cron_expire_pending()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
