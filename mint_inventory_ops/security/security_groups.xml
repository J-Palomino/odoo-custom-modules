<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_inventory_user" model="res.groups">
        <field name="name">Mint Inventory / User</field>
        <field name="comment">Can view adjustments and create drafts</field>
    </record>

    <record id="group_inventory_manager" model="res.groups">
        <field name="name">Mint Inventory / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_inventory_user'))]"/>
        <field name="comment">Can approve, reject, and apply adjustments. Full CRUD.</field>
    </record>
</odoo>
