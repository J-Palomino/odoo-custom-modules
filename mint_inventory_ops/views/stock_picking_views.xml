<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Surface the Dutchie push on the receipt itself. Without this the only
         evidence a receipt reached POS is a chatter message, which is easy to
         miss on a busy picking. -->
    <record id="view_picking_form_dutchie" model="ir.ui.view">
        <field name="name">stock.picking.form.dutchie.receive</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_retry_dutchie_push"
                        string="Retry Dutchie Push"
                        type="object"
                        invisible="picking_type_code != 'incoming' or state != 'done' or dutchie_receive_id"
                        groups="mint_inventory_ops.group_inventory_manager"
                        help="Send this validated receipt to Dutchie POS again. Use after fixing whatever made it skip or fail — an unknown vendor, a missing LocId, or dry-run mode."/>
            </xpath>

            <xpath expr="//field[@name='origin']" position="after">
                <field name="dutchie_push_state"
                       invisible="picking_type_code != 'incoming'"/>
                <field name="dutchie_receive_id"
                       invisible="not dutchie_receive_id"/>
                <field name="dutchie_push_note"
                       invisible="not dutchie_push_note"/>
            </xpath>

        </field>
    </record>

</odoo>
