<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <menuitem id="menu_mint_inventory_root"
              name="Mint Inventory"
              web_icon="mint_inventory_ops,static/description/icon.png"
              sequence="25"/>

    <menuitem id="menu_adjustments"
              name="Adjustments"
              parent="menu_mint_inventory_root"
              action="action_adjustment"
              sequence="10"/>

    <menuitem id="menu_dutchie_receive"
              name="Receive Inventory"
              parent="menu_mint_inventory_root"
              action="action_dutchie_receive"
              sequence="5"/>

    <!-- Mirrored Dutchie reference data. Managers only: it is a cache that a
         sync overwrites, not something to curate by hand. -->
    <menuitem id="menu_dutchie_refs"
              name="Dutchie Reference"
              parent="menu_mint_inventory_root"
              sequence="90"
              groups="mint_inventory_ops.group_inventory_manager"/>

    <menuitem id="menu_dutchie_rooms"
              name="Rooms"
              parent="menu_dutchie_refs"
              action="action_dutchie_room"
              sequence="10"/>

    <menuitem id="menu_dutchie_vendors"
              name="Vendors"
              parent="menu_dutchie_refs"
              action="action_dutchie_vendor"
              sequence="20"/>
</odoo>
