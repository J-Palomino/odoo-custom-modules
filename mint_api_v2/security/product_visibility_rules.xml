<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Opt-in restriction group. Users added to this group lose visibility
            of cannabis products (x_is_cannabis=True). Everyone else is
            unaffected, so the rule is safe to install org-wide without
            breaking the 48 users whose active company is the non-dispensary
            parent "Mint Cannabis".

            Bypasses:
              - base.group_system (sysadmin)
              - user is NOT in group_warehouse_only

            Sync pipelines run as admin / sudo() and are unaffected.
        -->
        <record id="group_warehouse_only" model="res.groups">
            <field name="name">Warehouse Only (hide cannabis products)</field>
        </record>

        <record id="rule_product_template_warehouse_hide_cannabis" model="ir.rule">
            <field name="name">Hide cannabis products for warehouse-only users (template)</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">[('x_is_cannabis', '=', False)] if (user.has_group('mint_api_v2.group_warehouse_only') and not user.has_group('base.group_system')) else [(1, '=', 1)]</field>
            <field name="groups" eval="[(5, 0, 0)]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_product_product_warehouse_hide_cannabis" model="ir.rule">
            <field name="name">Hide cannabis products for warehouse-only users (variant)</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="domain_force">[('product_tmpl_id.x_is_cannabis', '=', False)] if (user.has_group('mint_api_v2.group_warehouse_only') and not user.has_group('base.group_system')) else [(1, '=', 1)]</field>
            <field name="groups" eval="[(5, 0, 0)]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>
