<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dutchie_checkpoint_list" model="ir.ui.view">
        <field name="name">mint.dutchie.sync.checkpoint.list</field>
        <field name="model">mint.dutchie.sync.checkpoint</field>
        <field name="arch" type="xml">
            <list string="Roster Sync Checkpoints"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'error'"
                  decoration-info="state == 'running'">
                <field name="company_id"/>
                <field name="loc_id"/>
                <field name="state"/>
                <field name="next_page"/>
                <field name="rows_done"/>
                <field name="rows_total"/>
                <field name="last_run"/>
                <field name="last_error" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dutchie_checkpoint_form" model="ir.ui.view">
        <field name="name">mint.dutchie.sync.checkpoint.form</field>
        <field name="model">mint.dutchie.sync.checkpoint</field>
        <field name="arch" type="xml">
            <form string="Roster Sync Checkpoint">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="loc_id"/>
                            <field name="state"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="page_size"/>
                            <field name="next_page"/>
                            <field name="rows_done"/>
                            <field name="rows_total"/>
                            <field name="last_run"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dutchie_checkpoints" model="ir.actions.act_window">
        <field name="name">Roster Sync</field>
        <field name="res_model">mint.dutchie.sync.checkpoint</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dutchie_checkpoints"
              name="Roster Sync"
              parent="menu_dutchie_root"
              action="action_dutchie_checkpoints"
              sequence="40"/>
</odoo>
