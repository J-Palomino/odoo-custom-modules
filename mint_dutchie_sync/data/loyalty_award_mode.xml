<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        noupdate="1" is load-bearing: this seeds the gate once, on install,
        and never again. Without it every module upgrade would silently stomp
        whatever the operator had set, re-enabling minting at the worst
        possible moment (mid-reconciliation).

        Flip to 'legacy' from Settings > Technical > System Parameters to
        restore automatic 1 pt/$1 awarding on purchase import.
    -->
    <data noupdate="1">
        <record id="param_mint_loyalty_award_mode" model="ir.config_parameter">
            <field name="key">mint.loyalty.award_mode</field>
            <field name="value">off</field>
        </record>
        <!--
            Per-region award rates, JSON keyed by mint.region.code, in points
            per net dollar. Seeded EMPTY on purpose: minting in Odoo creates a
            SECOND ledger that only ever goes up, because register redemptions
            live in Dutchie and there is no feed back (its loyalty API is
            read-only, no redemption webhook). Measured on Michigan 2026-08-23:
            customers spend 99.8% of what they earn, so an accrual-only balance
            overstates by ~100% of earnings and diverges without bound.

            Michigan is therefore MIRRORED from Dutchie, not minted here.

            Enable a region ONLY where Odoo owns the whole ledger (earn AND
            spend), by setting this parameter in Settings > Technical > System
            Parameters, e.g. {"XX": 0.025}. Empty = no region mints, which is
            also what an unset/malformed value does (the gate fails closed).
        -->
        <record id="param_mint_loyalty_region_award_rates" model="ir.config_parameter">
            <field name="key">mint.loyalty.region_award_rates</field>
            <field name="value">{}</field>
        </record>
    </data>
</odoo>
