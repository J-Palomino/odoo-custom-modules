<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Portal users can only see their own purchase records -->
        <record id="rule_dutchie_purchase_portal" model="ir.rule">
            <field name="name">Dutchie Purchase: portal own only</field>
            <field name="model_id" ref="model_mint_dutchie_purchase"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Internal users (non-admin) can only read purchases in their company -->
        <record id="rule_dutchie_purchase_company" model="ir.rule">
            <field name="name">Dutchie Purchase: company rule</field>
            <field name="model_id" ref="model_mint_dutchie_purchase"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
