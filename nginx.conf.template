map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

upstream odoo_app { server 127.0.0.1:8080; }
upstream odoo_ws  { server 127.0.0.1:8072; }

server {
  listen ${PORT};

  proxy_read_timeout 720s;
  proxy_connect_timeout 720s;
  proxy_send_timeout 720s;
  client_max_body_size 200m;

  # Static health endpoint — returns 200 immediately while Odoo boots
  location = /web/health {
    access_log off;
    return 200 'OK';
    add_header Content-Type text/plain;
  }

  location /websocket {
    proxy_pass http://odoo_ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
  }

  # Longpolling fallback — must route to gevent worker, not HTTP workers
  location /longpolling/poll {
    proxy_pass http://odoo_ws;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location / {
    proxy_pass http://odoo_app;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}
