worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    access_log /dev/stdout;
    sendfile on;
    keepalive_timeout 65;

    upstream odoo-http {
        server 127.0.0.1:8069;
    }

    upstream odoo-ws {
        server 127.0.0.1:8072;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen __NGINX_PORT__;

        proxy_buffers 16 64k;
        proxy_buffer_size 128k;
        client_max_body_size 200m;

        # Static health endpoint — returns 200 immediately while Odoo boots
        location = /web/health {
            access_log off;
            return 200 '{"status": "pass"}';
            add_header Content-Type application/json;
        }

        # Websocket — route to gevent worker (Odoo 19 bus)
        # Odoo 19 requires Origin header for websocket validation
        location /websocket {
            proxy_pass http://odoo-ws;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header Origin $scheme://$host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
        }

        # Longpolling — proxy to gevent (Odoo 19 still accepts it on gevent port)
        location /longpolling {
            proxy_pass http://odoo-ws;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Origin $scheme://$host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_read_timeout 86400;
        }

        # All other traffic — HTTP workers
        location / {
            proxy_pass http://odoo-http;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 600;
            proxy_connect_timeout 300;
        }
    }
}
