<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Multi-company isolation for embed form submissions. Public submits
            are created via sudo() in embed_api, so this rule scopes backend
            review without blocking intake.
        -->
        <record id="rule_mint_embed_submission_company" model="ir.rule">
            <field name="name">Embed Submission: multi-company</field>
            <field name="model_id" ref="model_mint_embed_submission"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
