<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_mint_zebra_label_form" model="ir.ui.view">
        <field name="name">print.label.form</field>
        <field name="model">print.label</field>
        <field name="arch" type="xml">
            <form string="Zebra Label">
                <header>
                    <button name="action_refresh_preview" type="object"
                            string="Refresh Preview" class="btn-primary" icon="fa-refresh"/>
                    <button name="action_print_to_node" type="object"
                            string="Print to Node" icon="fa-print" class="btn-primary"
                            invisible="not node_id"/>
                    <button name="action_test_print" type="object"
                            string="Test Print (PrintNode)" icon="fa-print"/>
                    <button name="action_load_builtin_into_custom" type="object"
                            string="Edit as Custom ZPL" icon="fa-code"
                            invisible="kind == 'custom'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. IL Flower Exit Label"/></h1>
                    </div>
                    <group>
                        <group string="Label">
                            <field name="kind"/>
                            <field name="width_in"/>
                            <field name="length_in"/>
                            <field name="dpi"/>
                            <field name="darkness"/>
                            <field name="node_id"/>
                            <field name="node_printer_id"
                                   invisible="not node_id"/>
                            <field name="printnode_printer_id"/>
                        </group>
                        <group string="Preview">
                            <field name="preview_error" nolabel="1" readonly="1"
                                   invisible="not preview_error"
                                   class="text-danger"/>
                            <field name="preview_image" widget="image"
                                   nolabel="1" options="{'size': [300, 600]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sample Data" name="sample">
                            <field name="sample_json" widget="ace" options="{'mode': 'json'}"
                                   placeholder="JSON field values"/>
                        </page>
                        <page string="Custom ZPL" name="zpl"
                              invisible="kind != 'custom'">
                            <field name="zpl_template" widget="ace"
                                   placeholder="Raw ZPL with {token} placeholders"/>
                        </page>
                        <page string="Rendered ZPL" name="rendered">
                            <field name="preview_zpl" widget="ace" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mint_zebra_label_list" model="ir.ui.view">
        <field name="name">print.label.list</field>
        <field name="model">print.label</field>
        <field name="arch" type="xml">
            <list string="Zebra Labels">
                <field name="name"/>
                <field name="kind"/>
                <field name="width_in"/>
                <field name="length_in"/>
                <field name="dpi"/>
            </list>
        </field>
    </record>

    <record id="action_mint_zebra_label" model="ir.actions.act_window">
        <field name="name">Zebra Label Designer</field>
        <field name="res_model">print.label</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Design a Zebra (ZD410) label</p>
            <p>Configure size and content, preview it as an image, then test print.</p>
        </field>
    </record>

    <menuitem id="menu_mint_zebra_label"
              name="Label Designer"
              parent="menu_mint_print_root"
              action="action_mint_zebra_label"
              sequence="10"/>

</odoo>
