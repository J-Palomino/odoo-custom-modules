<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Print Node -->
    <record id="view_mint_print_node_form" model="ir.ui.view">
        <field name="name">print.node.form</field>
        <field name="model">print.node</field>
        <field name="arch" type="xml">
            <form string="Print Node">
                <header>
                    <button name="action_rotate_token" type="object"
                            string="Rotate Token" icon="fa-refresh"
                            confirm="Rotate the agent token? The agent must be reconfigured."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Online" bg_color="text-bg-success"
                            invisible="not online"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Tempe Register 1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="hostname" readonly="1"/>
                            <field name="last_seen" readonly="1"/>
                            <field name="online" readonly="1"/>
                        </group>
                        <group>
                            <field name="agent_url"/>
                            <field name="token" password="True"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Printers" name="printers">
                            <field name="printer_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="system_name"/>
                                    <field name="role"/>
                                    <field name="is_default"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mint_print_node_list" model="ir.ui.view">
        <field name="name">print.node.list</field>
        <field name="model">print.node</field>
        <field name="arch" type="xml">
            <list string="Print Nodes">
                <field name="name"/>
                <field name="company_id"/>
                <field name="hostname"/>
                <field name="online" widget="boolean_toggle"/>
                <field name="last_seen"/>
                <field name="job_count" string="Pending"/>
            </list>
        </field>
    </record>

    <record id="action_mint_print_node" model="ir.actions.act_window">
        <field name="name">Print Nodes</field>
        <field name="res_model">print.node</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Print Jobs -->
    <record id="view_mint_print_job_list" model="ir.ui.view">
        <field name="name">print.job.list</field>
        <field name="model">print.job</field>
        <field name="arch" type="xml">
            <list string="Print Jobs" create="false">
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="node_id"/>
                <field name="printer_id"/>
                <field name="role"/>
                <field name="source"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'pending'"/>
                <field name="error" optional="hide"/>
                <button name="action_retry" type="object" string="Retry" icon="fa-refresh"
                        invisible="state not in ('error','cancelled')"/>
                <button name="action_cancel" type="object" string="Cancel" icon="fa-times"
                        invisible="state not in ('pending','printing')"/>
            </list>
        </field>
    </record>

    <record id="action_mint_print_job" model="ir.actions.act_window">
        <field name="name">Print Jobs</field>
        <field name="res_model">print.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Print a Document (PDF -> any node printer via OS driver) -->
    <record id="view_print_document_wizard_form" model="ir.ui.view">
        <field name="name">print.document.wizard.form</field>
        <field name="model">print.document.wizard</field>
        <field name="arch" type="xml">
            <form string="Print a Document">
                <group>
                    <field name="node_id"/>
                    <field name="printer_id"/>
                    <field name="pdf_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="copies"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print"
                            class="btn-primary" icon="fa-print"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_print_document_wizard" model="ir.actions.act_window">
        <field name="name">Print a Document</field>
        <field name="res_model">print.document.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_mint_print_root" name="PrintNodes"
              parent="point_of_sale.menu_point_root" sequence="92"/>
    <menuitem id="menu_print_document" name="Print a Document"
              parent="menu_mint_print_root" action="action_print_document_wizard"
              sequence="15"/>
    <menuitem id="menu_mint_print_node" name="Print Nodes"
              parent="menu_mint_print_root" action="action_mint_print_node" sequence="20"/>
    <menuitem id="menu_mint_print_job" name="Print Jobs"
              parent="menu_mint_print_root" action="action_mint_print_job" sequence="30"/>

</odoo>
