<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Multi-company isolation for customer carts. Carts are stamped with
            the store company; public/portal writes go through sudo() in the
            controllers so this rule does not block FE cart persistence.
        -->
        <record id="rule_mint_cart_company" model="ir.rule">
            <field name="name">Cart: multi-company</field>
            <field name="model_id" ref="model_mint_cart"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
