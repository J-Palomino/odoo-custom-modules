<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Multi-company isolation for flipbooks. Store-specific flipbooks are
            scoped to the active company set; shared ones (company_id = False)
            stay visible to all. FE rendering reads as an all-company API user.
        -->
        <record id="rule_mint_flipbook_company" model="ir.rule">
            <field name="name">Flipbook: multi-company</field>
            <field name="model_id" ref="model_mint_flipbook"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_mint_flipbook_render_company" model="ir.rule">
            <field name="name">Flipbook rendered page: multi-company</field>
            <field name="model_id" ref="model_mint_flipbook_render"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
