<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ==================== Flipbook: Form ==================== -->
    <record id="view_mint_flipbook_form" model="ir.ui.view">
        <field name="name">mint.flipbook.form</field>
        <field name="model">mint.flipbook</field>
        <field name="arch" type="xml">
            <form string="Flipbook">
                <header>
                    <button name="action_generate_pdf" string="Generate PDF" type="object"
                            class="oe_highlight" invisible="page_count == 0"/>
                    <button name="action_publish" string="Publish" type="object"
                            invisible="state == 'published'"/>
                    <button name="action_reset_draft" string="Set to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Flipbook title…"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="page_count"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Internal notes…"/>
                    <group string="Generated PDF" invisible="not pdf_file">
                        <field name="pdf_file" filename="pdf_filename" readonly="1"/>
                        <field name="pdf_filename" invisible="1"/>
                    </group>
                    <group string="Share" invisible="state != 'published'">
                        <field name="public_url" widget="CopyClipboardChar" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Pages" name="pages">
                            <field name="page_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="Page title…"/>
                                    <field name="file" filename="filename"/>
                                    <field name="filename" column_invisible="1"/>
                                    <field name="mimetype"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== Flipbook: List ==================== -->
    <record id="view_mint_flipbook_list" model="ir.ui.view">
        <field name="name">mint.flipbook.list</field>
        <field name="model">mint.flipbook</field>
        <field name="arch" type="xml">
            <list string="Flipbooks">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="page_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-muted="state == 'draft'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ==================== Flipbook: Search ==================== -->
    <record id="view_mint_flipbook_search" model="ir.ui.view">
        <field name="name">mint.flipbook.search</field>
        <field name="model">mint.flipbook</field>
        <field name="arch" type="xml">
            <search string="Flipbooks">
                <field name="name"/>
                <field name="vendor_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_published" string="Published" domain="[('state', '=', 'published')]"/>
                <separator/>
                <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ==================== Action ==================== -->
    <record id="action_mint_flipbook" model="ir.actions.act_window">
        <field name="name">Flipbooks</field>
        <field name="res_model">mint.flipbook</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mint_flipbook_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first flipbook</p>
            <p>Assemble vendor sell-sheets (PDFs or images) into a single shareable flipbook.</p>
        </field>
    </record>

</odoo>
