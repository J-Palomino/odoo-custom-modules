<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Form View -->
    <record id="mint_tv_book_form" model="ir.ui.view">
        <field name="name">mint.tv.book.form</field>
        <field name="model">mint.tv.book</field>
        <field name="arch" type="xml">
            <form string="TV Book">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Product Menu"/></h1>
                    </div>
                    <group>
                        <group string="Settings">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="auto_advance"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Info">
                            <field name="page_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pages" name="pages">
                            <field name="page_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Display URL" name="url">
                            <div class="alert alert-info">
                                <p>Point a TV or tablet browser to:</p>
                                <p><code><field name="nodecg_url" readonly="1"/>/bundles/mintmedia/graphics/book.html?book=<field name="id" readonly="1"/></code></p>
                                <p>Users can swipe, tap edges, or use arrow keys to navigate pages.</p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="mint_tv_book_tree" model="ir.ui.view">
        <field name="name">mint.tv.book.tree</field>
        <field name="model">mint.tv.book</field>
        <field name="arch" type="xml">
            <list string="TV Books">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="page_count"/>
                <field name="auto_advance"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="mint_tv_book_kanban" model="ir.ui.view">
        <field name="name">mint.tv.book.kanban</field>
        <field name="model">mint.tv.book</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <div class="text-muted">
                            <field name="page_count"/> pages
                        </div>
                        <div t-if="record.auto_advance.raw_value" class="text-muted">
                            Auto: <field name="auto_advance"/>s per page
                        </div>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="mint_tv_book_action" model="ir.actions.act_window">
        <field name="name">TV Books</field>
        <field name="res_model">mint.tv.book</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first book viewer
            </p>
            <p>
                Build interactive page-by-page displays for menus,
                catalogs, or info guides. Supports images and PDFs.
            </p>
        </field>
    </record>

</odoo>
