<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Form View -->
    <record id="mint_tv_kiosk_form" model="ir.ui.view">
        <field name="name">mint.tv.kiosk.form</field>
        <field name="model">mint.tv.kiosk</field>
        <field name="arch" type="xml">
            <form string="TV Kiosk">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Deals Kiosk"/></h1>
                    </div>
                    <group>
                        <group string="Display">
                            <field name="url" widget="url"/>
                            <field name="allow_interaction"/>
                            <field name="refresh_interval"/>
                        </group>
                        <group string="Settings">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Display URL" name="url_info">
                            <div class="alert alert-info">
                                <p>Point a TV or kiosk browser to:</p>
                                <p><code><field name="nodecg_url" readonly="1"/>/bundles/mintmedia/graphics/kiosk.html?kiosk=<field name="id" readonly="1"/></code></p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="mint_tv_kiosk_tree" model="ir.ui.view">
        <field name="name">mint.tv.kiosk.tree</field>
        <field name="model">mint.tv.kiosk</field>
        <field name="arch" type="xml">
            <list string="TV Kiosks">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="url"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="allow_interaction"/>
                <field name="refresh_interval"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="mint_tv_kiosk_kanban" model="ir.ui.view">
        <field name="name">mint.tv.kiosk.kanban</field>
        <field name="model">mint.tv.kiosk</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <div class="text-muted">
                            <field name="url" widget="url"/>
                        </div>
                        <div t-if="record.refresh_interval.raw_value" class="text-muted">
                            Refresh: <field name="refresh_interval"/>s
                        </div>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="mint_tv_kiosk_action" model="ir.actions.act_window">
        <field name="name">TV Kiosks</field>
        <field name="res_model">mint.tv.kiosk</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first kiosk display
            </p>
            <p>
                Show any website on a TV. Great for MintDeals storefront,
                dashboards, or any web page.
            </p>
        </field>
    </record>

</odoo>
