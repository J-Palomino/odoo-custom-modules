<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Subscription Tree ============ -->
    <record id="view_push_subscription_tree" model="ir.ui.view">
        <field name="name">mint.push.subscription.tree</field>
        <field name="model">mint.push.subscription</field>
        <field name="arch" type="xml">
            <list string="Push Subscriptions">
                <field name="site_id"/>
                <field name="endpoint" widget="char"/>
                <field name="partner_id"/>
                <field name="created_at"/>
                <field name="fail_count"/>
            </list>
        </field>
    </record>

    <!-- ============ Subscription Form ============ -->
    <record id="view_push_subscription_form" model="ir.ui.view">
        <field name="name">mint.push.subscription.form</field>
        <field name="model">mint.push.subscription</field>
        <field name="arch" type="xml">
            <form string="Push Subscription">
                <sheet>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="endpoint"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="created_at"/>
                            <field name="fail_count"/>
                        </group>
                    </group>
                    <group string="Keys">
                        <field name="key_p256dh"/>
                        <field name="key_auth"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Subscriptions Action ============ -->
    <record id="action_push_subscriptions" model="ir.actions.act_window">
        <field name="name">Push Subscriptions</field>
        <field name="res_model">mint.push.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ Menu ============ -->
    <menuitem id="menu_push_root"
              name="Push Notifications"
              parent="base.menu_administration"
              sequence="90"/>

    <menuitem id="menu_push_subscriptions"
              name="Subscriptions"
              parent="menu_push_root"
              action="action_push_subscriptions"
              sequence="10"/>

    <menuitem id="menu_push_send"
              name="Send Notification"
              parent="menu_push_root"
              action="action_push_send_wizard"
              sequence="20"/>

</odoo>
