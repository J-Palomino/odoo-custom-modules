<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_mint_banner_tree" model="ir.ui.view">
        <field name="name">mint.banner.list</field>
        <field name="model">mint.banner</field>
        <field name="arch" type="xml">
            <list string="Banners">
                <header>
                    <button name="action_clear_frontend_cache" type="object"
                            string="Clear Frontend Cache" icon="fa-refresh"
                            class="btn-secondary"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="publish_status" string="Status" widget="badge"
                       decoration-success="publish_status == 'published'"
                       decoration-warning="publish_status == 'scheduled'"
                       decoration-danger="publish_status == 'expired'"
                       decoration-muted="publish_status == 'draft'"/>
                <field name="name"/>
                <field name="slot"/>
                <field name="size"/>
                <field name="category"/>
                <field name="brand"/>
                <field name="search_term"/>
                <field name="title"/>
                <field name="active" column_invisible="True"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_mint_banner_form" model="ir.ui.view">
        <field name="name">mint.banner.form</field>
        <field name="model">mint.banner</field>
        <field name="arch" type="xml">
            <form string="Banner">
                <header>
                    <button name="action_clear_frontend_cache" type="object"
                            string="Clear Frontend Cache" icon="fa-refresh"
                            class="btn-secondary"/>
                    <field name="publish_status" widget="statusbar"
                           statusbar_visible="draft,scheduled,published"/>
                </header>
                <sheet>
                    <group>
                        <group string="Banner Info">
                            <field name="name"/>
                            <field name="slot"/>
                            <field name="size"/>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Content">
                            <field name="title"/>
                            <field name="subtitle"/>
                            <field name="link_url"/>
                            <field name="link_label"/>
                            <field name="background_color"/>
                            <field name="brand"/>
                            <field name="search_term"/>
                        </group>
                    </group>
                    <!-- WHERE THIS BANNER APPEARS -->
                    <group string="Where This Banner Appears">
                        <div class="alert alert-success" role="alert"
                             invisible="slot != 'hero'">
                            <strong>Hero Carousel</strong> — top of every store page<br/>
                            <em>Pages:</em> /arizona/tempe, /arizona/tempe/products, /arizona/tempe/deals<br/>
                            <em>Component:</em> StoreBanner (full-width carousel with arrows + dots)<br/>
                            <em>Behavior:</em> Multiple hero banners rotate automatically (5s). Supports swipe on mobile.
                        </div>
                        <div class="alert alert-success" role="alert"
                             invisible="slot not in ('after-flower', 'after-pre-rolls', 'after-vapes', 'after-edibles', 'after-concentrates')">
                            <strong>Category Ad Banner</strong> — between product sections on store page<br/>
                            <em>Page:</em> /arizona/tempe (main store page, between category grids)<br/>
                            <em>Component:</em> CategoryAdBanner (rounded card with gradient background)<br/>
                            <em>Behavior:</em> If multiple banners exist for this slot, one is randomly shown per page load. Background image renders at 20-30% opacity behind text.
                        </div>
                        <div class="alert alert-success" role="alert"
                             invisible="slot != 'brand-spotlight'">
                            <strong>Brand Spotlight</strong> — below hero carousel, above product sections<br/>
                            <em>Page:</em> /arizona/tempe (main store page)<br/>
                            <em>Component:</em> CategoryAdBanner (same as category ads)<br/>
                            <em>Behavior:</em> Clicking filters products by brand name or search term.
                        </div>
                        <div class="alert alert-success" role="alert"
                             invisible="slot != 'deals-popup'">
                            <strong>Deals Popup</strong> — floating bottom-right popup on ALL pages<br/>
                            <em>Pages:</em> Site-wide (except /deals pages)<br/>
                            <em>Component:</em> DealsPopup (280px floating card)<br/>
                            <em>Behavior:</em> Appears after 5-second delay. User can dismiss (24-hour cooldown). Only the first active deals-popup banner is shown.
                        </div>
                    </group>
                    <group string="Background Image">
                        <div class="alert alert-info" role="alert"
                             invisible="slot != 'hero'">
                            <strong>Recommended:</strong> 1600 × 400 px (4:1 ratio). Max 2048×1024.<br/>
                            Text overlays left side, product image right side. Max-height 400px desktop, 200px mobile.
                        </div>
                        <div class="alert alert-info" role="alert"
                             invisible="slot not in ('after-flower', 'after-pre-rolls', 'after-vapes', 'after-edibles', 'after-concentrates', 'brand-spotlight')">
                            <strong>Recommended:</strong> 1200 × 300 px. Max 2048×1024.<br/>
                            Displayed at 20-30% opacity behind gradient. Use bold, high-contrast images.
                        </div>
                        <div class="alert alert-info" role="alert"
                             invisible="slot != 'deals-popup'">
                            <strong>Recommended:</strong> 800 × 600 px. Max 2048×1024.<br/>
                            Shown as a 280px-wide floating card image. Keep focal point centered.
                        </div>
                        <field name="image_url" placeholder="https://res.cloudinary.com/... (HTTPS only, allowed domains)"/>
                        <field name="image" widget="image"/>
                    </group>
                    <group string="Product Image (Optional)">
                        <div class="alert alert-warning" role="alert">
                            <strong>Product Cutout:</strong> 384 × 384 px (square, transparent PNG). Max 512×512.<br/>
                            Rendered at 40-176px depending on banner size.<br/>
                            <em>Hero:</em> appears on right side. <em>Category:</em> appears on left side. <em>Deals Popup:</em> not used.
                        </div>
                        <field name="product_image_url" placeholder="https://res.cloudinary.com/... (HTTPS only)"/>
                        <field name="product_image" widget="image"/>
                    </group>
                    <group string="Targeting">
                        <div class="alert alert-info" role="alert">
                            Leave both fields empty to show this banner on <strong>all stores</strong>.
                            Use comma-separated slugs to restrict (e.g. <em>arizona,michigan</em> or <em>tempe,mesa</em>).
                        </div>
                        <field name="regions" placeholder="arizona,michigan,florida (empty = all)"/>
                        <field name="store_slugs" placeholder="tempe,mesa,detroit (empty = all)"/>
                    </group>
                    <group string="Schedule">
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mint_banner" model="ir.actions.act_window">
        <field name="name">Banners</field>
        <field name="res_model">mint.banner</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first banner
            </p>
            <p>
                <strong>Upload photos here → they appear on mintdeals.com store pages.</strong><br/><br/>
                <strong>Hero</strong> — top carousel on store pages (e.g. /arizona/tempe). Multiple banners rotate.<br/>
                <strong>After Flower / Pre-Rolls / Vapes / Edibles / Concentrates</strong> — ad banners between product sections.<br/>
                <strong>Brand Spotlight</strong> — below hero, filters products by brand on click.<br/>
                <strong>Deals Popup</strong> — floating popup on all pages (first active banner wins).<br/><br/>
                Upload a JPG/PNG/WebP image or paste an external HTTPS URL. Use "Clear Frontend Cache" after changes.
            </p>
        </field>
    </record>

    <!-- Canonical top-level menu shared with mint_command_center, mint_embed, mint_visual_cms.
         The action= is required: without it, Odoo's web client walks the menu
         tree depth-first when the top-level is clicked and auto-runs the first
         leaf action it finds (Visual CMS → ir.actions.act_url target='self'),
         which navigates the user out of Odoo entirely. Pointing to the Banners
         list keeps the click inside the Odoo backend. -->
    <menuitem id="menu_mint_banner_root"
              name="Marketing - Command Center"
              web_icon="mint_banner,static/description/icon.png"
              action="action_mint_banner"
              sequence="5"/>

    <!-- CMS sub-panel: groups Visual CMS, Banners, Embeds -->
    <menuitem id="menu_mint_marketing_cms"
              name="CMS"
              parent="menu_mint_banner_root"
              sequence="5"/>

    <menuitem id="menu_mint_banner_config"
              name="Banners"
              parent="menu_mint_marketing_cms"
              action="action_mint_banner"
              sequence="20"/>
</odoo>
