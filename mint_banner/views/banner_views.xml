<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_mint_banner_tree" model="ir.ui.view">
        <field name="name">mint.banner.list</field>
        <field name="model">mint.banner</field>
        <field name="arch" type="xml">
            <list string="Banners">
                <header>
                    <button name="action_clear_frontend_cache" type="object"
                            string="Clear Frontend Cache" icon="fa-refresh"
                            class="btn-secondary"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="publish_status" string="Status" widget="badge"
                       decoration-success="publish_status == 'published'"
                       decoration-warning="publish_status == 'scheduled'"
                       decoration-danger="publish_status == 'expired'"
                       decoration-muted="publish_status == 'draft'"/>
                <field name="name"/>
                <field name="slot"/>
                <field name="size"/>
                <field name="category"/>
                <field name="brand"/>
                <field name="search_term"/>
                <field name="title"/>
                <field name="active" column_invisible="True"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_mint_banner_form" model="ir.ui.view">
        <field name="name">mint.banner.form</field>
        <field name="model">mint.banner</field>
        <field name="arch" type="xml">
            <form string="Banner">
                <header>
                    <button name="action_clear_frontend_cache" type="object"
                            string="Clear Frontend Cache" icon="fa-refresh"
                            class="btn-secondary"/>
                    <field name="publish_status" widget="statusbar"
                           statusbar_visible="draft,scheduled,published"/>
                </header>
                <sheet>
                    <group>
                        <group string="Banner Info">
                            <field name="name"/>
                            <field name="slot"/>
                            <field name="size"/>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Content">
                            <field name="title"/>
                            <field name="subtitle"/>
                            <field name="link_url"/>
                            <field name="link_label"/>
                            <field name="background_color"/>
                            <field name="brand"/>
                            <field name="search_term"/>
                        </group>
                    </group>
                    <group string="Background Image">
                        <div class="alert alert-info" role="alert" invisible="slot not in ('hero',)">
                            <strong>Hero Banner:</strong> 1600 &#215; 400 px (4:1 ratio). Text overlays left side, product image right side. Max-height 400px desktop, 200px mobile.
                        </div>
                        <div class="alert alert-info" role="alert" invisible="slot not in ('after-flower', 'after-pre-rolls', 'after-vapes', 'after-edibles', 'after-concentrates', 'brand-spotlight')">
                            <strong>Category / Spotlight Banner:</strong> 1200 &#215; 300 px. Displayed at 20-30% opacity behind gradient. Use bold, high-contrast images.
                        </div>
                        <div class="alert alert-info" role="alert" invisible="slot not in ('deals-popup',)">
                            <strong>Deals Popup:</strong> 800 &#215; 600 px. Shown as a floating modal on desktop.
                        </div>
                        <field name="image_url" placeholder="https://res.cloudinary.com/..."/>
                        <field name="image" widget="image"/>
                    </group>
                    <group string="Product Image">
                        <div class="alert alert-warning" role="alert">
                            <strong>Product Cutout:</strong> 384 × 384 px (square, transparent PNG). Rendered at 40-176px depending on banner size (Small/Medium/Large).
                        </div>
                        <field name="product_image_url" placeholder="https://res.cloudinary.com/..."/>
                        <field name="product_image" widget="image"/>
                    </group>
                    <group string="Targeting">
                        <group>
                            <field name="x_regions" placeholder="arizona,florida,michigan"
                                   help="Comma-separated region slugs. Leave empty = show on all regions."/>
                            <field name="x_store_slugs" placeholder="tempe,mesa,bonita-springs"
                                   help="Comma-separated store slugs. Leave empty = show on all stores in targeted regions. Overrides region targeting."/>
                        </group>
                    </group>
                    <group string="Schedule">
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mint_banner" model="ir.actions.act_window">
        <field name="name">Banners</field>
        <field name="res_model">mint.banner</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first banner
            </p>
            <p>
                Banners appear on the MintDeals storefront.
                Use "Hero" for the top carousel on store and products pages.
                Use "After Flower/Vapes/Edibles/Concentrates" for banners between product category sections.
            </p>
        </field>
    </record>

    <!-- Menu: place under Mint Marketing if available, fallback to own root -->
    <menuitem id="menu_mint_banner_root"
              name="Mint Marketing"
              web_icon="mint_banner,static/description/icon.png"
              sequence="90"/>

    <menuitem id="menu_mint_banner_config"
              name="Banners"
              parent="menu_mint_banner_root"
              action="action_mint_banner"
              sequence="10"/>
</odoo>
