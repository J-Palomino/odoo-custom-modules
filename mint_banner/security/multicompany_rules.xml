<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Multi-company isolation for banners. Store-specific banners are
            visible only when their company is in the active switcher set;
            shared/global banners (company_id = False) stay visible to all.
            Global rule (no group) so it applies to every user incl. managers.
        -->
        <record id="rule_mint_banner_company" model="ir.rule">
            <field name="name">Banner: multi-company</field>
            <field name="model_id" ref="model_mint_banner"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
