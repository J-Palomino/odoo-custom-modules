<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ MODULE PRIVILEGE (Odoo 19: ir.module.category → res.groups.privilege) ============ -->
    <record id="privilege_daisy_agency" model="res.groups.privilege">
        <field name="name">Daisy Agency</field>
        <field name="sequence">30</field>
    </record>

    <!-- ============ GROUPS (3-tier like Employees) ============ -->
    <record id="group_daisy_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_daisy_agency"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_daisy_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="privilege_daisy_agency"/>
        <field name="implied_ids" eval="[(4, ref('group_daisy_user'))]"/>
    </record>

    <record id="group_daisy_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_daisy_agency"/>
        <field name="implied_ids" eval="[(4, ref('group_daisy_officer'))]"/>
    </record>

    <!-- NOTE: Daisy Agency access is opt-in. Assign users to
         group_daisy_user / officer / admin manually in Settings > Users. -->

    <!-- ============ RECORD RULES ============ -->
    <record id="daisy_agent_rule_admin" model="ir.rule">
        <field name="name">Daisy Agency: Administrator Full Access</field>
        <field name="model_id" ref="model_daisy_agent"/>
        <field name="groups" eval="[(4, ref('group_daisy_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="daisy_agent_rule_officer" model="ir.rule">
        <field name="name">Daisy Agency: Officer Full Access</field>
        <field name="model_id" ref="model_daisy_agent"/>
        <field name="groups" eval="[(4, ref('group_daisy_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="daisy_agent_rule_user" model="ir.rule">
        <field name="name">Daisy Agency: User Read Only</field>
        <field name="model_id" ref="model_daisy_agent"/>
        <field name="groups" eval="[(4, ref('group_daisy_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Personal agent mailboxes are private: an agent's email project (and its
         tasks) is visible only to the agent's manager, the agent's own user, and
         Daisy administrators (break-glass). These are GLOBAL rules (no groups), so
         they are ANDed with every other rule and override the project-administrator
         "see all" rule. -->
    <record id="rule_daisy_agent_project_private" model="ir.rule">
        <field name="name">Daisy agent inbox: private to manager/agent</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">['|', ('daisy_agent_id', '=', False),
            '|', ('daisy_agent_id.manager_id', '=', user.id),
            '|', ('daisy_agent_id.user_id', '=', user.id),
            ('id', '!=', -1) if user.has_group('daisydo_agents.group_daisy_admin') else ('id', '=', 0)]</field>
    </record>

    <record id="rule_daisy_agent_task_private" model="ir.rule">
        <field name="name">Daisy agent inbox tasks: private to manager/agent</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">['|', ('project_id.daisy_agent_id', '=', False),
            '|', ('project_id.daisy_agent_id.manager_id', '=', user.id),
            '|', ('project_id.daisy_agent_id.user_id', '=', user.id),
            ('id', '!=', -1) if user.has_group('daisydo_agents.group_daisy_admin') else ('id', '=', 0)]</field>
    </record>

</odoo>
