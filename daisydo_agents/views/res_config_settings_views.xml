<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_daisy_agents" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.daisy.agents</field>
        <field name="model">res.config.settings</field>
        <field name="priority">90</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="daisydo_agents" data-string="Daisy Agency" string="Daisy Agency"
                     data-key="daisydo_agents" groups="daisydo_agents.group_daisy_admin">
                    <block title="Daisy+ AI" name="daisy_ai_settings">
                        <setting string="API Base URL"
                                 help="Base URL for the Daisy+ prediction API">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="daisy_api_base_url" class="col-3 col-lg-3"/>
                                    <field name="daisy_api_base_url" class="col-6"
                                           placeholder="https://daisy.plus/api/v1"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Global API Key"
                                 help="Shared Daisy+ API key used when creating agents. Set this once so admins don't need to enter it each time.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="daisy_global_api_key" class="col-3 col-lg-3"/>
                                    <field name="daisy_global_api_key" class="col-6"
                                           password="True"
                                           placeholder="Paste Daisy+ API key"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Template Chatflow"
                                 help="The chatflow to clone when creating new employee agents. Set up one template with MCP tool node, then every new agent gets a copy with their own credentials.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="daisy_template_chatflow_id" class="col-3 col-lg-3"/>
                                    <field name="daisy_template_chatflow_id" class="col-6"
                                           placeholder="Chatflow ID from Daisy+"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Go2RTC Media Server" name="go2rtc_settings">
                        <setting string="Internal API URL"
                                 help="Server-side URL for Odoo to reach Go2RTC (Railway internal networking)">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="go2rtc_api_url" class="col-3 col-lg-3"/>
                                    <field name="go2rtc_api_url" class="col-6"
                                           placeholder="http://go2rtc-media.railway.internal:1984"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Public URL"
                                 help="Browser-facing URL for WebSocket and WebRTC connections">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="go2rtc_public_url" class="col-3 col-lg-3"/>
                                    <field name="go2rtc_public_url" class="col-6"
                                           placeholder="https://go2rtc-media-production.up.railway.app"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
