<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add the "AI auto-respond when away" toggle to the user's own
         Preferences dialog (self-editable; gated by SELF_WRITEABLE_FIELDS). -->
    <record id="view_users_form_simple_modif_daisy_autorespond" model="ir.ui.view">
        <field name="name">res.users.preferences.daisy.autorespond</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="daisy_autorespond_when_away"/>
            </field>
        </field>
    </record>
</odoo>
