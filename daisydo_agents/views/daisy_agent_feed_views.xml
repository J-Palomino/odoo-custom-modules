<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ FORM ============ -->
    <record id="daisy_agent_feed_view_form" model="ir.ui.view">
        <field name="name">daisy.agent.feed.form</field>
        <field name="model">daisy.agent.feed</field>
        <field name="arch" type="xml">
            <form string="Camera Feed">
                <header>
                    <button name="action_test_connection" string="Test Connection"
                            type="object" class="btn-secondary"
                            invisible="state not in ('draft', 'ready', 'stopped')"/>
                    <button name="action_activate" string="Go Live"
                            type="object" class="btn-primary"
                            invisible="state not in ('ready', 'stopped')"/>
                    <button name="action_deactivate" string="Stop"
                            type="object" class="btn-warning"
                            invisible="state != 'live'"/>
                    <button name="action_refresh_thumbnail" string="Refresh Thumbnail"
                            type="object" class="btn-secondary"
                            invisible="state != 'live'"/>
                    <button name="action_open_viewer" string="Open Viewer"
                            type="object" class="btn-success"
                            invisible="state != 'live'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ready,live,stopped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Feed Name (e.g. Tempe Front Door)"/></h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="agent_id"/>
                            <field name="company_id"/>
                            <field name="feed_type"/>
                        </group>
                        <group string="Status">
                            <field name="go2rtc_stream_name" readonly="1"/>
                            <field name="go2rtc_status" widget="badge"
                                   decoration-success="go2rtc_status == 'active'"
                                   decoration-danger="go2rtc_status == 'error'"
                                   decoration-muted="go2rtc_status == 'inactive'"/>
                            <field name="go2rtc_error" invisible="not go2rtc_error"/>
                        </group>
                    </group>
                    <group string="RTSP Connection" invisible="feed_type != 'rtsp_in'">
                        <group>
                            <field name="rtsp_url" placeholder="rtsp://192.168.1.100:554/stream1"/>
                        </group>
                        <group>
                            <field name="feed_username"/>
                            <field name="feed_password" password="True"/>
                        </group>
                    </group>
                    <group string="Preview" invisible="not thumbnail">
                        <field name="thumbnail" widget="image" class="oe_avatar"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ LIST ============ -->
    <record id="daisy_agent_feed_view_list" model="ir.ui.view">
        <field name="name">daisy.agent.feed.list</field>
        <field name="model">daisy.agent.feed</field>
        <field name="arch" type="xml">
            <list string="Camera Feeds"
                  decoration-success="state == 'live'"
                  decoration-muted="state == 'stopped'"
                  decoration-warning="go2rtc_status == 'error'">
                <field name="name"/>
                <field name="agent_id"/>
                <field name="company_id" optional="show"/>
                <field name="feed_type"/>
                <field name="go2rtc_stream_name" optional="hide"/>
                <field name="go2rtc_status" widget="badge"
                       decoration-success="go2rtc_status == 'active'"
                       decoration-danger="go2rtc_status == 'error'"
                       decoration-muted="go2rtc_status == 'inactive'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'live'"
                       decoration-info="state == 'ready'"
                       decoration-muted="state in ('draft', 'stopped')"/>
            </list>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="daisy_agent_feed_view_search" model="ir.ui.view">
        <field name="name">daisy.agent.feed.search</field>
        <field name="model">daisy.agent.feed</field>
        <field name="arch" type="xml">
            <search string="Camera Feeds">
                <field name="name"/>
                <field name="agent_id"/>
                <field name="company_id"/>
                <filter string="Live" name="live" domain="[('state', '=', 'live')]"/>
                <filter string="Active in Go2RTC" name="go2rtc_active"
                        domain="[('go2rtc_status', '=', 'active')]"/>
                <filter string="Cameras" name="cameras" domain="[('feed_type', '=', 'rtsp_in')]"/>
                <filter string="Broadcasts" name="broadcasts" domain="[('feed_type', '=', 'rtsp_out')]"/>
                <separator/>
                <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Agent" name="group_agent" context="{'group_by': 'agent_id'}"/>
                <filter string="Store" name="group_store" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <!-- ============ ACTION ============ -->
    <record id="daisy_agent_feed_action" model="ir.actions.act_window">
        <field name="name">Camera Feeds</field>
        <field name="res_model">daisy.agent.feed</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="daisy_agent_feed_view_search"/>
        <field name="context">{'search_default_live': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first camera feed
            </p>
            <p>
                Camera feeds let agents stream RTSP cameras during Discuss calls.
                Configure the RTSP URL and credentials, test the connection,
                then go live.
            </p>
        </field>
    </record>

</odoo>
