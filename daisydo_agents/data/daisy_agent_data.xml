<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily metrics cron -->
    <record id="ir_cron_agent_metrics" model="ir.cron">
        <field name="name">Daisy Agency: Daily Metrics Snapshot</field>
        <field name="model_id" ref="model_daisy_agent_metric"/>
        <field name="state">code</field>
        <field name="code">model._cron_snapshot_metrics()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- Process pending AI response jobs (triggered on-demand via _trigger()) -->
    <record id="ir_cron_process_agent_jobs" model="ir.cron">
        <field name="name">Daisy Agency: Process AI Response Jobs</field>
        <field name="model_id" ref="model_daisy_agent_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_jobs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="priority">1</field>
    </record>

    <!-- Clean up old completed/error jobs weekly -->
    <record id="ir_cron_cleanup_agent_jobs" model="ir.cron">
        <field name="name">Daisy Agency: Cleanup Old Jobs</field>
        <field name="model_id" ref="model_daisy_agent_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_old_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- Fire one-time scheduled jobs whose run_at is due -->
    <record id="ir_cron_run_scheduled_jobs" model="ir.cron">
        <field name="name">Daisy Agency: Run Due Scheduled Jobs</field>
        <field name="model_id" ref="model_daisy_scheduled_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_due_jobs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="priority">1</field>
    </record>

    <!-- Daisy Error Handler configuration.
         noupdate: these xmlids own the LIVE param rows (daisy_error_handler's
         own seed xmlids are dangling on prod), and without it every
         daisydo_agents upgrade resets admin-tuned values — including the
         daisy.error_handler_enabled kill-switch (MR #522). Do NOT delete
         these records: orphan cleanup on upgrade would drop the live rows. -->
    <data noupdate="1">
        <record id="error_handler_api_url_param" model="ir.config_parameter">
            <field name="key">daisy.error_handler_api_url</field>
            <field name="value">https://daisy.plus/api/v1/prediction/af2db2cc-f48c-4ca8-b1a9-36b156ec06cf</field>
        </record>
        <record id="error_handler_enabled_param" model="ir.config_parameter">
            <field name="key">daisy.error_handler_enabled</field>
            <field name="value">true</field>
        </record>
    </data>

    <!-- Go2RTC configuration parameters -->
    <record id="go2rtc_api_url_param" model="ir.config_parameter">
        <field name="key">daisy.go2rtc_api_url</field>
        <field name="value">http://go2rtc-media.railway.internal:1984</field>
    </record>
    <record id="go2rtc_public_url_param" model="ir.config_parameter">
        <field name="key">daisy.go2rtc_public_url</field>
        <field name="value">https://go2rtc-media-production.up.railway.app</field>
    </record>
</odoo>
